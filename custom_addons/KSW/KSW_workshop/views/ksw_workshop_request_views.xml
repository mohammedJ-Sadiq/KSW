<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Form                                                              -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_request_form" model="ir.ui.view">
        <field name="name">ksw.workshop.request.form</field>
        <field name="model">ksw.workshop.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object"
                            string="Start"
                            class="oe_highlight"
                            groups="KSW_workshop.group_workshop_manager"
                            invisible="state != 'new'"/>
                    <button name="action_complete" type="object"
                            string="Complete"
                            class="oe_highlight"
                            groups="KSW_workshop.group_workshop_manager"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            class="btn-danger"
                            groups="KSW_workshop.group_workshop_manager"
                            invisible="state != 'new'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <field name="x_can_toggle_cash_customer" invisible="1"/>
                    <group>
                        <group>
                            <!-- "Requested By" is the whole of what used to be a
                                 Requester section: the department/job/email/mobile
                                 mirrors said nothing the employee record does not
                                 already say, one field is not a section, and this
                                 is the column a requester fills in. -->
                            <field name="employee_id" readonly="1"/>
                            <!-- Cash Customer is the workshop manager's switch, not
                                 an option offered to a requester. Driven by
                                 x_can_toggle_cash_customer rather than groups=,
                                 because a field groups= removes from the arch is
                                 also missing from every invisible= expression that
                                 reads it (Odoo 19 Pitfalls #31) — and half this
                                 column reads it. -->
                            <field name="is_cash_customer"
                                   invisible="not x_can_toggle_cash_customer"
                                   readonly="not x_can_toggle_cash_customer or state != 'new'"/>
                            <!-- Static context dict on the view tag, never a
                                 dynamic one on the field definition (see the
                                 note above vehicle_id in the model).
                                 no_create: a contact created from here would
                                 carry the customer role but no workshop
                                 registration, so it would be saved on this
                                 request and then vanish from every picker.
                                 Clients are added in one place —
                                 Configuration -> Clients. -->
                            <field name="client_id"
                                   context="{'res_partner_search_mode': 'customer'}"
                                   options="{'no_create': True}"
                                   invisible="is_cash_customer"
                                   required="not is_cash_customer"
                                   readonly="state != 'new'"/>
                            <field name="vehicle_type"
                                   invisible="is_cash_customer"
                                   required="not is_cash_customer"
                                   readonly="state != 'new'"/>
                            <field name="vehicle_id"
                                   context="{'default_client_id': client_id, 'default_vehicle_type': vehicle_type}"
                                   invisible="is_cash_customer"
                                   required="not is_cash_customer"
                                   readonly="state != 'new'"/>
                            <field name="driver_id"
                                   invisible="is_cash_customer"
                                   required="not is_cash_customer"
                                   readonly="state != 'new'"/>
                        </group>
                        <!-- Walk-in work: every field optional on purpose. What
                             the counter gets told varies, and the description
                             (required for every request) is the part that is
                             always there. -->
                        <group string="Cash Customer" invisible="not is_cash_customer">
                            <field name="x_cash_customer_name" readonly="state != 'new'"/>
                            <field name="x_cash_vehicle_number" readonly="state != 'new'"/>
                            <field name="x_cash_tank_number" readonly="state != 'new'"/>
                            <field name="x_cash_plate_number" readonly="state != 'new'"/>
                            <field name="x_cash_driver_name" readonly="state != 'new'"/>
                            <field name="x_cash_brand" readonly="state != 'new'"/>
                            <field name="x_cash_model" readonly="state != 'new'"/>
                            <field name="x_cash_year" readonly="state != 'new'"/>
                        </group>
                    </group>
                    <group string="Request">
                        <!-- The requester's only question. The type is not asked
                             of him at all: it is derived from these words (see
                             _apply_derived_types) and shown below to the workshop,
                             who can correct it. Asking a driver to classify his
                             own fault is asking the wrong person. -->
                        <field name="description" readonly="state != 'new'"
                               placeholder="Describe the problem: what is wrong, since when, and any warning light or noise."/>
                        <field name="request_type_ids" widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create': True}"
                               groups="KSW_workshop.group_workshop_technician,KSW_workshop.group_workshop_manager"/>
                        <div class="text-muted" colspan="2"
                             invisible="not x_request_type_derived"
                             groups="KSW_workshop.group_workshop_technician,KSW_workshop.group_workshop_manager">
                            Tagged from the description. Edit the tags to correct them —
                            they will then be left alone.
                        </div>
                        <field name="x_request_type_derived" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Repair Report"
                              groups="KSW_workshop.group_workshop_technician,KSW_workshop.group_workshop_manager">
                            <group>
                                <group>
                                    <field name="entry_datetime" readonly="state != 'in_progress'"/>
                                    <field name="exit_datetime" readonly="state != 'in_progress'"/>
                                    <field name="odometer_reading" readonly="state != 'in_progress'"/>
                                </group>
                                <group>
                                    <field name="tire_pressure" readonly="state != 'in_progress'"/>
                                    <field name="tire_bolts" readonly="state != 'in_progress'"/>
                                    <field name="part_lines_cost" readonly="1"/>
                                    <field name="labor_cost" readonly="state != 'in_progress'"/>
                                    <!-- Off the form for new work, but still shown
                                         (read-only) on the 878 imported rows that
                                         carry a figure, so no history is hidden by
                                         the field going away. -->
                                    <field name="parts_cost" readonly="1"
                                           invisible="not parts_cost"/>
                                    <field name="total_cost" readonly="1"/>
                                </group>
                            </group>
                            <!-- Pass-through parts: listing an item here IS
                                 issuing it. No stock balance is kept, by
                                 design. -->
                            <group string="Spare Parts Used">
                                <field name="part_line_ids" nolabel="1" colspan="2"
                                       readonly="state != 'in_progress'">
                                    <list editable="bottom">
                                        <field name="part_id"/>
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="unit_cost"/>
                                        <field name="subtotal" sum="Total"/>
                                        <field name="issue_date" optional="hide"/>
                                    </list>
                                </field>
                            </group>
                            <!-- The labor half of the same idea: what was done and
                                 who did it, one line each. No amount per line —
                                 the fee is the single figure above. The Technician
                                 picker offers the employees flagged Workshop
                                 Technician plus External Service Location. -->
                            <group string="Labor / Service Performed">
                                <field name="labor_line_ids" nolabel="1" colspan="2"
                                       readonly="state != 'in_progress'">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="line_no" string="#"/>
                                        <field name="description"/>
                                        <field name="technician_id" options="{'no_create': True}"/>
                                    </list>
                                </field>
                            </group>
                            <!-- Legacy only. The Work section (Statement of
                                 Required Work / Repairs and Spare Parts) and the
                                 request-level Technician left the form as
                                 redundant, but 5,639 imported rows carry that
                                 text and 4,320 carry a technician name, so they
                                 stay readable where they exist. -->
                            <group string="Recorded on the Legacy Sheet"
                                   invisible="not work_statement and not repairs_parts and not x_legacy_technician_name">
                                <field name="x_legacy_technician_name" readonly="1"
                                       invisible="not x_legacy_technician_name"/>
                                <field name="work_statement" readonly="1"
                                       invisible="not work_statement"/>
                                <field name="repairs_parts" readonly="1"
                                       invisible="not repairs_parts"/>
                            </group>
                        </page>
                        <!-- The workshop's equivalent of the Time Off form's
                             "<employee>'s summary (2026)" panel. Technician and
                             manager only: a plain requester's record rule is
                             own-records-only, so the same panel would show them
                             a partial history that looks complete. The compute
                             is sudo'd, which is why none of these fields needs
                             a model-level groups= (that would strip them from
                             fields_get and break the invisible= below). -->
                        <page string="History (This Year)"
                              groups="KSW_workshop.group_workshop_technician,KSW_workshop.group_workshop_manager">
                            <group>
                                <group string="This Vehicle">
                                    <field name="x_vehicle_history_count" readonly="1"/>
                                    <field name="x_vehicle_history_cost" readonly="1"/>
                                </group>
                                <group string="This Driver">
                                    <field name="x_driver_history_count" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Past jobs on this vehicle"/>
                            <div class="text-muted"
                                 invisible="vehicle_id or is_cash_customer">
                                Pick a vehicle to see what it already had done this year.
                            </div>
                            <field name="x_vehicle_history_ids" nolabel="1" readonly="1"
                                   invisible="not x_vehicle_history_ids">
                                <list>
                                    <field name="create_date" string="Date"/>
                                    <field name="name"/>
                                    <field name="request_type_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                    <field name="description"/>
                                    <field name="technician_label"/>
                                    <field name="total_cost" sum="Total"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                            <separator string="Past jobs for this driver, under this client"/>
                            <field name="x_driver_history_ids" nolabel="1" readonly="1"
                                   invisible="not x_driver_history_ids">
                                <list>
                                    <field name="create_date" string="Date"/>
                                    <field name="name"/>
                                    <field name="vehicle_id"/>
                                    <field name="request_type_ids" widget="many2many_tags"
                                           options="{'color_field': 'color'}"/>
                                    <field name="description"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal" groups="KSW_workshop.group_workshop_manager">
                            <group>
                                <field name="note"/>
                                <field name="note_to_requester"/>
                                <field name="rejection_reason" invisible="state not in ('new', 'rejected')"/>
                                <field name="completion_date" readonly="1"/>
                                <field name="duration_days" readonly="1"/>
                            </group>
                            <group string="Legacy Import" invisible="not x_imported">
                                <field name="x_legacy_uid" readonly="1"/>
                                <field name="x_legacy_requester_name" readonly="1"/>
                                <field name="x_legacy_requester_email" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- List                                                              -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_request_list" model="ir.ui.view">
        <field name="name">ksw.workshop.request.list</field>
        <field name="model">ksw.workshop.request</field>
        <field name="arch" type="xml">
            <list string="Workshop Requests" decoration-danger="state == 'rejected'" decoration-success="state == 'completed'" decoration-info="state == 'in_progress'">
                <field name="name"/>
                <field name="create_date" string="Date"/>
                <field name="employee_id"/>
                <field name="client_id"/>
                <field name="vehicle_id"/>
                <field name="request_type_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
                <field name="description"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Kanban                                                            -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_request_kanban" model="ir.ui.view">
        <field name="name">ksw.workshop.request.kanban</field>
        <field name="model">ksw.workshop.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="client_id"/>
                <field name="vehicle_id"/>
                <field name="is_cash_customer"/>
                <field name="x_cash_customer_name"/>
                <field name="x_cash_vehicle_number"/>
                <field name="description"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div t-if="!record.is_cash_customer.raw_value"><field name="vehicle_id"/></div>
                            <div t-if="record.is_cash_customer.raw_value">
                                <field name="x_cash_customer_name"/> — <field name="x_cash_vehicle_number"/>
                            </div>
                            <div class="text-muted"><field name="description"/></div>
                            <div class="text-muted"><field name="employee_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Search                                                            -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_request_search" model="ir.ui.view">
        <field name="name">ksw.workshop.request.search</field>
        <field name="model">ksw.workshop.request</field>
        <field name="arch" type="xml">
            <search string="Workshop Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="client_id"/>
                <field name="vehicle_id"/>
                <field name="description"/>
                <filter string="New" name="filter_new" domain="[('state', '=', 'new')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="My Requests" name="filter_mine" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="Cash Customer" name="filter_cash_customer" domain="[('is_cash_customer', '=', True)]"/>
                <separator/>
                <!-- Period filters. A <separator/> above is required or these
                     would be OR:ed with the status filters instead of AND:ed. -->
                <filter string="This Month" name="filter_this_month"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="This Quarter" name="filter_this_quarter"
                        domain="[('create_date', '&gt;=', (context_today() - relativedelta(months=(context_today().month - 1) % 3)).strftime('%Y-%m-01'))]"/>
                <filter string="This Year" name="filter_this_year"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <filter string="Last 12 Months" name="filter_last_12_months"
                        domain="[('create_date', '&gt;=', (context_today() - relativedelta(months=12)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <field name="request_type_ids"/>
                <filter string="Unclassified Type" name="filter_no_request_type"
                        domain="[('request_type_ids', '=', False)]"/>
                <group>
                    <filter string="Vehicle" name="groupby_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Request Type" name="groupby_request_type" context="{'group_by': 'request_type_ids'}"/>
                    <filter string="Technician" name="groupby_technician" context="{'group_by': 'technician_label'}"/>
                    <filter string="Vehicle Type" name="groupby_vehicle_type" context="{'group_by': 'vehicle_type'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Client" name="groupby_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Requested By" name="groupby_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="groupby_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Driver" name="groupby_driver" context="{'group_by': 'driver_id'}"/>
                    <separator/>
                    <filter string="Month" name="groupby_month" domain="[]"
                            context="{'group_by': 'create_date:month'}"/>
                    <filter string="Quarter" name="groupby_quarter" domain="[]"
                            context="{'group_by': 'create_date:quarter'}"/>
                    <filter string="Year" name="groupby_year" domain="[]"
                            context="{'group_by': 'create_date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Graph / Pivot                                                     -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_request_pivot" model="ir.ui.view">
        <field name="name">ksw.workshop.request.pivot</field>
        <field name="model">ksw.workshop.request</field>
        <field name="arch" type="xml">
            <pivot string="Workshop Analysis" sample="1">
                <field name="vehicle_id" type="row"/>
                <field name="create_date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_ksw_workshop_request_graph" model="ir.ui.view">
        <field name="name">ksw.workshop.request.graph</field>
        <field name="model">ksw.workshop.request</field>
        <field name="arch" type="xml">
            <graph string="Workshop Analysis" type="bar" stacked="1" sample="1">
                <field name="create_date" interval="month"/>
                <field name="request_type_ids"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Actions                                                           -->
    <!-- ================================================================ -->
    <record id="action_ksw_workshop_request_my" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">ksw.workshop.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ksw_workshop_request_search"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Submit a new workshop service request
            </p>
        </field>
    </record>

    <record id="action_ksw_workshop_request_all" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">ksw.workshop.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_ksw_workshop_request_search"/>
        <field name="context">{'search_default_filter_new': 1, 'search_default_filter_in_progress': 1}</field>
    </record>

    <!-- Reporting. Deliberately NOT reusing action_ksw_workshop_request_all's
         context: it pre-filters to New + In Progress, which would hide every
         completed job — i.e. nearly all the history — from a report. -->
    <record id="action_ksw_workshop_report" model="ir.actions.act_window">
        <field name="name">Workshop Analysis</field>
        <field name="res_model">ksw.workshop.request</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="view_ksw_workshop_request_search"/>
        <field name="context">{}</field>
    </record>

    <record id="action_ksw_workshop_report_by_vehicle" model="ir.actions.act_window">
        <field name="name">By Vehicle</field>
        <field name="res_model">ksw.workshop.request</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="view_ksw_workshop_request_search"/>
        <field name="context">{'search_default_groupby_vehicle': 1, 'search_default_groupby_month': 1}</field>
    </record>

    <record id="action_ksw_workshop_report_by_type" model="ir.actions.act_window">
        <field name="name">By Repair Type</field>
        <field name="res_model">ksw.workshop.request</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="view_ksw_workshop_request_search"/>
        <field name="context">{'search_default_groupby_request_type': 1, 'search_default_groupby_year': 1}</field>
    </record>

    <record id="action_ksw_workshop_report_by_technician" model="ir.actions.act_window">
        <field name="name">By Technician</field>
        <field name="res_model">ksw.workshop.request</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="view_ksw_workshop_request_search"/>
        <field name="context">{'search_default_groupby_technician': 1, 'search_default_groupby_request_type': 1}</field>
    </record>

    <!-- ================================================================ -->
    <!-- Menus                                                             -->
    <!-- ================================================================ -->
    <menuitem id="menu_ksw_workshop_root" name="Workshop" sequence="60"
              web_icon="KSW_workshop,static/description/icon.png"/>
    <menuitem id="menu_ksw_workshop_my" name="My Requests"
              parent="menu_ksw_workshop_root" action="action_ksw_workshop_request_my" sequence="10"/>
    <menuitem id="menu_ksw_workshop_all" name="All Requests"
              parent="menu_ksw_workshop_root" action="action_ksw_workshop_request_all" sequence="20"
              groups="KSW_workshop.group_workshop_technician,KSW_workshop.group_workshop_manager"/>
    <!-- Manager-only, on purpose. The technician record rule is
         ['|', ('state','=','in_progress'), ('technician_id.user_id','=',user.id)]
         so a technician cannot see completed requests unless they were the
         assigned technician — their pivot would be a silently partial
         aggregate that looks complete. Managers have [(1,'=',1)]. -->
    <menuitem id="menu_ksw_workshop_reporting" name="Reporting"
              parent="menu_ksw_workshop_root" sequence="30"
              groups="KSW_workshop.group_workshop_manager"/>
    <menuitem id="menu_ksw_workshop_report_analysis" name="Workshop Analysis"
              parent="menu_ksw_workshop_reporting" action="action_ksw_workshop_report" sequence="10"
              groups="KSW_workshop.group_workshop_manager"/>
    <menuitem id="menu_ksw_workshop_report_by_vehicle" name="By Vehicle"
              parent="menu_ksw_workshop_reporting" action="action_ksw_workshop_report_by_vehicle" sequence="20"
              groups="KSW_workshop.group_workshop_manager"/>
    <menuitem id="menu_ksw_workshop_report_by_type" name="By Repair Type"
              parent="menu_ksw_workshop_reporting" action="action_ksw_workshop_report_by_type" sequence="30"
              groups="KSW_workshop.group_workshop_manager"/>
    <menuitem id="menu_ksw_workshop_report_by_technician" name="By Technician"
              parent="menu_ksw_workshop_reporting" action="action_ksw_workshop_report_by_technician" sequence="40"
              groups="KSW_workshop.group_workshop_manager"/>

    <menuitem id="menu_ksw_workshop_configuration" name="Configuration"
              parent="menu_ksw_workshop_root" sequence="90"
              groups="KSW_workshop.group_workshop_manager"/>

</odoo>
