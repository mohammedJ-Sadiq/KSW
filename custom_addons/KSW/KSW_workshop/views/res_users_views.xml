<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Where the Requester Assistant role gets its meaning. The role alone
         is inert unless the user's manager is a requester, so the tab says
         who he raises requests for right now, or that it is nobody. -->
    <record id="view_users_form_ksw_workshop_assistant" model="ir.ui.view">
        <field name="name">res.users.form.ksw.workshop.assistant</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Next to the role it configures: an administrator choosing
                 Requester Assistant sees whose trucks it means right there. -->
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group groups="base.group_erp_manager" invisible="not x_workshop_is_assistant">
                    <field name="x_workshop_is_assistant" invisible="1"/>
                    <field name="x_workshop_requester_for_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="His own manager by default..."/>
                    <div colspan="2" class="text-muted">
                        The workshop requesters this user raises requests for, on their vehicles
                        only. It starts as his own manager; remove him or add others for the
                        workshop only. Only those who are Workshop Requesters count.
                    </div>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="ksw_workshop_assistant" string="Workshop" groups="base.group_erp_manager">
                    <div class="alert alert-success" role="status"
                         invisible="not x_workshop_assists_display">
                        Raises workshop requests for
                        <b><field name="x_workshop_assists_display" readonly="1" nolabel="1" class="d-inline"/></b>,
                        on their vehicles only.
                    </div>
                    <group>
                        <field name="x_workshop_notify_in_odoo"/>
                    </group>
                    <div class="text-muted">
                        Whose vehicles a <b>Requester Assistant</b> follows is set in the
                        Access Rights tab, under Raises Workshop Requests For.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- The same switch in the user's own Preferences, next to Odoo's
         Notification setting it narrows. Workshop roles only. -->
    <record id="view_users_form_simple_modif_ksw_workshop_notify" model="ir.ui.view">
        <field name="name">res.users.preferences.form.ksw.workshop.notify</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="mail.view_users_form_simple_modif_mail"/>
        <field name="arch" type="xml">
            <field name="notification_type" position="after">
                <field name="x_workshop_notify_in_odoo" readonly="0"
                       groups="KSW_workshop.group_workshop_manager,KSW_workshop.group_workshop_reviewer,KSW_workshop.group_workshop_technician,KSW_workshop.group_workshop_requester,KSW_workshop.group_workshop_requester_assistant"/>
            </field>
        </field>
    </record>
</odoo>
