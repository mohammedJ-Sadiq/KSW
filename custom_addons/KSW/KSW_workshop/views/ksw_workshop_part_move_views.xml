<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- List (editable — this is the entry screen for stock income too)  -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_part_move_list" model="ir.ui.view">
        <field name="name">ksw.workshop.part.move.list</field>
        <field name="model">ksw.workshop.part.move</field>
        <field name="arch" type="xml">
            <list string="Stock Movements" editable="bottom"
                  decoration-success="move_type == 'in'"
                  decoration-warning="move_type == 'out'"
                  decoration-info="move_type == 'return'">
                <field name="date"/>
                <field name="name" readonly="1"/>
                <field name="part_id" domain="['|', ('state', '=', 'confirmed'), ('id', '=', part_id)]"/>
                <field name="move_type"/>
                <field name="quantity"/>
                <field name="unit_cost"/>
                <field name="amount" sum="Total" readonly="1"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <field name="request_id" readonly="1"/>
                <field name="user_id" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Form                                                              -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_part_move_form" model="ir.ui.view">
        <field name="name">ksw.workshop.part.move.form</field>
        <field name="model">ksw.workshop.part.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="part_id" domain="['|', ('state', '=', 'confirmed'), ('id', '=', part_id)]"/>
                            <field name="move_type"/>
                            <field name="quantity"/>
                            <field name="unit_cost"/>
                            <field name="amount" readonly="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="reference"/>
                            <field name="request_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Note"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Pivot / Graph (movement report)                                   -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_part_move_pivot" model="ir.ui.view">
        <field name="name">ksw.workshop.part.move.pivot</field>
        <field name="model">ksw.workshop.part.move</field>
        <field name="arch" type="xml">
            <pivot string="Movement Report">
                <field name="part_id" type="row"/>
                <field name="move_type" type="col"/>
                <field name="quantity" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ksw_workshop_part_move_graph" model="ir.ui.view">
        <field name="name">ksw.workshop.part.move.graph</field>
        <field name="model">ksw.workshop.part.move</field>
        <field name="arch" type="xml">
            <graph string="Movement Report" type="bar">
                <field name="date" interval="month"/>
                <field name="move_type"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Search                                                            -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_part_move_search" model="ir.ui.view">
        <field name="name">ksw.workshop.part.move.search</field>
        <field name="model">ksw.workshop.part.move</field>
        <field name="arch" type="xml">
            <search string="Stock Movements">
                <field name="name"/>
                <field name="part_id"/>
                <field name="reference"/>
                <field name="date"/>
                <filter string="Income" name="filter_in" domain="[('move_type', '=', 'in')]"/>
                <filter string="Consumption" name="filter_out" domain="[('move_type', '=', 'out')]"/>
                <filter string="Return" name="filter_return" domain="[('move_type', '=', 'return')]"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <group>
                    <filter string="Part" name="groupby_part" context="{'group_by': 'part_id'}"/>
                    <filter string="Type" name="groupby_type" context="{'group_by': 'move_type'}"/>
                    <filter string="Date" name="groupby_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Actions                                                           -->
    <!-- ================================================================ -->
    <record id="action_ksw_workshop_part_move_income" model="ir.actions.act_window">
        <field name="name">Stock Income</field>
        <field name="res_model">ksw.workshop.part.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in')]</field>
        <field name="context">{'default_move_type': 'in'}</field>
        <field name="search_view_id" ref="view_ksw_workshop_part_move_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record spare parts received into the workshop
            </p>
        </field>
    </record>

    <record id="action_ksw_workshop_part_move_all" model="ir.actions.act_window">
        <field name="name">Stock Movements</field>
        <field name="res_model">ksw.workshop.part.move</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="view_ksw_workshop_part_move_search"/>
    </record>

    <!-- ================================================================ -->
    <!-- Menus                                                             -->
    <!-- ================================================================ -->
    <menuitem id="menu_ksw_workshop_inventory" name="Parts Inventory"
              parent="menu_ksw_workshop_root" sequence="30"
              groups="KSW_workshop.group_workshop_technician,KSW_workshop.group_workshop_manager"/>
    <menuitem id="menu_ksw_workshop_stock_income" name="Stock Income"
              parent="menu_ksw_workshop_inventory"
              action="action_ksw_workshop_part_move_income" sequence="10"
              groups="KSW_workshop.group_workshop_manager"/>
    <menuitem id="menu_ksw_workshop_current_stock" name="Current Stock"
              parent="menu_ksw_workshop_inventory"
              action="action_ksw_workshop_part_stock_report" sequence="20"/>
    <menuitem id="menu_ksw_workshop_stock_moves" name="Movement Report"
              parent="menu_ksw_workshop_inventory"
              action="action_ksw_workshop_part_move_all" sequence="30"/>

</odoo>
