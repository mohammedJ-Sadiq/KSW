<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ksw_workshop_technician_list" model="ir.ui.view">
        <field name="name">ksw.workshop.technician.list</field>
        <field name="model">ksw.workshop.technician</field>
        <field name="arch" type="xml">
            <list string="Workshop Technicians" editable="bottom">
                <field name="name" required="1"/>
                <field name="employee_id"/>
                <field name="note" optional="show"/>
                <!-- Read-only marker on the one built-in entry; shown so it is
                     obvious why "External Service Location" has no employee. -->
                <field name="is_external" string="External" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ksw_workshop_technician_form" model="ir.ui.view">
        <field name="name">ksw.workshop.technician.form</field>
        <field name="model">ksw.workshop.technician</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="employee_id" invisible="is_external"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="is_external"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ksw_workshop_technician_search" model="ir.ui.view">
        <field name="name">ksw.workshop.technician.search</field>
        <field name="model">ksw.workshop.technician</field>
        <field name="arch" type="xml">
            <search string="Workshop Technicians">
                <field name="name"/>
                <field name="employee_id"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ksw_workshop_technician" model="ir.actions.act_window">
        <field name="name">Technicians</field>
        <field name="res_model">ksw.workshop.technician</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ksw_workshop_technician_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a workshop technician
            </p>
            <p>
                Whoever is listed here can be named on a repair's Labor / Service lines.
                Ticking "Workshop Technician" on an employee form adds them here, and the
                built-in "External Service Location" entry covers work sent outside.
            </p>
        </field>
    </record>

    <menuitem id="menu_ksw_workshop_technicians" name="Technicians"
              parent="menu_ksw_workshop_configuration"
              action="action_ksw_workshop_technician" sequence="30"/>

</odoo>
