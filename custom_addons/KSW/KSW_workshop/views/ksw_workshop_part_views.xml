<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Form                                                              -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_part_form" model="ir.ui.view">
        <field name="name">ksw.workshop.part.form</field>
        <field name="model">ksw.workshop.part</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm"
                            class="oe_highlight"
                            groups="KSW_workshop.group_workshop_manager"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Part name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="category"/>
                            <field name="uom_name"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Stock &amp; Cost">
                            <field name="qty_on_hand" readonly="1"/>
                            <field name="is_low_stock" readonly="1"/>
                            <field name="min_qty"/>
                            <field name="standard_cost"/>
                            <field name="inventory_value" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Stock Movements">
                            <field name="move_ids" create="0" delete="0">
                                <list create="0" delete="0" edit="0"
                                      decoration-success="move_type == 'in'" decoration-warning="move_type == 'out'">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="move_type"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="reference"/>
                                    <field name="request_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- List                                                              -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_part_list" model="ir.ui.view">
        <field name="name">ksw.workshop.part.list</field>
        <field name="model">ksw.workshop.part</field>
        <field name="arch" type="xml">
            <list string="Spare Parts" decoration-muted="state == 'draft'" decoration-danger="is_low_stock">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="uom_name"/>
                <field name="qty_on_hand" sum="Total On Hand"/>
                <field name="min_qty"/>
                <field name="standard_cost"/>
                <field name="inventory_value" sum="Total Value"/>
                <field name="is_low_stock" column_invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Pivot / Graph (current stock report)                             -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_part_pivot" model="ir.ui.view">
        <field name="name">ksw.workshop.part.pivot</field>
        <field name="model">ksw.workshop.part</field>
        <field name="arch" type="xml">
            <pivot string="Current Stock">
                <field name="category" type="row"/>
                <field name="qty_on_hand" type="measure"/>
                <field name="inventory_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ksw_workshop_part_graph" model="ir.ui.view">
        <field name="name">ksw.workshop.part.graph</field>
        <field name="model">ksw.workshop.part</field>
        <field name="arch" type="xml">
            <graph string="Current Stock" type="bar">
                <field name="category"/>
                <field name="inventory_value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Search                                                            -->
    <!-- ================================================================ -->
    <record id="view_ksw_workshop_part_search" model="ir.ui.view">
        <field name="name">ksw.workshop.part.search</field>
        <field name="model">ksw.workshop.part</field>
        <field name="arch" type="xml">
            <search string="Spare Parts">
                <field name="name"/>
                <field name="code"/>
                <filter string="Low Stock" name="filter_low_stock" domain="[('is_low_stock', '=', True)]"/>
                <filter string="Out of Stock" name="filter_out_of_stock" domain="[('qty_on_hand', '&lt;=', 0)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="groupby_category" context="{'group_by': 'category'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Action                                                            -->
    <!-- ================================================================ -->
    <record id="action_ksw_workshop_part" model="ir.actions.act_window">
        <field name="name">Spare Parts</field>
        <field name="res_model">ksw.workshop.part</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_ksw_workshop_part_search"/>
        <field name="context">{'search_default_filter_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a spare part to the workshop catalog
            </p>
        </field>
    </record>

    <!-- Read-only current-stock report: same model/search, no create/edit,
         reachable by technicians too (not tucked under Configuration). -->
    <record id="action_ksw_workshop_part_stock_report" model="ir.actions.act_window">
        <field name="name">Current Stock</field>
        <field name="res_model">ksw.workshop.part</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_ksw_workshop_part_search"/>
        <field name="context">{'search_default_filter_confirmed': 1, 'create': False}</field>
    </record>

    <!-- ================================================================ -->
    <!-- Menu                                                              -->
    <!-- ================================================================ -->
    <menuitem id="menu_ksw_workshop_parts_catalog" name="Spare Parts"
              parent="menu_ksw_workshop_configuration"
              action="action_ksw_workshop_part" sequence="20"/>

</odoo>
