<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Layer 1: Module Category                                      -->
    <!-- ============================================================ -->
    <record id="module_category_ksw_workshop" model="ir.module.category">
        <field name="name">KSW Workshop</field>
        <field name="sequence">210</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 2: Privilege                                             -->
    <!-- ============================================================ -->
    <!--
        Technician, Reviewer < Manager. A Manager also gets everything
        a Technician can do (implied_ids), since managing the queue
        naturally includes being able to fill in a repair report too.
        Every internal employee can still see their own requests via
        base.group_user (raising one needs group_workshop_requester, below) — this privilege only governs who can triage
        the queue and/or edit the repair report on ANY request.
    -->
    <record id="privilege_workshop_management" model="res.groups.privilege">
        <field name="name">Workshop Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_workshop"/>
    </record>

    <record id="group_workshop_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="privilege_id" ref="privilege_workshop_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">10</field>
    </record>

    <!--
        Reviewer (Oct 2026): sees every request and the work done on it
        (repair report, parts, labour, history, internal notes) and changes
        nothing. Read-only is enforced three ways: the record rules below
        grant read only, every write path in ksw_workshop_request.py already
        names the manager or technician group, and _get_view strips edit and
        create from the views so the form never offers a save that fails.
        Not a technician: reviewing the work is not doing it. The Manager
        implies it, so every view element gated to Reviewer shows to him too.
    -->
    <record id="group_workshop_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="privilege_id" ref="privilege_workshop_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">15</field>
    </record>

    <record id="group_workshop_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_workshop_management"/>
        <!--
            hr.group_hr_user is implied too: KSW_fleet (a lower-level module
            KSW_workshop depends on, never the reverse) gates its own
            draft-vehicle "action_confirm" on hr.group_hr_user, since it
            can't reference this module's group. Every Workshop Manager
            needs that right, so it's granted here rather than inverting
            the dependency graph.
        -->
        <field name="implied_ids" eval="[(4, ref('group_workshop_technician')), (4, ref('group_workshop_reviewer')), (4, ref('hr.group_hr_user'))]"/>
        <field name="sequence">20</field>
    </record>

    <!--
        Who may RAISE a request (Oct 2026). Before this every employee could;
        now only the people who answer for vehicles do: the Isuzu and trailer
        supervisors and the maintenance department manager. Which vehicles
        each of them may pick is not decided here: that is data (tanker
        groups, the reporting line), applied by KSW_workshop_tanker. Its own
        privilege, not a rung of the ladder above: a technician fixes trucks,
        he does not book them in. Everyone keeps reading his own old requests
        through base.group_user.
    -->
    <record id="privilege_workshop_requests" model="res.groups.privilege">
        <field name="name">Workshop Requests</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="module_category_ksw_workshop"/>
    </record>

    <record id="group_workshop_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="privilege_id" ref="privilege_workshop_requests"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">10</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Record Rules                                         -->
    <!-- ============================================================ -->
    <record id="rule_ksw_workshop_request_own" model="ir.rule">
        <field name="name">Workshop Request: own records only</field>
        <field name="model_id" ref="model_ksw_workshop_request"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ksw_workshop_request_technician" model="ir.rule">
        <field name="name">Workshop Request: technician sees in-progress + own assignments</field>
        <field name="model_id" ref="model_ksw_workshop_request"/>
        <field name="domain_force">['|', ('state', '=', 'in_progress'),
                                    '|', ('technician_id.user_id', '=', user.id),
                                         ('labor_line_ids.technician_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_technician'))]"/>
    </record>

    <record id="rule_ksw_workshop_request_manager" model="ir.rule">
        <field name="name">Workshop Request: manager sees all</field>
        <field name="model_id" ref="model_ksw_workshop_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_manager'))]"/>
    </record>

    <record id="rule_ksw_workshop_request_reviewer" model="ir.rule">
        <field name="name">Workshop Request: reviewer reads all</field>
        <field name="model_id" ref="model_ksw_workshop_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_reviewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Spare-part issue lines mirror the three request rules exactly, one
        level down. A line is part of its request: whoever can see the
        request can see what was fitted to it, and nobody else.
    -->
    <record id="rule_ksw_workshop_part_line_own" model="ir.rule">
        <field name="name">Workshop Part Line: own requests only</field>
        <field name="model_id" ref="model_ksw_workshop_part_line"/>
        <field name="domain_force">[('request_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ksw_workshop_part_line_technician" model="ir.rule">
        <field name="name">Workshop Part Line: technician sees in-progress + own assignments</field>
        <field name="model_id" ref="model_ksw_workshop_part_line"/>
        <field name="domain_force">['|', ('request_id.state', '=', 'in_progress'),
                                    '|', ('request_id.technician_id.user_id', '=', user.id),
                                         ('request_id.labor_line_ids.technician_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_technician'))]"/>
    </record>

    <record id="rule_ksw_workshop_part_line_manager" model="ir.rule">
        <field name="name">Workshop Part Line: manager sees all</field>
        <field name="model_id" ref="model_ksw_workshop_part_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_manager'))]"/>
    </record>

    <record id="rule_ksw_workshop_part_line_reviewer" model="ir.rule">
        <field name="name">Workshop Part Line: reviewer reads all</field>
        <field name="model_id" ref="model_ksw_workshop_part_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_reviewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Labor / service lines mirror the part-line rules exactly: a line is
        part of its request, so whoever can see the request can see what was
        done on it, and nobody else.
    -->
    <record id="rule_ksw_workshop_labor_line_own" model="ir.rule">
        <field name="name">Workshop Labor Line: own requests only</field>
        <field name="model_id" ref="model_ksw_workshop_labor_line"/>
        <field name="domain_force">[('request_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ksw_workshop_labor_line_technician" model="ir.rule">
        <field name="name">Workshop Labor Line: technician sees in-progress + own assignments</field>
        <field name="model_id" ref="model_ksw_workshop_labor_line"/>
        <field name="domain_force">['|', ('request_id.state', '=', 'in_progress'),
                                    ('technician_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_technician'))]"/>
    </record>

    <record id="rule_ksw_workshop_labor_line_manager" model="ir.rule">
        <field name="name">Workshop Labor Line: manager sees all</field>
        <field name="model_id" ref="model_ksw_workshop_labor_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_manager'))]"/>
    </record>

    <record id="rule_ksw_workshop_labor_line_reviewer" model="ir.rule">
        <field name="name">Workshop Labor Line: reviewer reads all</field>
        <field name="model_id" ref="model_ksw_workshop_labor_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_workshop_reviewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
