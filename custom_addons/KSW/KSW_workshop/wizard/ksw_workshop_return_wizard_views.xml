<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ksw_workshop_return_wizard_form" model="ir.ui.view">
        <field name="name">ksw.workshop.return.wizard.form</field>
        <field name="model">ksw.workshop.return.wizard</field>
        <field name="arch" type="xml">
            <form>
                <!-- Listed so the client record carries it (Odoo 19 Pitfalls #40). -->
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="return_reason" string="Reason"
                           placeholder="What should the requester correct before resubmitting?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Return to Requester"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
