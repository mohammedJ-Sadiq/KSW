#. module: KSW_helpdesk
#: model_terms:ir.actions.act_window,help:KSW_helpdesk.action_helpdesk_ticket_my_tickets
msgid "<strong>1.</strong> Click <strong>New</strong> above."
msgstr "<strong>١.</strong> اضغط <strong>جديد</strong> في الأعلى."

#. module: KSW_helpdesk
#: model_terms:ir.actions.act_window,help:KSW_helpdesk.action_helpdesk_ticket_my_tickets
msgid ""
"<strong>2.</strong> Choose <strong>Incident</strong> (something\n"
"                        broken) or <strong>Service Request</strong> (something you need)."
msgstr ""
"<strong>٢.</strong> اختر <strong>عُطل</strong> (شيء معطّل)\n"
"                        أو <strong>طلب خدمة</strong> (شيء تحتاج إليه)."

#. module: KSW_helpdesk
#: model_terms:ir.actions.act_window,help:KSW_helpdesk.action_helpdesk_ticket_my_tickets
msgid ""
"<strong>3.</strong> Give it a short, clear subject\n"
"                        (e.g. \"Laptop won't turn on\") and pick a\n"
"                        <strong>Category</strong>."
msgstr ""
"<strong>٣.</strong> اكتب وصفًا مختصرًا وواضحًا\n"
"                        (مثل: «الحاسب المحمول لا يعمل») ثم اختر\n"
"                        <strong>التصنيف</strong>."

#. module: KSW_helpdesk
#: model_terms:ir.actions.act_window,help:KSW_helpdesk.action_helpdesk_ticket_my_tickets
msgid ""
"<strong>4.</strong> Describe the issue with as much\n"
"                        detail as you can, and link the affected asset if any."
msgstr ""
"<strong>٤.</strong> اشرح المشكلة بأكبر قدر ممكن من\n"
"                        التفصيل، واربط الأصل التقني المتأثر إن وُجد."

#. module: KSW_helpdesk
#: model_terms:ir.actions.act_window,help:KSW_helpdesk.action_helpdesk_ticket_my_tickets
msgid ""
"<strong>5.</strong> Click <strong>Save</strong> — the\n"
"                        IT team is notified automatically and you can track\n"
"                        progress right here."
msgstr ""
"<strong>٥.</strong> اضغط <strong>حفظ</strong> — يُشعَر\n"
"                        فريق تقنية المعلومات تلقائيًا، ويمكنك متابعة\n"
"                        المعالجة من هذه الشاشة."

