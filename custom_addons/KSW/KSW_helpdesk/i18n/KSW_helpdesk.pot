#. module: KSW_helpdesk
#: model_terms:ir.actions.act_window,help:KSW_helpdesk.action_helpdesk_ticket_my_tickets
msgid ""
"<strong>2.</strong> Choose <strong>Incident</strong> (something\n"
"                        broken) or <strong>Service Request</strong> (something you need)."
msgstr ""

#. module: KSW_helpdesk
#: model_terms:ir.actions.act_window,help:KSW_helpdesk.action_helpdesk_ticket_my_tickets
msgid ""
"<strong>3.</strong> Give it a short, clear subject\n"
"                        (e.g. \"Laptop won't turn on\") and pick a\n"
"                        <strong>Category</strong>."
msgstr ""

#. module: KSW_helpdesk
#: model_terms:ir.actions.act_window,help:KSW_helpdesk.action_helpdesk_ticket_my_tickets
msgid ""
"<strong>4.</strong> Describe the issue with as much\n"
"                        detail as you can, and link the affected asset if any."
msgstr ""

#. module: KSW_helpdesk
#: model_terms:ir.actions.act_window,help:KSW_helpdesk.action_helpdesk_ticket_my_tickets
msgid ""
"<strong>5.</strong> Click <strong>Save</strong> — the\n"
"                        IT team is notified automatically and you can track\n"
"                        progress right here."
msgstr ""

#. module: KSW_helpdesk
#: model_terms:ir.ui.view,arch_db:KSW_helpdesk.helpdesk_ticket_view_form
msgid ""
"<strong>Quick tips for a faster fix:</strong> choose whether\n"
"                            this is an <strong>Incident</strong> (something broken) or a\n"
"                            <strong>Service Request</strong> (something you need), pick the\n"
"                            matching <strong>Category</strong>, describe the issue with as\n"
"                            much detail as you can, and link the <strong>Related Asset</strong>\n"
"                            if it applies. The IT team is notified the moment you save."
