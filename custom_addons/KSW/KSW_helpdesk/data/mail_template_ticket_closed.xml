<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_ticket_closed" model="mail.template">
            <field name="name">Helpdesk Ticket: Closed</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="use_default_to" eval="False"/>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{ object.caller_email }}</field>
            <field name="subject">Your ticket {{ object.ticket_ref }} has been closed</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="object.employee_id.name or ''"/>,</p>
                    <p>Your helpdesk ticket <strong><t t-out="object.ticket_ref"/></strong>
                        ("<t t-out="object.name"/>") has been closed
                        <t t-if="object.closed_by">by <t t-out="object.closed_by.name"/></t>.
                    </p>
                    <p>If the issue is not fully resolved, you can reopen it or reply on
                        the ticket's message log and the IT Team will follow up.</p>
                    <br/>
                    Best Regards,
                    <br/>
                    IT Helpdesk Team
                    <br/>
                </div>
            </field>
        </record>

    </data>
</odoo>
