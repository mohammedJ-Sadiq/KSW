<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<data noupdate="1">

    <record id="consumable_category_ink" model="it.consumable.category">
        <field name="name">Ink Cartridge</field>
        <field name="sequence">10</field>
        <field name="icon">fa-tint</field>
        <field name="color">4</field>
        <field name="is_ink_toner">1</field>
    </record>
    <record id="consumable_category_toner" model="it.consumable.category">
        <field name="name">Toner Cartridge</field>
        <field name="sequence">20</field>
        <field name="icon">fa-square</field>
        <field name="color">6</field>
        <field name="is_ink_toner">1</field>
    </record>
    <record id="consumable_category_cable" model="it.consumable.category">
        <field name="name">Cables &amp; Adapters</field>
        <field name="sequence">30</field>
        <field name="icon">fa-plug</field>
        <field name="color">3</field>
    </record>
    <record id="consumable_category_battery" model="it.consumable.category">
        <field name="name">Batteries</field>
        <field name="sequence">40</field>
        <field name="icon">fa-battery-full</field>
        <field name="color">2</field>
    </record>
    <record id="consumable_category_paper" model="it.consumable.category">
        <field name="name">Paper</field>
        <field name="sequence">50</field>
        <field name="icon">fa-file-o</field>
        <field name="color">1</field>
    </record>
    <record id="consumable_category_spare_part" model="it.consumable.category">
        <field name="name">Spare Parts</field>
        <field name="sequence">60</field>
        <field name="icon">fa-cogs</field>
        <field name="color">5</field>
    </record>
    <record id="consumable_category_other" model="it.consumable.category">
        <field name="name">Other</field>
        <field name="sequence">90</field>
        <field name="icon">fa-cube</field>
        <field name="color">8</field>
    </record>

</data>

    <!-- is_ink_toner added after these categories already existed in some
         databases: a plain <field> edit above is silently skipped by
         Odoo's noupdate gate on every upgrade after the first install (see
         CLAUDE.md gotcha #2), so flip it with write() instead, outside the
         noupdate block. Idempotent - safe to run on every upgrade. -->
    <function model="it.consumable.category" name="write">
        <value eval="[ref('consumable_category_ink'), ref('consumable_category_toner')]"/>
        <value eval="{'is_ink_toner': True}"/>
    </function>

</odoo>
