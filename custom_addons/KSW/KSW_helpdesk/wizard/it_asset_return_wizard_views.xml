<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="it_asset_return_wizard_view_form" model="ir.ui.view">
        <field name="name">it.asset.return.wizard.form</field>
        <field name="model">it.asset.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Asset">
                <group>
                    <field name="asset_id" invisible="1"/>
                    <field name="date_returned"/>
                    <field name="condition_in"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Return"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
