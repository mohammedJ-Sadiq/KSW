<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="it_consumable_issue_wizard_view_form" model="ir.ui.view">
        <field name="name">it.consumable.issue.wizard.form</field>
        <field name="model">it.consumable.issue.wizard</field>
        <field name="arch" type="xml">
            <form string="Issue Stock">
                <group>
                    <field name="consumable_id" invisible="1"/>
                    <field name="qty_on_hand" readonly="1"/>
                    <field name="quantity"/>
                    <field name="employee_id" options="{'no_create': True}"/>
                    <field name="asset_id" options="{'no_create': True}"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Issue"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
