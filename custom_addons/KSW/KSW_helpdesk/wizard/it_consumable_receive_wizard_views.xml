<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="it_consumable_receive_wizard_view_form" model="ir.ui.view">
        <field name="name">it.consumable.receive.wizard.form</field>
        <field name="model">it.consumable.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="Receive Stock">
                <group>
                    <field name="consumable_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="quantity"/>
                    <field name="supplier_id" options="{'no_create': True}"/>
                    <field name="unit_cost"/>
                    <field name="update_unit_cost"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Receive"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
