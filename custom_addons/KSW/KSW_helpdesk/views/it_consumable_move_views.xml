<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="it_consumable_move_view_list" model="ir.ui.view">
        <field name="name">it.consumable.move.list</field>
        <field name="model">it.consumable.move</field>
        <field name="arch" type="xml">
            <list default_order="date desc">
                <field name="date"/>
                <field name="consumable_id"/>
                <field name="category_id" optional="hide"/>
                <field name="move_type" widget="badge"
                       decoration-success="move_type == 'in'"
                       decoration-danger="move_type == 'out'"
                       decoration-info="move_type == 'adjustment'"/>
                <field name="quantity"/>
                <field name="employee_id" optional="show"/>
                <field name="asset_id" optional="hide"/>
                <field name="supplier_id" optional="hide"/>
                <field name="done_by" optional="hide"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="it_consumable_move_view_form" model="ir.ui.view">
        <field name="name">it.consumable.move.form</field>
        <field name="model">it.consumable.move</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="consumable_id"/>
                            <field name="move_type"/>
                            <field name="quantity"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="employee_id" invisible="move_type != 'out'"/>
                            <field name="asset_id" invisible="move_type != 'out'"/>
                            <field name="supplier_id" invisible="move_type != 'in'"/>
                            <field name="done_by" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" nolabel="1" placeholder="Note..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="it_consumable_move_view_search" model="ir.ui.view">
        <field name="name">it.consumable.move.search</field>
        <field name="model">it.consumable.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="consumable_id"/>
                <field name="employee_id"/>
                <field name="asset_id"/>
                <filter string="Received" name="in" domain="[('move_type', '=', 'in')]"/>
                <filter string="Issued" name="out" domain="[('move_type', '=', 'out')]"/>
                <filter string="Adjustments" name="adjustment" domain="[('move_type', '=', 'adjustment')]"/>
                <group>
                    <filter string="Consumable" name="group_consumable" context="{'group_by': 'consumable_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Issued To" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'move_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="it_consumable_move_action" model="ir.actions.act_window">
        <field name="name">Consumable Moves</field>
        <field name="res_model">it.consumable.move</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_consumable': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock moves yet
            </p>
            <p>
                Every receipt, issue and adjustment for every consumable is
                logged here - the audit trail for "who took what, when".
            </p>
        </field>
    </record>

</odoo>
