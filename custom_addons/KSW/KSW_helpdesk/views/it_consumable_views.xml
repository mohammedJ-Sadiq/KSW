<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =============================================================== -->
    <!-- KANBAN                                                            -->
    <!-- =============================================================== -->
    <record id="it_consumable_view_kanban" model="ir.ui.view">
        <field name="name">it.consumable.kanban</field>
        <field name="model">it.consumable</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="qty_on_hand"/>
                <field name="reorder_min"/>
                <field name="is_low_stock"/>
                <field name="uom"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong><field name="name"/></strong>
                                    <div class="text-muted small"><field name="code"/></div>
                                </div>
                                <span t-att-class="'badge ' + (record.is_low_stock.raw_value and 'text-bg-danger' or 'text-bg-success')">
                                    <field name="qty_on_hand"/> <field name="uom"/>
                                </span>
                            </div>
                            <div class="mt-2">
                                <span class="badge text-bg-light">
                                    <field name="category_id"/>
                                </span>
                                <span t-if="record.is_low_stock.raw_value" class="badge text-bg-danger ms-1">Low Stock</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- =============================================================== -->
    <!-- LIST                                                              -->
    <!-- =============================================================== -->
    <record id="it_consumable_view_list" model="ir.ui.view">
        <field name="name">it.consumable.list</field>
        <field name="model">it.consumable</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_low_stock">
                <header>
                    <button name="action_generate_purchase_request" type="object"
                            string="Generate Purchase Request" display="always"
                            class="oe_highlight"
                            help="Uses the selected rows, or every item currently low on stock if nothing is selected."/>
                </header>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="brand" optional="hide"/>
                <field name="compatible_with" optional="hide"/>
                <field name="location" optional="hide"/>
                <field name="qty_on_hand"/>
                <field name="uom"/>
                <field name="reorder_min" optional="hide"/>
                <field name="is_low_stock" invisible="1"/>
                <field name="unit_cost" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- =============================================================== -->
    <!-- FORM                                                              -->
    <!-- =============================================================== -->
    <record id="it_consumable_view_form" model="ir.ui.view">
        <field name="name">it.consumable.form</field>
        <field name="model">it.consumable</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_issue_wizard" type="object"
                            string="Issue Stock" class="oe_highlight"
                            invisible="qty_on_hand &lt;= 0"/>
                    <button name="action_open_receive_wizard" type="object"
                            string="Receive Stock"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Low Stock" bg_color="text-bg-danger"
                            invisible="not is_low_stock"/>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_moves" icon="fa-exchange">
                            <field name="move_count" widget="statinfo" string="Moves"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. HP 12A Black Toner Cartridge"/></h1>
                        <h3><field name="code" readonly="1"/></h3>
                    </div>

                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="brand"/>
                            <field name="compatible_with"/>
                            <field name="uom"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="qty_on_hand" readonly="1"/>
                            <field name="reorder_min"/>
                            <field name="reorder_qty"/>
                            <field name="supplier_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="unit_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" nolabel="1" placeholder="Internal notes about this item..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- =============================================================== -->
    <!-- SEARCH                                                            -->
    <!-- =============================================================== -->
    <record id="it_consumable_view_search" model="ir.ui.view">
        <field name="name">it.consumable.search</field>
        <field name="model">it.consumable</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Consumable"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('compatible_with', 'ilike', self)]"/>
                <field name="category_id"/>
                <field name="location"/>
                <filter string="Low Stock" name="low_stock" domain="[('is_low_stock', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =============================================================== -->
    <!-- ACTIONS                                                           -->
    <!-- =============================================================== -->
    <record id="action_it_consumable_all" model="ir.actions.act_window">
        <field name="name">Consumables</field>
        <field name="res_model">it.consumable</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first IT consumable
            </p>
            <p>
                Track ink, toner, cables and any other IT consumable stock:
                how much is on hand, who took what, and when it's time to
                reorder.
            </p>
        </field>
    </record>

</odoo>
