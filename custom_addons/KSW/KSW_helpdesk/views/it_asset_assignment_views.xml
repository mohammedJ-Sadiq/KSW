<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="it_asset_assignment_view_list" model="ir.ui.view">
        <field name="name">it.asset.assignment.list</field>
        <field name="model">it.asset.assignment</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'returned'">
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="category_id" optional="hide"/>
                <field name="date_assigned"/>
                <field name="date_returned"/>
                <field name="condition_out" optional="hide"/>
                <field name="condition_in" optional="hide"/>
                <field name="assigned_by" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="it_asset_assignment_view_form" model="ir.ui.view">
        <field name="name">it.asset.assignment.form</field>
        <field name="model">it.asset.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="employee_id"/>
                            <field name="assigned_by"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group>
                            <field name="date_assigned"/>
                            <field name="date_returned"/>
                            <field name="condition_out"/>
                            <field name="condition_in"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" nolabel="1" placeholder="Notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="it_asset_assignment_view_search" model="ir.ui.view">
        <field name="name">it.asset.assignment.search</field>
        <field name="model">it.asset.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="it_asset_assignment_action" model="ir.actions.act_window">
        <field name="name">Assignments</field>
        <field name="res_model">it.asset.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
