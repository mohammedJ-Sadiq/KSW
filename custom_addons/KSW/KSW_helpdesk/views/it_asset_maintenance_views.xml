<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="it_asset_maintenance_view_list" model="ir.ui.view">
        <field name="name">it.asset.maintenance.list</field>
        <field name="model">it.asset.maintenance</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'in_progress'">
                <field name="asset_id"/>
                <field name="issue"/>
                <field name="vendor_id" optional="hide" context="{'res_partner_search_mode': 'supplier'}"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="cost" sum="Total Cost"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="it_asset_maintenance_view_form" model="ir.ui.view">
        <field name="name">it.asset.maintenance.form</field>
        <field name="model">it.asset.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="issue"/>
                            <field name="vendor_id" context="{'res_partner_search_mode': 'supplier'}"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cost"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" nolabel="1" placeholder="Notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="it_asset_maintenance_view_search" model="ir.ui.view">
        <field name="name">it.asset.maintenance.search</field>
        <field name="model">it.asset.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="issue"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="it_asset_maintenance_action" model="ir.actions.act_window">
        <field name="name">Maintenance</field>
        <field name="res_model">it.asset.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
