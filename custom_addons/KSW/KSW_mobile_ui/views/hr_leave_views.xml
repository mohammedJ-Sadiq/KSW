<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Approve from the card. KSW hides core's Approve on multi-step leaves
         (can_approve = False), so an approver had to open every request.
         Each button carries the same per-user gate as the form button, and
         the action method re-checks it server-side. One label and the same
         classes as core's Approve: a user only ever sees their own step. -->
    <record id="hr_leave_view_kanban_mobile_steps" model="ir.ui.view">
        <field name="name">hr.leave.kanban.mobile.steps</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_kanban"/>
        <field name="arch" type="xml">
            <field name="can_approve" position="after">
                <field name="x_can_dm_approve"/>
                <field name="x_can_hr_approve"/>
                <field name="x_can_gm_initial_approve"/>
                <field name="x_can_acc_approve"/>
                <field name="x_can_gm_final_approve"/>
            </field>
            <xpath expr="//bottom/button[@name='action_approve'][1]" position="before">
                <button name="action_dm_approve" type="object"
                        class="btn btn-sm btn-primary py-0"
                        invisible="not x_can_dm_approve">Approve</button>
                <button name="action_hr_approve" type="object"
                        class="btn btn-sm btn-primary py-0"
                        invisible="not x_can_hr_approve">Approve</button>
                <button name="action_gm_initial_approve" type="object"
                        class="btn btn-sm btn-primary py-0"
                        invisible="not x_can_gm_initial_approve">Approve</button>
                <button name="action_acc_approve" type="object"
                        class="btn btn-sm btn-primary py-0"
                        invisible="not x_can_acc_approve">Approve</button>
                <button name="action_gm_final_approve" type="object"
                        class="btn btn-sm btn-primary py-0"
                        invisible="not x_can_gm_final_approve">Approve</button>
            </xpath>
        </field>
    </record>

    <!-- Return Confirmation: who is away, until when, and the button. -->
    <record id="hr_leave_view_kanban_return_mobile" model="ir.ui.view">
        <field name="name">hr.leave.kanban.return.mobile</field>
        <field name="model">hr.leave</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban class="ksw_m_cards" create="0" sample="1">
                <field name="x_can_confirm_return_manager"/>
                <field name="x_annual_approval_state"/>
                <templates>
                    <t t-name="card">
                        <field name="employee_id" class="fw-bold"/>
                        <field name="holiday_status_id" class="text-muted small"/>
                        <div class="mt-1">
                            <field name="request_date_from"/> → <field name="request_date_to"/>
                        </div>
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <field name="x_return_state" widget="badge"/>
                            <button name="action_confirm_return_manager" type="object"
                                    class="btn btn-sm btn-primary"
                                    invisible="not x_can_confirm_return_manager or x_annual_approval_state == 'pending_employee_signature'">
                                Confirm Return
                            </button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_leave_action_return_confirmation_view_list_mobile" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="act_window_id" ref="KSW_annual_leave.hr_leave_action_return_confirmation"/>
    </record>
    <record id="hr_leave_action_return_confirmation_view_kanban_mobile" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="hr_leave_view_kanban_return_mobile"/>
        <field name="act_window_id" ref="KSW_annual_leave.hr_leave_action_return_confirmation"/>
    </record>

</odoo>
