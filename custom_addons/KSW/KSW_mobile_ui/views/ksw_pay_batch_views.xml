<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Entries on a phone: each row is a card (mobile.scss, line tables),
         so everything a supervisor types stays; only the derived and
         read-only columns are dropped to keep the cards short. -->
    <record id="view_ksw_pay_batch_form_mobile" model="ir.ui.view">
        <field name="name">ksw.pay.batch.form.mobile</field>
        <field name="model">ksw.pay.batch</field>
        <field name="inherit_id" ref="KSW_commissions.view_ksw_pay_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='x_window_from']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='x_window_to']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='quantity_ref']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='threshold_qty']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='details']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='rate']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='amount_computed']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='amount_override']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='state']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='x_sub_batch_id']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='x_overlap_note']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/field[@name='x_return_reason']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='entries']/field[@name='entry_ids']/list/button[@name='action_explain']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='by_employee']/field[@name='entry_ids']/list/field[@name='option_id']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
            <xpath expr="//page[@name='by_employee']/field[@name='entry_ids']/list/field[@name='date']" position="attributes">
                <attribute name="class" add="ksw_m_hide" separator=" "/>
            </xpath>
        </field>
    </record>

</odoo>
