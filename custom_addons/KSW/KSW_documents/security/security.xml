<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ksw_documents" model="ir.module.category">
        <field name="name">KSW Documents</field>
        <field name="sequence">215</field>
    </record>
    <record id="privilege_documents" model="res.groups.privilege">
        <field name="name">Documents</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_documents"/>
    </record>
    <!-- HR / Administrative Affairs: keeps the register. Employee documents
         are personal data, so nobody else reads the register. -->
    <record id="group_document_officer" model="res.groups">
        <field name="name">Documents Officer</field>
        <field name="privilege_id" ref="privilege_documents"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">10</field>
    </record>
    <!-- A document request is its requester's; HR sees them all. -->
    <record id="rule_document_request_own" model="ir.rule">
        <field name="name">Document request: own</field>
        <field name="model_id" ref="model_ksw_document_request"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_document_request_officer" model="ir.rule">
        <field name="name">Document request: HR</field>
        <field name="model_id" ref="model_ksw_document_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_document_officer')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>
