<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ksw_documents" model="ir.module.category">
        <field name="name">KSW Documents</field>
        <field name="sequence">215</field>
    </record>
    <record id="privilege_documents" model="res.groups.privilege">
        <field name="name">Documents</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_documents"/>
    </record>
    <!-- HR / Administrative Affairs: keeps the register. Employee documents
         are personal data, so nobody else reads the register. -->
    <record id="group_document_officer" model="res.groups">
        <field name="name">Documents Officer</field>
        <field name="privilege_id" ref="privilege_documents"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('hr.group_hr_user'))]"/>
        <field name="sequence">10</field>
    </record>
    <!-- A document request is its requester's; HR sees them all. -->
    <record id="rule_document_request_own" model="ir.rule">
        <field name="name">Document request: own</field>
        <field name="model_id" ref="model_ksw_document_request"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_document_request_officer" model="ir.rule">
        <field name="name">Document request: HR</field>
        <field name="model_id" ref="model_ksw_document_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_document_officer')), (4, ref('base.group_system'))]"/>
    </record>
    <!-- Who reads which documents (Nov 2026, user decision): HR (the
         Documents Officer) and the system administrators read and change
         everything; everyone else only READS what concerns him: his own
         documents and the papers of the vehicle in his custody. Department
         and GM scope on vehicle papers is added by Vehicle Custody, which
         knows the departments. Each rule names its permissions. -->
    <record id="rule_document_own_read" model="ir.rule">
        <field name="name">Documents: own papers and the vehicle in my custody, read</field>
        <field name="model_id" ref="model_ksw_document"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('vehicle_id.x_custodian_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_document_officer_all" model="ir.rule">
        <field name="name">Documents: everything, Documents Officer and administrators</field>
        <field name="model_id" ref="model_ksw_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_document_officer')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>
