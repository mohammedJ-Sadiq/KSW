<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Group journal items by BAS chart level, anywhere (MIS drilldown uses these) -->
    <record id="view_account_move_line_filter_ksw_levels" model="ir.ui.view">
        <field name="name">account.move.line.search.ksw.levels</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <filter name="group_by_account" position="before">
                <filter string="Level 1" name="ksw_group_l1" domain="[]" context="{'group_by': 'x_group_l1_id'}"/>
                <filter string="Level 2" name="ksw_group_l2" domain="[]" context="{'group_by': 'x_group_l2_id'}"/>
                <filter string="Level 3" name="ksw_group_l3" domain="[]" context="{'group_by': 'x_group_l3_id'}"/>
                <filter string="Level 4" name="ksw_group_l4" domain="[]" context="{'group_by': 'x_group_l4_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
