<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cost centres as columns: journal items, and the lines of an entry or bill. -->
    <record id="view_move_line_tree_ksw_cost_centres" model="ir.ui.view">
        <field name="name">account.move.line.list.ksw.cost.centres</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="analytic_distribution" position="after">
                <field name="x_cost_centre_id" optional="show"/>
                <field name="x_employee_cost_centre_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_ksw_cost_centres" model="ir.ui.view">
        <field name="name">account.move.form.ksw.cost.centres</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='analytic_distribution']" position="after">
                <field name="x_cost_centre_id" optional="show"/>
                <field name="x_employee_cost_centre_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='analytic_distribution']" position="after">
                <field name="x_cost_centre_id" optional="show"/>
                <field name="x_employee_cost_centre_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_line_filter_ksw_cost_centres" model="ir.ui.view">
        <field name="name">account.move.line.search.ksw.cost.centres</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="x_cost_centre_id"/>
                <field name="x_employee_cost_centre_id"/>
            </field>
            <xpath expr="//search" position="inside">
                <group>
                    <filter name="g_ksw_cost_centre" string="Cost Centre"
                            context="{'group_by': 'x_cost_centre_id'}"/>
                    <filter name="g_ksw_employee_cost_centre" string="Employee Cost Centre"
                            context="{'group_by': 'x_employee_cost_centre_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
