<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Entry points the menus need and no installed module provides. Each one
      reuses the stock views; only the domain / default filter is new.
    -->

    <!-- Customers: ZATCA has three document types, Odoo menus show two.
         A debit note is created from its invoice (Debit Note button), so no
         create from here. -->
    <record id="action_ksw_debit_notes" model="ir.actions.act_window">
        <field name="name">Debit Notes</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('debit_origin_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No debit notes yet</p>
            <p>Open the customer invoice to be increased and click <b>Debit Note</b>.</p>
        </field>
    </record>

    <!-- Vendors: what falls due, oldest first; the payment run starts here -->
    <record id="action_ksw_payments_due" model="ir.actions.act_window">
        <field name="name">Payments Due</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="account.view_move_line_payment_tree"/>
        <field name="search_view_id" ref="account.view_account_move_line_payment_filter"/>
        <field name="domain">[('parent_state', '=', 'posted'), ('account_type', '=', 'liability_payable'),
                              ('amount_residual', '!=', 0), ('date_maturity', '!=', False)]</field>
        <field name="context">{'journal_type': 'purchase'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to pay</p>
            <p>Posted vendor bills with an open balance appear here by due date.</p>
        </field>
    </record>

    <!-- Bank & Cash: every unreconciled statement line, all bank journals.
         The OCA action of the same view is bound to one journal (active_id). -->
    <record id="action_ksw_bank_reconcile" model="ir.actions.act_window">
        <field name="name">Bank Reconciliation</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">kanban,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('account_reconcile_oca.bank_statement_line_reconcile_view')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account_statement_base.account_bank_statement_line_tree')})]"/>
        <field name="context">{'search_default_not_reconciled': True, 'create': False,
                               'view_ref': 'account_reconcile_oca.bank_statement_line_form_reconcile_view'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to reconcile</p>
            <p>Import a bank statement (Bank and Cash &gt; Import Statement) to start.</p>
        </field>
    </record>

    <!-- Review: posted entries nobody has marked as reviewed yet -->
    <record id="action_ksw_entries_to_review" model="ir.actions.act_window">
        <field name="name">Entries to Review</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="context">{'search_default_to_check': 1, 'create': False, 'view_no_maturity': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Everything has been reviewed</p>
        </field>
    </record>
</odoo>
