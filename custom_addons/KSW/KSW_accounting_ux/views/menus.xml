              parent="account.account_reports_legal_statements_menu" action="action_ksw_bs_wizard"/>
    <menuitem id="menu_ksw_pl" name="Profit and Loss" sequence="2"
              parent="account.account_reports_legal_statements_menu" action="action_ksw_pl_wizard"/>
    <menuitem id="menu_ksw_cf" name="Cash Flow Statement" sequence="3"
              parent="account.account_reports_legal_statements_menu" action="action_ksw_cf_wizard"/>
    <menuitem id="menu_ksw_partner_ledger" name="Partner Ledger" sequence="10"
              parent="account.account_reports_partners_reports_menu" action="account.action_account_moves_ledger_partner"/>
    <menuitem id="menu_ksw_activity_statement" name="Statement of Account" sequence="40"
              parent="account.account_reports_partners_reports_menu" action="action_ksw_activity_statement"/>
    <menuitem id="menu_ksw_outstanding_statement" name="Outstanding Statement" sequence="50"
              parent="account.account_reports_partners_reports_menu" action="action_ksw_outstanding_statement"/>
    <menuitem id="menu_ksw_bills_analysis" name="Bills Analysis" sequence="2"
              parent="account.account_reports_management_menu" action="account.action_account_invoice_report_all_supp"/>
    <menuitem id="menu_ksw_budget_analysis" name="Budget Analysis" sequence="15"
              parent="account.account_reports_management_menu" action="account_budget_oca.act_crossovered_budget_lines_view"/>
    <menuitem id="menu_ksw_asset_report" name="Assets Report" sequence="18"
              parent="account.account_reports_management_menu" action="account_asset_management.wiz_account_asset_report_action"/>

    <!-- Configuration -->
