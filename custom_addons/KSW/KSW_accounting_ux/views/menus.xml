              parent="account.account_account_menu" action="account_chart_update.action_wizard_update_chart"
              groups="base.group_no_one"/>
    <menuitem id="menu_ksw_fy_closing_templates" name="Year-End Closing Templates" sequence="50"
              parent="menu_ksw_config_periods" action="account_fiscal_year_closing.action_account_fiscalyear_closing_template"/>
    <menuitem id="menu_ksw_bank_accounts" name="Bank Accounts" sequence="10"
              parent="menu_ksw_config_banks" action="account.action_account_supplier_accounts"/>
    <menuitem id="menu_ksw_aged_config" name="Aged Report Intervals" sequence="30"
              parent="menu_ksw_config_reporting" action="account_financial_report.action_aged_partner_report_configuration"/>

