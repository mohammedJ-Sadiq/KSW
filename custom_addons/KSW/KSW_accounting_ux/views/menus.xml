<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      The Accounting app, laid out the way Odoo Enterprise and the big ERPs
      (SAP FI, Oracle Financials) divide the work:

        Dashboard
        Customers      receivables: documents, receipts, master data
        Vendors        payables: documents, payments, what falls due
        Bank and Cash  treasury: reconcile, statements, import
        Accounting     general ledger: Transactions / Actions / Management / Closing
        Review         audit: Control / Logs
        Reporting      Statement / Audit / Partner / Taxes / Management reports
        Configuration  one header per area, each with only its own settings

      Rules kept throughout:
      * a dropdown is either all plain items or all section headers, never a
        mix (a plain item under a header reads as belonging to it);
      * every report lives under Reporting only, every setting under
        Configuration only: nothing appears twice;
      * debug-only for tools a day-to-day accountant never needs.

      Folders emptied by this file (OCA "Assets", "Bank and Cash", "Date
      Ranges", "MIS Reporting", ...) disappear on their own: a menu with no
      action is only shown while it has a visible child.
    -->

    <!-- ============ New section headers ============ -->
    <menuitem id="menu_ksw_bank_cash" name="Bank and Cash" sequence="4"
              parent="account.menu_finance" groups="account.group_account_readonly"/>
    <menuitem id="menu_ksw_entries_actions" name="Actions" sequence="10"
              parent="account.menu_finance_entries"/>
    <menuitem id="menu_ksw_entries_management" name="Management" sequence="15"
              parent="account.menu_finance_entries"/>
    <menuitem id="menu_ksw_reports_audit" name="Audit Reports" sequence="2"
              parent="account.menu_finance_reports" groups="account.group_account_readonly"/>
    <menuitem id="menu_ksw_config_periods" name="Periods" sequence="12"
              parent="account.menu_finance_configuration"/>
    <menuitem id="menu_ksw_config_banks" name="Banks" sequence="22"
              parent="account.menu_finance_configuration"/>
    <menuitem id="menu_ksw_config_budgets" name="Budgets" sequence="27"
              parent="account.menu_finance_configuration"/>
    <menuitem id="menu_ksw_config_reporting" name="Reporting" sequence="50"
              parent="account.menu_finance_configuration"/>
    <menuitem id="menu_ksw_config_migration" name="Data Migration" sequence="90"
              parent="account.menu_finance_configuration"/>

    <!-- ============ New entries (KSW actions, or existing ones never given a menu) ============ -->
    <!-- Customers / Vendors -->
    <menuitem id="menu_ksw_debit_notes" name="Debit Notes" sequence="3"
              parent="account.menu_finance_receivables" action="action_ksw_debit_notes"/>
    <menuitem id="menu_ksw_payments_due" name="Payments Due" sequence="25"
              parent="account.menu_finance_payables" action="action_ksw_payments_due"/>

    <!-- Bank and Cash -->
    <menuitem id="menu_ksw_bank_reconcile" name="Bank Reconciliation" sequence="10"
              parent="menu_ksw_bank_cash" action="action_ksw_bank_reconcile"/>
    <menuitem id="menu_ksw_all_payments" name="All Payments" sequence="50"
              parent="menu_ksw_bank_cash" action="account.action_account_all_payments"/>

    <!-- Accounting -->
    <menuitem id="menu_ksw_account_reconcile" name="Account Reconciliation" sequence="20"
              parent="menu_ksw_entries_actions" action="account_reconcile_oca.account_account_reconcile_act_window"/>
    <menuitem id="menu_ksw_asset_compute" name="Compute Depreciation" sequence="20"
              parent="menu_ksw_entries_management" action="account_asset_management.account_asset_compute_action"/>
    <menuitem id="menu_ksw_budgets_by_account" name="Budgets by Account" sequence="40"
              parent="menu_ksw_entries_management" action="mis_builder_budget.mis_budget_by_account_act_window"/>
    <menuitem id="menu_ksw_fy_closing" name="Year-End Closing" sequence="20"
              parent="account.account_closing_menu" action="account_fiscal_year_closing.action_account_fiscalyear_closing"/>

    <!-- Review -->
    <menuitem id="menu_ksw_entries_to_review" name="Entries to Review" sequence="1"
              parent="account.account_audit_control_menu" action="action_ksw_entries_to_review"/>

    <!-- Reporting -->
