<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Balance Sheet (قائمة المركز المالي) on BAS's own chart: assets under 1,
      liabilities 21, equity 23, accumulated depreciation 24 (shown against the
      fixed assets it belongs to, not as a liability as BAS files it).

      Signs: credit balances are negated so every line reads positive.

      It agrees with the Income Statement by construction: "net result for the
      year" is the P&L's own net, including BAS's computed depreciation, and
      that same depreciation is added to the accumulated balance. The last
      line proves the statement balances.
      Generated from one spec per line; keep the records uniform when editing.
      Styles are shared with the Income Statement (mis_income_statement.xml).
    -->

    <record id="mis_bs_report" model="mis.report">
        <field name="name">Balance Sheet (KSW)</field>
        <field name="description">قائمة المركز المالي</field>
        <field name="style_id" ref="mis_pl_style_base"/>
    </record>

    <!-- BAS depreciation charged so far in the column (see mis_report._fetch_queries) -->
    <record id="mis_bs_query_depc" model="mis.report.query">
        <field name="report_id" ref="mis_bs_report"/>
        <field name="name">depc</field>
        <field name="model_id" ref="KSW_bas_gl_import.model_ksw_bas_fixed_asset"/>
        <field name="field_ids" eval="[(6, 0, [ref('KSW_bas_gl_import.field_ksw_bas_fixed_asset__amount')])]"/>
        <field name="aggregate">sum</field>
        <field name="date_field" ref="KSW_bas_gl_import.field_ksw_bas_fixed_asset__date"/>
        <field name="company_field_id" ref="KSW_bas_gl_import.field_ksw_bas_fixed_asset__company_id"/>
    </record>

