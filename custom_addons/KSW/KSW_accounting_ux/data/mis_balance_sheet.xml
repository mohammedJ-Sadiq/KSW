        <field name="auto_expand_accounts" eval="True"/>
        <field name="auto_expand_accounts_style_id" ref="mis_pl_style_account"/>
    </record>

    <record id="mis_bs_kpi_eq_prior" model="mis.report.kpi">
        <field name="report_id" ref="mis_bs_report"/>
        <field name="sequence">73</field>
        <field name="name">eq_prior</field>
        <field name="description">أرباح (خسائر) سنوات سابقة غير مرحّلة</field>
        <field name="expression">-balu[]</field>
        <field name="style_id" ref="mis_pl_style_line"/>
    </record>

    <record id="mis_bs_kpi_eq_result" model="mis.report.kpi">
        <field name="report_id" ref="mis_bs_report"/>
        <field name="sequence">74</field>
        <field name="name">eq_result</field>
        <field name="description">صافي ربح (خسارة) العام</field>
        <field name="expression">-bale[3%,4%] - (depc.amount or 0)</field>
        <field name="style_id" ref="mis_pl_style_line"/>
    </record>

    <record id="mis_bs_kpi_eq" model="mis.report.kpi">
        <field name="report_id" ref="mis_bs_report"/>
        <field name="sequence">79</field>
        <field name="name">eq</field>
        <field name="description">إجمالي حقوق الملكية</field>
        <field name="expression">eq_2301 + eq_2302 + eq_2303 + eq_prior + eq_result</field>
        <field name="style_id" ref="mis_pl_style_subtotal"/>
    </record>

    <record id="mis_bs_kpi_le" model="mis.report.kpi">
        <field name="report_id" ref="mis_bs_report"/>
        <field name="sequence">89</field>
        <field name="name">le</field>
        <field name="description">إجمالي الخصوم وحقوق الملكية</field>
        <field name="expression">cl + eq</field>
        <field name="style_id" ref="mis_pl_style_result"/>
    </record>

    <record id="mis_bs_kpi_check" model="mis.report.kpi">
        <field name="report_id" ref="mis_bs_report"/>
        <field name="sequence">99</field>
        <field name="name">check</field>
        <field name="description">فرق التوازن (يجب أن يساوي صفراً)</field>
        <field name="expression">assets - le</field>
        <field name="style_id" ref="mis_pl_style_net"/>
    </record>
</odoo>
