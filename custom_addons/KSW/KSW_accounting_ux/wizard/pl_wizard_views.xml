<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ksw_pl_wizard_view_form" model="ir.ui.view">
        <field name="name">ksw.pl.wizard.form</field>
        <field name="model">ksw.pl.wizard</field>
        <field name="arch" type="xml">
            <form string="Profit and Loss">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="layout" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_open" type="object" string="Show" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ksw_pl_wizard" model="ir.actions.act_window">
        <field name="name">Profit and Loss</field>
        <field name="res_model">ksw.pl.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
