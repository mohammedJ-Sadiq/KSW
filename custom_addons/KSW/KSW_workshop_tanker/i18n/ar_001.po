msgstr "%(n)s شاحنة في BAS ليس لها تطابق وحيد في الأسطول: %(list)s"

#. module: KSW_workshop_tanker
#. odoo-python
#: code:addons/KSW_workshop_tanker/models/fleet_vehicle.py:0
msgid ""
"%(n)s drivers BAS names are not linked to an employee (set their BAS Driver "
"Cost Center): %(list)s"
msgstr ""
"%(n)s سائقًا في BAS غير مربوطين بموظف (أدخل مركز تكلفة السائق في BAS لكل "
"منهم): %(list)s"

#. module: KSW_workshop_tanker
#. odoo-python
#: code:addons/KSW_workshop_tanker/models/fleet_vehicle.py:0
