msgstr "أضيف %(new)s تيدر، و%(old)s كانت موجودة في الأسطول مسبقا."

#. module: KSW_workshop_tanker
#. odoo-python
#: code:addons/KSW_workshop_tanker/models/fleet_vehicle.py:0
msgid ""
"%(updated)s trucks changed driver, %(unchanged)s unchanged (last %(days)s "
"days of BAS sales)."
msgstr ""
"تغيّر سائق %(updated)s شاحنة، ولم يتغير %(unchanged)s (آخر %(days)s يومًا من"
" مبيعات BAS)."

#. module: KSW_workshop_tanker
