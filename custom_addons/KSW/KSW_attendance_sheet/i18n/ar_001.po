"<small>\n"
"                            Until this is resolved and the month is\n"
"                            confirmed, payroll will pay this employee as\n"
"                            <b>zero attendance</b>.\n"
"                        </small>"
msgstr ""
"<small>\n"
"                            حتى تتم المعالجة ويعتمد الشهر،\n"
"                            ستدفع الرواتب لهذا الموظف على أساس\n"
"                            <b>حضور صفري</b>.\n"
"                        </small>"

