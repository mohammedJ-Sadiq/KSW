<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Groups for Employees -->
    <record id="group_hr_employee_subordinate" model="res.groups">
        <field name="name">Employee</field>
        <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">1</field>
    </record>
    <record id="group_hr_employee_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_employee_subordinate'))]"/>
        <field name="sequence">2</field>
    </record>
    <record id="group_hr_employee_supervisor_cascading" model="res.groups">
        <field name="name">Supervisor Cascading</field>
        <field name="privilege_id" ref="hr.res_groups_privilege_employees"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_employee_supervisor'))]"/>
        <field name="sequence">3</field>
    </record>

    <!-- 2. Groups for Attendances -->
    <record id="group_hr_attendance_employee_subordinate" model="res.groups">
        <field name="name">Employee</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">1</field>
    </record>
    <record id="group_hr_attendance_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_attendance_employee_subordinate'))]"/>
        <field name="sequence">2</field>
    </record>
    <record id="group_hr_attendance_supervisor_cascading" model="res.groups">
        <field name="name">Supervisor Cascading</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_attendance_supervisor'))]"/>
        <field name="sequence">3</field>
    </record>

    <!-- Global Company Rule Modification -->
    <record id="hr.hr_employee_comp_rule" model="ir.rule">
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <!-- 4. Rules for Employees -->
    <record id="rule_hr_employee_officer_all" model="ir.rule">
        <field name="name">HR Officer: See all employees in company</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
    </record>
    <record id="rule_hr_employee_self" model="ir.rule">
        <field name="name">Employee: Own records only</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_employee_subordinate')), (4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_hr_employee_supervisor" model="ir.rule">
        <field name="name">Supervisor: Immediate Subordinates</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_employee_supervisor'))]"/>
    </record>
    <record id="rule_hr_employee_supervisor_cascading" model="ir.rule">
        <field name="name">Supervisor Cascading: All Subordinates</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[('id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_hr_employee_supervisor_cascading'))]"/>
    </record>

    <!-- 5. Rules for Attendances -->
    <record id="rule_hr_attendance_self" model="ir.rule">
        <field name="name">Attendance: Own records only</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_attendance_employee_subordinate')), (4, ref('hr_attendance.group_hr_attendance_own_reader'))]"/>
    </record>
    <record id="rule_hr_attendance_supervisor" model="ir.rule">
        <field name="name">Attendance: Immediate Subordinates</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_hr_attendance_supervisor'))]"/>
    </record>
    <record id="rule_hr_attendance_supervisor_cascading" model="ir.rule">
        <field name="name">Attendance: All Subordinates</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_hr_attendance_supervisor_cascading'))]"/>
    </record>

    <!-- Restrict attendance write/delete to Administrator only -->
    <!-- Override core access records: Officer and User groups become read-only -->
    <record id="hr_attendance.access_hr_attendance_user" model="ir.model.access">
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
    <record id="hr_attendance.access_hr_attendance_officer" model="ir.model.access">
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Menu Updates -->
    <record id="hr.menu_hr_employee_payroll" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_hr_employee_subordinate'))]"/>
    </record>
    <record id="hr_attendance.menu_hr_attendance_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_hr_attendance_employee_subordinate'))]"/>
    </record>
    <record id="hr_attendance.menu_hr_attendance_view_attendances_management" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_hr_attendance_employee_subordinate'))]"/>
    </record>

    <!-- Hide Contacts app for plain Employee/Supervisor tier accounts:
         everyone in this company gets base.group_user via the Employees
         privilege groups above, so the core module's default
         "base.group_user,base.group_partner_manager" leaves Contacts visible
         to every single user. Replace it with the higher HR/admin tiers only. -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [
            ref('base.group_system'),
            ref('base.group_partner_manager'),
            ref('hr.group_hr_user'),
            ref('hr.group_hr_manager'),
        ])]"/>
    </record>

    <!-- Hide the UTM "Link Tracker" app for plain Employee/Supervisor tier
         accounts. Core gates it with base.group_no_one ("Technical
         Features"), which Odoo only enforces while the viewer's session has
         debug mode on (see ir_ui_menu.py:_visible_menu_ids), so whether it
         shows up depends on a per-user/per-session flag rather than a fixed
         group, and can end up visible to non-admins (seen on prod) if that
         flag was ever set for them. Replace it with an explicit group list
         that isn't tied to debug mode at all. -->
    <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

    <!-- ================================================================ -->
    <!-- Manager Delegation: the "Manager Assistant" capability            -->
    <!-- ================================================================ -->
    <!--
        A direct manager nominates assistants on their user record
        (res.users.x_assistant_ids). The assistant may PREPARE requests
        for that manager's direct reports; the manager still performs
        every approval step personally.

        Two keys are required and neither works alone:
          1. the manager names the assistant (res.users.x_assistant_ids)
          2. an administrator grants this group

        The group carries a privilege_id on purpose: a res.groups record
        with no privilege renders only in debug mode (the web client
        emits its "Extra Rights" block behind `odoo.debug`), so an
        admin would never find it on the user form. It gets its OWN
        privilege rather than becoming a fifth tier of KSW Leaves'
        "Leave Management", because a privilege renders as a
        single-select: "assistant" is orthogonal to the
        Self/Supervisor/Cascading/Officer ladder. It is about WHOSE
        scope, not HOW MUCH.
    -->
    <record id="privilege_manager_delegation" model="res.groups.privilege">
        <field name="name">Manager Delegation</field>
        <field name="sequence">12</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!--
        hr_holidays.group_hr_holidays_responsible is MANDATORY, not a
        convenience: the stock manager leave form gates the employee_id
        field itself on it (hr_holidays/views/hr_leave_views.xml), as
        does the whole Time Off > Management menu. Without it the
        assistant has no Employee selector and cannot file for anyone.
        It is safe to imply here because KSW_annual_leave neutralises
        both hr.leave rules that group carries, and its one allocation
        rule matches only records where the user is the employee or the
        leave_manager_id: never true for an assistant.

        NEVER add to implied_ids:
          * hr_holidays.group_hr_holidays_user
          * KSW_annual_leave.group_leave_officer
          * KSW_deduction.group_deduction_officer
        Record rules OR together across a user's groups, so any one of
        these would dissolve the "before approval" state gate; and the
        last one makes ksw.deduction.x_can_dm_approve unconditionally
        True, handing over the exact step this feature exists to protect.
        Locked by test_group_implications.
    -->
    <record id="group_manager_assistant" model="res.groups">
        <field name="name">Manager Assistant</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="privilege_manager_delegation"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('hr_holidays.group_hr_holidays_responsible')),
        ]"/>
        <field name="comment">Prepare and edit time off and loan requests on behalf of the direct reports of the managers who listed this user as their assistant. Can never approve or refuse a request. May delete a request they prepared only while it is still awaiting the manager's own first approval — the window closes the moment the manager (or the first KSW chain step) acts.</field>
    </record>

    <!--
        Inert for an assistant holding no tier in the Employees privilege:
        their hr.employee queries are answered by hr.employee.public
        instead. It matters when the assistant ALSO holds
        group_hr_employee_subordinate/_supervisor, where the self and
        supervisor rules above would otherwise hide the delegated team.
    -->
    <record id="rule_hr_employee_manager_assistant" model="ir.rule">
        <field name="name">Manager Assistant: assisted managers' direct reports (read)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_manager_assistant'))]"/>
        <field name="domain_force">['|',
            ('parent_id.user_id', 'in', user._ksw_assisted_manager_ids()),
            ('leave_manager_id', 'in', user._ksw_assisted_manager_ids())]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
