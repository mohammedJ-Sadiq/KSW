<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_ksw_payslip_revision_request" model="ir.sequence">
            <field name="name">Payslip Revision Request</field>
            <field name="code">ksw.payslip.revision.request</field>
            <field name="prefix">REVREQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_ksw_revision_bank_file" model="ir.sequence">
            <field name="name">Salary Revision Bank File</field>
            <field name="code">ksw.revision.bank.file</field>
            <field name="prefix">RBF/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
