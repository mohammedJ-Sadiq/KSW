<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- FORM                                                          -->
    <!-- ============================================================ -->
    <record id="view_ksw_payslip_revision_request_form" model="ir.ui.view">
        <field name="name">ksw.payslip.revision.request.form</field>
        <field name="model">ksw.payslip.revision.request</field>
        <field name="arch" type="xml">
            <form string="Payslip Revision Request">
                <header>
                    <!-- Every button's `invisible` reads one of the
                         can_* gate fields, which carry no model-level
                         groups= (pitfall #31) and are recomputed per user
                         (pitfall #14). The server-side guard in each
                         action method is what actually holds. -->
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary"
                            invisible="not can_submit"/>
                    <button name="action_dm_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="not can_dm_act"/>
                    <button name="action_dm_refuse" type="object"
                            string="Refuse"
                            invisible="not can_dm_act"/>
                    <button name="action_hr_accept" type="object"
                            string="Accept &amp; Issue Revision"
                            class="btn-primary"
                            invisible="not can_hr_act"
                            confirm="This will build the revision payslip for this period and send the request to the General Manager. Continue?"/>
                    <button name="action_hr_refuse" type="object"
                            string="Refuse"
                            invisible="not can_hr_act"/>
                    <button name="action_gm_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="not can_gm_act"/>
                    <button name="action_gm_return_to_hr" type="object"
                            string="Return to HR"
                            invisible="not can_gm_act"/>
                    <button name="action_gm_refuse" type="object"
                            string="Refuse"
                            invisible="not can_gm_act"/>
                    <button name="action_acc_pay" type="object"
                            string="Confirm &amp; Pay" class="btn-primary"
                            invisible="not can_acc_act"
                            confirm="This confirms the revision payslip. A bank transfer is marked paid and its Excel and TXT bank files are generated now; a cash payment goes to the Loan Disbursement Officer to hand over. Continue?"/>
                    <button name="action_acc_refuse" type="object"
                            string="Refuse"
                            invisible="not can_acc_act"/>
                    <button name="action_disbursement_confirm" type="object"
                            string="Confirm Disbursement" class="btn-primary"
                            invisible="not can_disburse"
                            confirm="Confirm that the cash has been handed over to the employee?"/>
                    <button name="action_export_bank_excel" type="object"
                            string="Bank File (Excel)"
                            invisible="state not in ('pending_acc', 'paid') or revision_state != 'done' or payment_method != 'bank'"
                            groups="om_hr_payroll.group_hr_payroll_user,KSW_annual_leave.group_annual_leave_acc"/>
                    <button name="action_export_bank_txt" type="object"
                            string="Bank File (TXT)"
                            invisible="state not in ('pending_acc', 'paid') or revision_state != 'done' or payment_method != 'bank'"
                            groups="om_hr_payroll.group_hr_payroll_user,KSW_annual_leave.group_annual_leave_acc"/>
                    <button name="action_cancel" type="object"
                            string="Cancel Request"
                            invisible="not can_cancel"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reopen"
                            invisible="state not in ('refused', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_dm,pending_hr,pending_gm,pending_acc,paid"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Refused"
                            bg_color="text-bg-danger"
                            invisible="state != 'refused'"/>
                    <widget name="web_ribbon" title="Cancelled"
                            bg_color="text-bg-secondary"
                            invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Paid"
                            bg_color="text-bg-success"
                            invisible="state != 'paid'"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_source_payslip" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                string="Payslip"
                                groups="KSW_payroll.group_hr_payroll_self"/>
                        <button name="action_open_revision_payslip"
                                type="object" class="oe_stat_button"
                                icon="fa-refresh" string="Revision"
                                invisible="not revision_state"
                                groups="om_hr_payroll.group_hr_payroll_user"/>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Gate fields: loaded invisible so the buttons above
                         can read them. -->
                    <field name="can_edit" invisible="1"/>
                    <field name="can_submit" invisible="1"/>
                    <field name="can_dm_act" invisible="1"/>
                    <field name="can_hr_act" invisible="1"/>
                    <field name="can_gm_act" invisible="1"/>
                    <field name="can_acc_act" invisible="1"/>
                    <field name="can_disburse" invisible="1"/>
                    <field name="can_cancel" invisible="1"/>
                    <field name="revision_state" invisible="1"/>

                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'refused'">
                        <strong>Refused by <field name="refused_by_id"
                                                  readonly="1" nolabel="1"/>:</strong>
                        <field name="refuse_reason" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Complaint">
                            <field name="employee_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="payslip_id"
                                   readonly="not can_edit"
                                   options="{'no_create': True}"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                        </group>
                        <group string="Amounts">
                            <field name="original_net" readonly="1"/>
                            <field name="claimed_amount"
                                   readonly="not can_edit"/>
                            <field name="deserved_net" readonly="1"
                                   invisible="not revision_state"/>
                            <field name="difference_amount" readonly="1"
                                   decoration-bf="1"
                                   decoration-danger="difference_amount &lt; 0"
                                   invisible="not revision_state"/>
                        </group>
                    </group>

                    <group string="What is wrong?">
                        <field name="reason" nolabel="1"
                               readonly="not can_edit"
                               placeholder="Describe what is missing or wrong in this payslip…"/>
                    </group>

                    <group string="Supporting Documents">
                        <field name="attachment_ids" widget="many2many_binary"
                               nolabel="1" readonly="not can_edit"/>
                    </group>

                    <notebook>
                        <page string="DM Approval" name="dm_approval"
                              invisible="state == 'draft'">
                            <group>
                                <field name="dm_user_id" readonly="1"/>
                                <field name="dm_date" readonly="1"/>
                            </group>
                            <group string="DM Comment">
                                <field name="dm_comment" nolabel="1"
                                       readonly="not can_dm_act"/>
                            </group>
                        </page>
                        <page string="HR Review" name="hr_review"
                              invisible="state in ('draft', 'pending_dm')">
                            <group>
                                <group>
                                    <field name="hr_user_id" readonly="1"/>
                                    <field name="hr_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="revision_payslip_id"
                                           readonly="1"
                                           groups="om_hr_payroll.group_hr_payroll_user"/>
                                </group>
                            </group>
                            <group string="HR Findings">
                                <field name="hr_comment" nolabel="1"
                                       readonly="not can_hr_act"
                                       placeholder="What was checked, and what was found…"/>
                            </group>
                        </page>
                        <page string="GM Approval" name="gm_approval"
                              invisible="state in ('draft', 'pending_dm', 'pending_hr')">
                            <group>
                                <field name="gm_user_id" readonly="1"/>
                                <field name="gm_date" readonly="1"/>
                            </group>
                            <group string="GM Comment">
                                <field name="gm_comment" nolabel="1"
                                       readonly="not can_gm_act"/>
                            </group>
                        </page>
                        <page string="Payment" name="payment"
                              invisible="state not in ('pending_acc', 'pending_disbursement', 'paid')">
                            <group>
                                <group>
                                    <field name="payment_method"
                                           readonly="not can_acc_act"
                                           required="state == 'pending_acc'"/>
                                    <field name="payment_reference"
                                           readonly="not (can_acc_act or can_disburse)"/>
                                </group>
                                <group>
                                    <field name="acc_user_id" readonly="1"/>
                                    <field name="acc_date" readonly="1"/>
                                    <field name="disbursed_by_id" readonly="1"
                                           invisible="payment_method != 'cash'"/>
                                    <field name="disbursed_date" readonly="1"
                                           invisible="payment_method != 'cash'"/>
                                    <field name="payment_date" readonly="1"/>
                                    <field name="payslip_run_id" readonly="1"
                                           groups="om_hr_payroll.group_hr_payroll_user"/>
                                </group>
                            </group>
                            <div class="alert alert-info" role="alert"
                                 invisible="state != 'pending_acc'">
                                <strong>Bank transfer:</strong> Confirm &amp; Pay
                                marks the request paid and generates the Excel
                                and TXT bank files for this employee alone.
                                <strong>Cash:</strong> Confirm &amp; Pay sends
                                it to the Loan Disbursement Officer, who
                                confirms once the cash is handed over.
                            </div>
                            <div class="alert alert-warning" role="alert"
                                 invisible="state != 'pending_disbursement'">
                                Awaiting the Loan Disbursement Officer to
                                confirm the cash was handed to the employee.
                            </div>
                            <div class="alert alert-info" role="alert"
                                 invisible="state != 'paid' or payment_method != 'bank'">
                                The Excel and TXT bank files are kept under
                                Supporting Documents above. Use
                                <strong>Bank File (Excel)</strong> /
                                <strong>Bank File (TXT)</strong> to produce them
                                again.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- LIST                                                          -->
    <!-- ============================================================ -->
    <record id="view_ksw_payslip_revision_request_list" model="ir.ui.view">
        <field name="name">ksw.payslip.revision.request.list</field>
        <field name="model">ksw.payslip.revision.request</field>
        <field name="arch" type="xml">
            <list string="Revision Requests"
                  decoration-muted="state in ('cancelled', 'refused')"
                  decoration-success="state == 'paid'"
                  decoration-bf="state in ('pending_dm', 'pending_hr', 'pending_gm', 'pending_acc', 'pending_disbursement')">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="date_from" optional="hide"/>
                <field name="date_to" string="Period" optional="show"/>
                <field name="request_date" optional="show"/>
                <field name="claimed_amount" sum="Claimed" optional="hide"/>
                <field name="difference_amount" sum="Difference Payable"/>
                <field name="payment_method" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'refused'"
                       decoration-warning="state in ('pending_dm', 'pending_hr', 'pending_gm', 'pending_acc', 'pending_disbursement')"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- SEARCH                                                        -->
    <!-- ============================================================ -->
    <record id="view_ksw_payslip_revision_request_search" model="ir.ui.view">
        <field name="name">ksw.payslip.revision.request.search</field>
        <field name="model">ksw.payslip.revision.request</field>
        <field name="arch" type="xml">
            <search string="Revision Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="payslip_id"/>
                <filter name="pending_my_action" string="Waiting For Me"
                        domain="[('is_pending_my_action', '=', True)]"/>
                <separator/>
                <filter name="open" string="Open"
                        domain="[('state', 'in', ['draft', 'pending_dm', 'pending_hr', 'pending_gm', 'pending_acc', 'pending_disbursement'])]"/>
                <filter name="paid" string="Paid"
                        domain="[('state', '=', 'paid')]"/>
                <filter name="refused" string="Refused / Cancelled"
                        domain="[('state', 'in', ['refused', 'cancelled'])]"/>
                <separator/>
                <filter name="my_requests" string="My Requests"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="my_team" string="My Team"
                        domain="[('employee_id.parent_id.user_id', '=', uid)]"/>
                <group>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_month" string="Request Month"
                            context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- ACTIONS                                                       -->
    <!-- ============================================================ -->

    <!-- Employee-facing. Filing starts here as well as from the payslip
         itself, so the section is a place to *go*, not only a place
         requests land. -->
    <record id="action_ksw_my_revision_requests" model="ir.actions.act_window">
        <field name="name">My Revision Requests</field>
        <field name="res_model">ksw.payslip.revision.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('employee_id.user_id', '=', uid), ('employee_id.parent_id.user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No salary revision requests yet
            </p>
            <p>
                If one of your payslips paid you less than it should have,
                open that payslip and press
                <b>Request a Salary Revision</b>. Your direct manager approves
                it, HR checks the complaint, the General Manager approves the
                correction, and accounting pays you the difference.
            </p>
        </field>
    </record>

    <!-- Approver-facing: every request the user's record rules let them
         reach. The default filter is the one thing they came for. -->
    <record id="action_ksw_revision_requests_all" model="ir.actions.act_window">
        <field name="name">Revision Requests</field>
        <field name="res_model">ksw.payslip.revision.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="action_ksw_revision_requests_todo" model="ir.actions.act_window">
        <field name="name">Waiting For My Action</field>
        <field name="res_model">ksw.payslip.revision.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending_my_action': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing is waiting on you
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- WIZARD: refuse / return reason                                -->
    <!-- ============================================================ -->
    <record id="view_ksw_revision_request_reason_wizard_form"
            model="ir.ui.view">
        <field name="name">ksw.revision.request.reason.wizard.form</field>
        <field name="model">ksw.revision.request.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason">
                <!-- request_id must be in the arch, not merely in the
                     context: the client builds its record from the fields
                     the *view* asks for, and the related fields below
                     resolve against that record (pitfall #40). -->
                <field name="request_id" invisible="1"/>
                <field name="mode" invisible="1"/>
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="difference_amount" readonly="1"
                           invisible="mode != 'return'"/>
                </group>
                <group>
                    <field name="reason" nolabel="1"
                           placeholder="Explain the decision — the employee is notified with this text."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- MENUS — the reserved section                                  -->
    <!-- ============================================================ -->
    <!--
        A menu's effective groups= is the INTERSECTION of its own and
        every ancestor's (pitfall #41), and the Payroll root is gated on
        `group_hr_payroll_self`. The HR, GM and Accounting approvers hold
        neither that group nor any payslip access, so the root menuitem is
        re-declared in security/hr_payroll_security.xml to include them —
        otherwise these items exist but nobody outside payroll can reach
        them.
    -->
    <menuitem id="menu_ksw_revision_requests_root"
              name="Salary Revisions"
              parent="om_hr_payroll.menu_hr_payroll_root"
              sequence="15"
              groups="KSW_payroll.group_hr_payroll_self,KSW_annual_leave.group_annual_leave_hr,KSW_annual_leave.group_annual_leave_gm,KSW_annual_leave.group_annual_leave_acc"/>

    <menuitem id="menu_ksw_my_revision_requests"
              name="My Revision Requests"
              parent="menu_ksw_revision_requests_root"
              action="action_ksw_my_revision_requests"
              sequence="10"
              groups="KSW_payroll.group_hr_payroll_self"/>

    <menuitem id="menu_ksw_revision_requests_todo"
              name="Waiting For My Action"
              parent="menu_ksw_revision_requests_root"
              action="action_ksw_revision_requests_todo"
              sequence="20"
              groups="KSW_payroll.group_hr_payroll_self,om_hr_payroll.group_hr_payroll_user,KSW_annual_leave.group_annual_leave_hr,KSW_annual_leave.group_annual_leave_gm,KSW_annual_leave.group_annual_leave_acc"/>

    <menuitem id="menu_ksw_revision_requests_all"
              name="All Revision Requests"
              parent="menu_ksw_revision_requests_root"
              action="action_ksw_revision_requests_all"
              sequence="30"
              groups="om_hr_payroll.group_hr_payroll_user,KSW_annual_leave.group_annual_leave_hr,KSW_annual_leave.group_annual_leave_gm,KSW_annual_leave.group_annual_leave_acc,KSW_payroll.group_hr_payroll_reviewer"/>

</odoo>
