<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Extend hr.leave FORM: vacation payslip smart button          -->
    <!-- ============================================================ -->
    <record id="hr_leave_view_form_inherit_payroll_vacation" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit.payroll.vacation</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="KSW_annual_leave.hr_leave_view_form_inherit_annual_return"/>
        <field name="arch" type="xml">

            <!-- Hidden field so x_vacation_payslip_id is always loaded
                 (used in invisible expressions below). -->
            <xpath expr="//field[@name='x_is_annual_leave_type']" position="after">
                <field name="x_vacation_payslip_id" invisible="1"
                       groups="om_hr_payroll.group_hr_payroll_user,KSW_annual_leave.group_annual_leave_hr"/>
                <!-- Ungated on purpose: both are sudo-computed and are used
                     in invisible= expressions on elements visible to HR /
                     Accounting / GM approvers as well as payroll users. -->
                <field name="x_can_preview_vacation_payslip" invisible="1"/>
                <field name="x_has_vacation_calc" invisible="1"/>
                <field name="x_vacation_calc_is_preview" invisible="1"/>
            </xpath>

            <!-- Smart-button box injected before the leave content div. -->
            <xpath expr="//div[hasclass('o_hr_leave_content')]" position="before">
                <div class="oe_button_box" name="button_box"
                     invisible="not x_annual_approval_state">
                    <button class="oe_stat_button"
                            name="action_open_vacation_payslips"
                            type="object"
                            icon="fa-file-text-o"
                            invisible="not x_vacation_payslip_id"
                            groups="om_hr_payroll.group_hr_payroll_user">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="x_vacation_payslip_ids" widget="statinfo"
                                       string=" " nolabel="1"/>
                            </span>
                            <span class="o_stat_text">Vacation Payslip(s)</span>
                        </div>
                    </button>
                    <button class="oe_stat_button"
                            name="action_print_vacation_report"
                            type="object"
                            icon="fa-print">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Print Vacation</span>
                            <span class="o_stat_text">Report</span>
                        </div>
                    </button>
                    <button class="oe_stat_button"
                            name="action_recompute_vacation_payslip"
                            type="object"
                            icon="fa-refresh"
                            invisible="not x_vacation_payslip_id"
                            groups="om_hr_payroll.group_hr_payroll_user,KSW_annual_leave.group_annual_leave_hr"
                            confirm="This will cancel the existing payslip and recreate it from the current leave inputs. Continue?">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Recompute</span>
                            <span class="o_stat_text">Payslip</span>
                        </div>
                    </button>
                </div>
            </xpath>

            <!-- ================================================== -->
            <!-- Provisional vacation calculation                   -->
            <!-- Lets HR / Accounting / GM see the vacation balance -->
            <!-- and salary figures before the chain completes.     -->
            <!-- ================================================== -->
            <xpath expr="//page[@name='decision_support']" position="after">
                <page string="🧮 Vacation Calculation" name="vacation_calculation"
                      invisible="not x_annual_approval_state"
                      groups="om_hr_payroll.group_hr_payroll_user,KSW_annual_leave.group_annual_leave_hr,KSW_annual_leave.group_annual_leave_acc,KSW_annual_leave.group_annual_leave_gm">

                    <div class="alert alert-warning" role="alert"
                         invisible="not x_vacation_calc_is_preview">
                        <strong>Provisional figures.</strong>
                        This calculation was generated before the request
                        finished its approval chain, so some inputs
                        (penalty, commissions, loans, flight ticket) may
                        still be missing or change. A definitive payslip
                        replaces it at GM final approval.
                    </div>

                    <div class="alert alert-info" role="alert"
                         invisible="x_has_vacation_calc or not x_can_preview_vacation_payslip">
                        No calculation has been generated yet. Use
                        <strong>Generate Draft Calculation</strong> below to
                        see the vacation balance and salary figures as they
                        stand right now.
                    </div>

                    <button string="🧮 Generate Draft Calculation"
                            name="action_preview_vacation_payslip"
                            type="object" class="btn-secondary"
                            invisible="not x_can_preview_vacation_payslip"
                            confirm="This produces a DRAFT vacation payslip from the data entered so far. Any earlier draft calculation for this request is cancelled. Continue?"/>

                    <group invisible="not x_has_vacation_calc">
                        <group string="Calculation">
                            <field name="x_vacation_calc_period"
                                   string="Payslip Period" readonly="1"/>
                            <field name="x_vacation_calc_balance"
                                   string="Vacation Balance Settlement"
                                   readonly="1"/>
                        </group>
                        <group string="Salary">
                            <field name="x_vacation_calc_gross"
                                   string="Gross" readonly="1"/>
                            <field name="x_vacation_calc_deductions"
                                   string="Total Deductions" readonly="1"/>
                            <field name="x_vacation_calc_net"
                                   string="Net Payable" readonly="1"
                                   class="fw-bold"/>
                        </group>
                    </group>

                </page>
            </xpath>

        </field>
    </record>

</odoo>

