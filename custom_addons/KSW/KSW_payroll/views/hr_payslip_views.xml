<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- WORKED DAYS: colour-coded rows + deduction amount column     -->
    <!-- ============================================================ -->
    <record id="view_hr_payslip_form_inherit_worked_days"
            model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.worked.days</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">

            <!-- ── Hide all action buttons from read-only access tiers (self/supervisor/cascade) ── -->
            <xpath expr="//header" position="attributes">
                <attribute name="groups">om_hr_payroll.group_hr_payroll_user</attribute>
            </xpath>

            <!-- ── Reversal actions: Payroll Manager only ──
                 Cancel Payslip / Set to Draft / Refund undo a confirmed
                 payslip. Stock om_hr_payroll leaves them open to every
                 payroll Officer, with no reason recorded (only write_uid /
                 write_date). Server-side guards live in
                 hr.payslip._check_payroll_manager; these groups= just keep
                 the buttons off screen. -->
            <xpath expr="//header/button[@name='action_payslip_cancel']"
                   position="attributes">
                <attribute name="groups">om_hr_payroll.group_hr_payroll_manager</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_payslip_draft']"
                   position="attributes">
                <attribute name="groups">om_hr_payroll.group_hr_payroll_manager</attribute>
            </xpath>
            <xpath expr="//header/button[@name='refund_sheet']"
                   position="attributes">
                <attribute name="groups">om_hr_payroll.group_hr_payroll_manager</attribute>
            </xpath>

            <!-- ── Issue Revision ──
                 Re-issues a confirmed period: recomputes it with current
                 data and pays only the difference. Additive rather than
                 destructive, so it sits with the Officer tier, not the
                 Manager tier that owns Cancel / Set to Draft / Refund.
                 The server-side guard is
                 hr.payslip._check_payroll_officer. -->
            <xpath expr="//header/button[@name='refund_sheet']"
                   position="after">
                <button string="Issue Revision" name="action_issue_revision"
                        type="object" class="btn-primary"
                        invisible="state != 'done' or x_is_revision or credit_note"
                        groups="om_hr_payroll.group_hr_payroll_user"
                        help="Recompute this period with current data and pay the employee the difference."/>
            </xpath>

            <!-- ── Flag provisional (mid-approval) vacation calculations ── -->
            <xpath expr="//sheet" position="inside">
                <field name="x_is_vacation_preview" invisible="1"/>
                <field name="x_is_revision" invisible="1"/>
                <widget name="web_ribbon" title="Provisional"
                        bg_color="text-bg-warning"
                        invisible="not x_is_vacation_preview"/>
                <widget name="web_ribbon" title="Revision"
                        bg_color="text-bg-info"
                        invisible="not x_is_revision"/>
            </xpath>

            <!-- ── Revisions of this payslip ── -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_revisions" type="object"
                        class="oe_stat_button" icon="fa-refresh"
                        invisible="x_revision_count == 0"
                        groups="om_hr_payroll.group_hr_payroll_user">
                    <field name="x_revision_count" widget="statinfo"
                           string="Revisions"/>
                </button>
            </xpath>

            <!-- ── Revision summary: deserved vs already paid vs owed ──
                 Placed before the notebook (sheet level). Inserting after a
                 field inside the col="4" group would land inside that grid
                 and break the Period / Credit Note row (pitfall #21). -->
            <xpath expr="//notebook" position="before">
                <group string="Revision Summary" invisible="not x_is_revision"
                       groups="om_hr_payroll.group_hr_payroll_user">
                    <group>
                        <field name="x_revised_payslip_id" readonly="1"/>
                        <field name="x_deserved_net" readonly="1"
                               string="Deserved Net (whole period)"/>
                    </group>
                    <group>
                        <field name="x_prior_net_paid" readonly="1"
                               string="Already Paid"/>
                        <field name="x_net_wage" readonly="1"
                               string="Difference Payable"
                               decoration-danger="x_net_wage &lt; 0"
                               decoration-bf="1"/>
                    </group>
                </group>
            </xpath>

            <!-- ── Replace the entire worked-days list with a styled one ── -->
            <xpath expr="//field[@name='worked_days_line_ids']/list"
                   position="replace">
                <list string="Worked Days" editable="bottom"
                      decoration-success="code == 'WORK100'"
                      decoration-danger="code in ('ATT_ABS', 'ATT_DED')"
                      decoration-warning="code in ('ATT_LATE', 'ATT_EARLY')"
                      decoration-bf="code in ('WORK100', 'ATT_DED')">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="x_count_display" string="Count"/>
                    <field name="x_value_display" string="Value"/>
                    <field name="amount"          string="Deduction"
                           decoration-danger="amount &gt; 0"/>
                    <field name="number_of_days"  column_invisible="True"/>
                    <field name="number_of_hours" column_invisible="True"/>
                    <field name="version_id" column_invisible="True"/>
                    <field name="sequence" invisible="True"/>
                </list>
            </xpath>

            <!-- ── Replace the worked-days form popup ── -->
            <xpath expr="//field[@name='worked_days_line_ids']/form"
                   position="replace">
                <form string="Worked Day">
                    <group col="4">
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="number_of_days"  string="Count"/>
                        <field name="number_of_hours" string="Value"/>
                        <field name="amount"          string="Deduction"/>
                        <field name="version_id" invisible="1"/>
                    </group>
                </form>
            </xpath>

            <!-- ── Hide version_id and sequence in Other Inputs list & form ── -->
            <xpath expr="//field[@name='input_line_ids']/list/field[@name='version_id']"
                   position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='input_line_ids']/list/field[@name='sequence']"
                   position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='input_line_ids']/form//field[@name='version_id']"
                   position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Daily / Hourly wage info before notebook ── -->
            <xpath expr="//field[@name='credit_note']" position="after">
                <field name="x_daily_wage" string="Daily Wage"/>
                <field name="x_hourly_wage" string="Hourly Wage"/>
            </xpath>

            <!-- ── Replace the salary computation list with a styled one ── -->
            <xpath expr="//field[@name='line_ids']/list"
                   position="replace">
                <list string="Salary Structure" editable="bottom"
                      decoration-muted="total == 0"
                      decoration-danger="total &lt; 0"
                      decoration-success="code == 'NET' and total &gt; 0"
                      decoration-bf="code in ('BASIC', 'GROSS', 'NET', 'ATTDED')">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="category_id"/>
                    <field name="sequence" column_invisible="True"/>
                    <field name="quantity"  column_invisible="True"/>
                    <field name="rate"      column_invisible="True"/>
                    <field name="amount"/>
                    <field name="total"
                           decoration-danger="total &lt; 0"/>
                    <field name="salary_rule_id" optional="hide"/>
                </list>
            </xpath>

            <!-- ── Replace the Details By Salary Rule Category list ── -->
            <xpath expr="//field[@name='details_by_salary_rule_category']/list"
                   position="replace">
                <list string="Payslip Lines"
                      decoration-muted="total == 0"
                      decoration-danger="total &lt; 0"
                      decoration-bf="code in ('BASIC', 'GROSS', 'NET')">
                    <field name="category_id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="total"/>
                </list>
            </xpath>

        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Payroll Structure form: expose absence-only deduction flag   -->
    <!-- ============================================================ -->
    <record id="view_hr_payroll_structure_form_inherit_ksw"
            model="ir.ui.view">
        <field name="name">hr.payroll.structure.form.inherit.ksw</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id"
               ref="om_hr_payroll.view_hr_employee_grade_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <field name="x_absence_only_deduction"
                       string="Absence-Only Deduction"
                       help="If enabled, only fully absent or unpresented days are deducted. Late arrivals and early departures carry no salary penalty."/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Generate Payslips wizard: move button to footer so the       -->
    <!-- default Save/Discard buttons are suppressed.                 -->
    <!-- ============================================================ -->
    <record id="view_hr_payslip_by_employees_inherit"
            model="ir.ui.view">
        <field name="name">hr.payslip.employees.form.inherit.ksw</field>
        <field name="model">hr.payslip.employees</field>
        <field name="inherit_id"
               ref="om_hr_payroll.view_hr_payslip_by_employees"/>
        <field name="arch" type="xml">
            <!-- Remove the Generate button from header -->
            <xpath expr="//header/button[@name='compute_sheet']"
                   position="replace"/>

            <!-- Add explicit footer (suppresses default Save/Discard) -->
            <xpath expr="//form" position="inside">
                <footer>
                    <button icon="fa-cogs" string="Generate"
                            name="compute_sheet" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Payslip List: add Net Salary column                        -->
    <!-- ============================================================ -->
    <record id="view_hr_payslip_list_inherit_ksw_net" model="ir.ui.view">
        <field name="name">hr.payslip.list.inherit.ksw.net</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='state']" position="before">
                <field name="x_net_wage" string="Net Salary" digits="[16,0]"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Payslip Batch: Export Bank File button + Skip log section  -->
    <!-- ============================================================ -->
    <record id="hr_payslip_run_form_inherit_ksw" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.inherit.ksw</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='close_payslip_run']"
                   position="after">
                <button name="action_open_export_wizard" type="object"
                        string="Export Bank File"
                        icon="fa-download"
                        class="btn-secondary"/>
            </xpath>

            <!-- Reopening a closed batch: Payroll Manager only (guarded in
                 hr.payslip.run.draft_payslip_run as well). -->
            <xpath expr="//header/button[@name='draft_payslip_run']"
                   position="attributes">
                <attribute name="groups">om_hr_payroll.group_hr_payroll_manager</attribute>
            </xpath>
            <!-- x_salary_bank_account_id hidden inside the group (used as fallback in refresh logic) -->
            <xpath expr="//field[@name='credit_note']" position="after">
                <field name="x_salary_bank_account_id" invisible="1"/>
            </xpath>
            <!-- Bank totals: outside the group, before the payslips list -->
            <xpath expr="//field[@name='slip_ids']" position="before">
                <div>
                    <button name="action_refresh_bank_totals" type="object"
                            string="Refresh Totals" icon="fa-refresh"
                            class="btn-sm btn-secondary"/>
                </div>
                <separator string="NET Totals by Bank Account"
                           invisible="not x_bank_total_ids"/>
                <field name="x_bank_total_ids" nolabel="1" readonly="1"
                       invisible="not x_bank_total_ids">
                    <list string="Bank Account Totals">
                        <field name="bank_account_id" string="Account" width="260px"/>
                        <field name="slip_count" string="Employees" width="90px"/>
                        <field name="payable_count" string="In Bank File"
                               width="90px"/>
                        <field name="total_net" string="Total NET (Paid)"
                               digits="[16,2]" width="150px"
                               decoration-bf="True"/>
                        <field name="excluded_count" string="Excluded"
                               width="90px"
                               decoration-danger="excluded_count &gt; 0"/>
                        <field name="excluded_net" string="Excluded NET"
                               digits="[16,2]" width="130px"
                               decoration-danger="excluded_net &lt; 0"/>
                    </list>
                </field>
            </xpath>
            <xpath expr="//field[@name='slip_ids']" position="before">
                <button name="action_open_batch_payslips" type="object"
                        string="Search Payslip Lines"
                        icon="fa-search"
                        class="btn-secondary"/>
            </xpath>
            <!-- Skipped employees log below the payslips list -->
            <xpath expr="//field[@name='slip_ids']" position="after">
                <separator string="⚠ Skipped Employees"
                           invisible="not x_skip_line_ids"/>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not x_skip_line_ids">
                    The following employees were automatically skipped during
                    payslip generation. Resolve the issue shown and
                    re-generate payslips to include them.
                </div>
                <field name="x_skip_line_ids" readonly="1"
                       invisible="not x_skip_line_ids">
                    <list string="Skipped Employees"
                          decoration-warning="True">
                        <field name="employee_id"/>
                        <field name="reason" string="Reason Skipped"/>
                    </list>
                </field>
                <div invisible="not x_skip_line_ids">
                    <button name="action_clear_skip_log" type="object"
                            string="Clear Skip Log"
                            icon="fa-trash"
                            class="btn-sm btn-secondary"
                            confirm="Remove all skipped-employee entries from this batch?"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Payslip: pivot + graph (dashboard data source)                -->
    <!-- ============================================================ -->
    <record id="hr_payslip_view_pivot" model="ir.ui.view">
        <field name="name">hr.payslip.pivot.ksw</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <pivot string="Payslips" sample="1">
                <field name="department_id" type="row"/>
                <field name="state" type="col"/>
                <field name="x_net_wage" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="hr_payslip_view_graph" model="ir.ui.view">
        <field name="name">hr.payslip.graph.ksw</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <graph string="Payslips" type="bar" sample="1">
                <field name="department_id"/>
                <field name="state"/>
                <field name="x_net_wage" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Payslip Line: pivot + graph (dashboard data source)           -->
    <!-- ============================================================ -->
    <record id="hr_payslip_line_view_pivot" model="ir.ui.view">
        <field name="name">hr.payslip.line.pivot.ksw</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <pivot string="Payslip Lines" sample="1">
                <field name="department_id" type="row"/>
                <field name="category_id" type="col"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="hr_payslip_line_view_graph" model="ir.ui.view">
        <field name="name">hr.payslip.line.graph.ksw</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">
            <graph string="Payslip Lines" type="bar" sample="1">
                <field name="department_id"/>
                <field name="category_id"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Payslip Search: hide Rejected (cancelled) slips by default    -->
    <!-- ============================================================ -->
    <!-- The filter sits behind its own <separator/> so it lands in a
         separate filter group and is AND:ed with Draft/Done instead of
         OR:ed with them (adjacent filters in one group are OR:ed). -->
    <record id="view_hr_payslip_filter_inherit_ksw" model="ir.ui.view">
        <field name="name">hr.payslip.select.inherit.ksw</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='done']" position="after">
                <separator/>
                <filter string="Hide Rejected"
                        name="hide_rejected"
                        domain="[('state', '!=', 'cancel')]"
                        help="Hide rejected / cancelled payslips"/>
            </xpath>
        </field>
    </record>

    <!-- Turn the filter on by default on every payslip list.
         om_hr_payroll's actions are NOT inside a noupdate block, so a plain
         <record> override is applied on every upgrade (pitfall #2). -->
    <record id="om_hr_payroll.action_view_hr_payslip_form" model="ir.actions.act_window">
        <field name="context">{'search_default_hide_rejected': 1}</field>
    </record>

    <record id="om_hr_payroll.act_hr_employee_payslip_list" model="ir.actions.act_window">
        <field name="context">{'search_default_employee_id': [active_id], 'default_employee_id': active_id, 'search_default_hide_rejected': 1}</field>
    </record>

</odoo>
