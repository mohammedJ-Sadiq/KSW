<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  ANNUAL VACATION COMBINED REPORT                             -->
    <!--  Model: hr.leave  (annual_multi leaves)                      -->
    <!--  Sections:                                                   -->
    <!--    1. Employee &amp; Leave Summary                           -->
    <!--    2. Approval Trail (5-step chain, chronological)           -->
    <!--    3. Financial Items (HR + Accounting inputs)               -->
    <!--    4. Vacation Payslip (inputs + salary computation)         -->
    <!--    5. Signature block                                        -->
    <!-- ============================================================ -->

    <template id="report_annual_vacation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- ── Title ── -->
                        <div class="text-center mb-4">
                            <h2 class="mb-1">Annual Vacation Report</h2>
                            <p class="text-muted" t-out="o.name or ''"/>
                        </div>

                        <!-- ══════════════════════════════════════════ -->
                        <!--  Section 1: Employee &amp; Leave Summary  -->
                        <!-- ══════════════════════════════════════════ -->
                        <!-- Fetch employee's annual-leave dashboard record (joining date)
                             and the most recent confirmed return from a prior leave. -->
                        <t t-set="_ksw_al" t-value="env['ksw.annual.leave'].sudo().search([('employee_id', '=', o.employee_id.id)], limit=1)"/>
                        <t t-set="_prev_leave" t-value="env['hr.leave'].sudo().search([('employee_id', '=', o.employee_id.id), ('holiday_status_id.is_annual_leave', '=', True), ('x_return_state', '=', 'hr_confirmed'), ('id', '!=', o.id)], order='x_return_date desc', limit=1)"/>

                        <h5 class="border-bottom pb-1 mb-2">Employee Information</h5>
                        <table class="table table-sm table-bordered mb-4">
                            <tr>
                                <td style="width:25%"><strong>Employee</strong></td>
                                <td style="width:25%" t-out="o.employee_id.name"/>
                                <td style="width:25%"><strong>Job Title</strong></td>
                                <td style="width:25%" t-out="o.employee_id.job_id.name or '—'"/>
                            </tr>
                            <tr>
                                <td><strong>Department</strong></td>
                                <td t-out="o.employee_id.department_id.name or '—'"/>
                                <td><strong>National / Iqama ID</strong></td>
                                <td t-out="o.employee_id.sudo().ssnid or o.employee_id.sudo().identification_id or '—'"/>
                            </tr>
                            <tr>
                                <td><strong>Company</strong></td>
                                <td t-out="o.employee_id.company_id.name or '—'"/>
                                <td><strong>Leave Manager</strong></td>
                                <td t-out="o.employee_id.leave_manager_id.name or '—'"/>
                            </tr>
                            <tr>
                                <td><strong>Joining Date</strong></td>
                                <td t-out="str(_ksw_al.joining_date) if _ksw_al and _ksw_al.joining_date else '—'"/>
                                <td><strong>Last Return Date</strong></td>
                                <td>
                                    <t t-if="_prev_leave and _prev_leave.x_return_date">
                                        <t t-out="str(_prev_leave.x_return_date)"/>
                                    </t>
                                    <t t-elif="_ksw_al and _ksw_al.x_effective_start_date">
                                        <t t-out="str(_ksw_al.x_effective_start_date)"/>
                                        <span class="text-muted ms-1" style="font-size:0.8em">(baseline)</span>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </table>

                        <h5 class="border-bottom pb-1 mb-2">Leave Request Details</h5>
                        <table class="table table-sm table-bordered mb-4">
                            <tr>
                                <td style="width:25%"><strong>Leave Type</strong></td>
                                <td style="width:25%" t-out="o.holiday_status_id.name or '—'"/>
                                <td style="width:25%"><strong>Overall Status</strong></td>
                                <td style="width:25%">
                                    <t t-if="o.x_annual_approval_state == 'approved'">
                                        <span class="fw-bold text-success">Approved</span>
                                    </t>
                                    <t t-elif="o.x_annual_approval_state">
                                        <t t-out="dict([('pending_dm','Pending DM Approval'),('pending_hr','Pending HR Approval'),('pending_gm_initial','Pending GM Initial'),('pending_acc','Pending Accounting'),('pending_gm_final','Pending GM Final'),('approved','Approved')]).get(o.x_annual_approval_state, o.x_annual_approval_state)"/>
                                    </t>
                                    <t t-else="">
                                        <t t-out="o.state or '—'"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Start Date</strong></td>
                                <td t-out="str(o.request_date_from) if o.request_date_from else '—'"/>
                                <td><strong>End Date</strong></td>
                                <td t-out="str(o.request_date_to) if o.request_date_to else '—'"/>
                            </tr>
                            <tr>
                                <td><strong>Calendar Days Away</strong></td>
                                <td>
                                    <t t-if="o.x_actual_vacation_days">
                                        <t t-out="'%.0f' % o.x_actual_vacation_days"/>
                                    </t>
                                    <t t-else="">
                                        <t t-out="'%.0f' % o.number_of_days if o.number_of_days else '—'"/>
                                    </t>
                                </td>
                                <td><strong>Balance Consumed (Days)</strong></td>
                                <td t-out="'%.2f' % o.number_of_days if o.number_of_days else '—'"/>
                            </tr>
                            <tr t-if="o.x_is_full_clearance">
                                <td><strong>Leave Nature</strong></td>
                                <td colspan="3" class="fw-bold text-danger">
                                    Full Balance Clearance
                                    <t t-if="o.x_clearance_balance"> — <t t-out="'%.2f' % o.x_clearance_balance"/> days consumed from balance</t>
                                </td>
                            </tr>
                            <tr t-if="o.x_excess_days_accepted and o.x_unpaid_portion_days > 0">
                                <td><strong>Leave Nature</strong></td>
                                <td colspan="3">
                                    <strong>Combined Leave</strong>
                                    — Annual portion: <t t-out="'%.2f' % o.x_annual_portion_days"/> days |
                                    Unpaid portion: <t t-out="'%.2f' % o.x_unpaid_portion_days"/> days
                                </td>
                            </tr>
                            <t t-if="o.x_return_state and o.x_return_state != 'not_applicable'">
                                <tr>
                                    <td><strong>Return Date</strong></td>
                                    <td t-out="str(o.x_return_date) if o.x_return_date else '—'"/>
                                    <td><strong>Return Status</strong></td>
                                    <td>
                                        <t t-if="o.x_return_state == 'hr_confirmed'">
                                            <span class="fw-bold text-success">Confirmed</span>
                                            <t t-if="o.x_manager_return_confirmed_by"> by <t t-out="o.x_manager_return_confirmed_by.name"/></t>
                                        </t>
                                        <t t-else="">On Vacation</t>
                                    </td>
                                </tr>
                            </t>
                        </table>

                        <!-- ══════════════════════════════════════════ -->
                        <!--  Section 3: Financial Items               -->
                        <!-- ══════════════════════════════════════════ -->
                        <t t-set="has_financials" t-value="
                            o.x_penalty_amount or
                            o.x_flight_ticket_amount or
                            o.x_additional_commissions or
                            o.x_remaining_loans or
                            o.x_other_deductions
                        "/>
                        <t t-if="has_financials">
                            <h5 class="border-bottom pb-1 mb-2">Financial Items</h5>
                            <table class="table table-sm table-bordered mb-4">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:35%">Item</th>
                                        <th style="width:15%" class="text-end">Amount (SAR)</th>
                                        <th style="width:50%">Notes / Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- HR items -->
                                    <tr t-if="o.x_penalty_amount">
                                        <td>Penalty Deduction</td>
                                        <td class="text-end text-danger fw-bold"
                                            t-out="'%.2f' % o.x_penalty_amount"/>
                                        <td t-out="o.x_penalty_description or ''"/>
                                    </tr>
                                    <tr t-if="o.x_flight_ticket_amount">
                                        <td>Flight Ticket Allowance</td>
                                        <td class="text-end text-success fw-bold"
                                            t-out="'%.2f' % o.x_flight_ticket_amount"/>
                                        <td t-out="o.x_flight_ticket_description or ''"/>
                                    </tr>
                                    <!-- Accounting items: commissions detail -->
                                    <t t-if="o.x_commission_line_ids">
                                        <tr t-foreach="o.x_commission_line_ids" t-as="cl">
                                            <td>Commission — <t t-out="cl.name"/></td>
                                            <td class="text-end text-success"
                                                t-out="'%.2f' % cl.amount"/>
                                            <td/>
                                        </tr>
                                    </t>
                                    <!-- Accounting items: remaining loans -->
                                    <tr t-if="o.x_remaining_loans">
                                        <td>Remaining Loans</td>
                                        <td class="text-end text-danger fw-bold"
                                            t-out="'%.2f' % o.x_remaining_loans"/>
                                        <td t-out="o.x_remaining_loans_description or ''"/>
                                    </tr>
                                    <!-- Accounting items: other deductions detail -->
                                    <t t-if="o.x_deduction_line_ids">
                                        <tr t-foreach="o.x_deduction_line_ids" t-as="dl">
                                            <td>Other Deduction — <t t-out="dl.name"/></td>
                                            <td class="text-end text-danger"
                                                t-out="'%.2f' % dl.amount"/>
                                            <td/>
                                        </tr>
                                    </t>
                                    <!-- Total of all payslip-impacting inputs (iqama excluded).
                                         Penalty, Remaining Loans and Other Deductions are stored
                                         positive but the salary rules negate them, so we subtract
                                         them here to match payslip impact. -->
                                    <t t-set="x_total_additional"
                                       t-value="(o.x_flight_ticket_amount or 0.0) + (o.x_additional_commissions or 0.0) - (o.x_penalty_amount or 0.0) - (o.x_remaining_loans or 0.0) - (o.x_other_deductions or 0.0)"/>
                                    <tr t-if="x_total_additional != 0" class="fw-bold table-info">
                                        <td>Total Additional Inputs</td>
                                        <td t-att-class="'text-end ' + ('text-danger' if x_total_additional &lt; 0 else 'text-success')"
                                            t-out="'%.2f' % x_total_additional"/>
                                        <td/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- ══════════════════════════════════════════ -->
                        <!--  Section 4: End-of-Service Data           -->
                        <!-- ══════════════════════════════════════════ -->
                        <t t-if="o.x_eos_service_years or o.x_eos_last_wage">
                            <h5 class="border-bottom pb-1 mb-2">End-of-Service Data (Saudi Art. 84–88)</h5>
                            <table class="table table-sm table-bordered mb-4">
                                <tbody>
                                    <tr>
                                        <td style="width:50%"><strong>Service Years</strong></td>
                                        <td t-out="'%.2f' % (o.x_eos_service_years or 0.0)"/>
                                    </tr>
                                    <tr>
                                        <td><strong>Last Wage (SAR)</strong></td>
                                        <td t-out="'%.2f' % (o.x_eos_last_wage or 0.0)"/>
                                    </tr>
                                    <tr>
                                        <td><strong>EOS — Termination (Art. 84)</strong></td>
                                        <td class="fw-bold" t-out="'%.2f' % (o.x_eos_termination_amount or 0.0)"/>
                                    </tr>
                                    <tr>
                                        <td><strong>EOS — Resignation (Art. 85)</strong></td>
                                        <td class="fw-bold" t-out="'%.2f' % (o.x_eos_resignation_amount or 0.0)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- ══════════════════════════════════════════ -->
                        <!--  Section 5: Vacation Payslip              -->
                        <!-- ══════════════════════════════════════════ -->
                        <!-- Skip cancelled runs, and never print a provisional
                             (draft mid-chain) calculation once the definitive
                             payslip exists. -->
                        <t t-set="_vac_payslips"
                           t-value="o.sudo().x_vacation_payslip_ids.filtered(lambda p: p.state != 'cancel')"/>
                        <t t-set="_final_payslips"
                           t-value="_vac_payslips.filtered(lambda p: not p.x_is_vacation_preview)"/>
                        <t t-set="_vac_payslips" t-value="_final_payslips or _vac_payslips"/>
                        <t t-set="payslip" t-value="_vac_payslips[0] if _vac_payslips else False"/>
                        <t t-set="requester_name"
                           t-value="o.employee_id.name if (o.sudo().create_uid == o.employee_id.user_id or not o.employee_id.leave_manager_id) else o.sudo().create_uid.name"/>

                        <t t-if="payslip">

                            <div style="page-break-before: always"/>

                            <!-- Payslip title + meta -->
                            <h5 class="border-bottom pb-1 mb-2">Vacation Payslip</h5>
                            <table class="table table-sm table-bordered mb-4">
                                <tr>
                                    <td style="width:25%"><strong>Payslip Name</strong></td>
                                    <td style="width:25%" t-out="payslip.name or '—'"/>
                                    <td style="width:25%"><strong>Reference</strong></td>
                                    <td style="width:25%" t-out="payslip.number or '—'"/>
                                </tr>
                                <tr>
                                    <td><strong>Period</strong></td>
                                    <td>
                                        <span t-field="payslip.date_from"/> –
                                        <span t-field="payslip.date_to"/>
                                    </td>
                                    <td><strong>Status</strong></td>
                                    <td>
                                        <t t-out="dict([('draft','Draft'),('verify','Waiting'),('done','Done'),('cancel','Cancelled')]).get(payslip.state, payslip.state)"/>
                                    </td>
                                </tr>
                            </table>

                            <!-- Salary Computation and Signatures are wrapped together so
                                 wkhtmltopdf keeps them on the same page when possible. -->
                            <t t-set="_att_ded_wd" t-value="payslip.worked_days_line_ids.filtered(lambda w: w.code == 'ATT_DED')"/>
                            <div style="page-break-inside: avoid">
                                <h6 class="mt-3 mb-1 fw-bold">Salary Computation</h6>
                                <table class="table table-sm table-bordered mb-4">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Description</th>
                                            <th>Code</th>
                                            <th class="text-end">Amount (SAR)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="payslip.line_ids.filtered(lambda l: l.appears_on_payslip).sorted('sequence')"
                                           t-as="line">
                                            <tr t-attf-class="#{'table-success fw-bold' if line.code == 'NET' else 'table-danger' if line.total &lt; 0 else 'fw-bold' if line.code in ('BASIC','GROSS') else 'text-muted' if line.total == 0 else ''}">
                                                <td>
                                                    <t t-out="line.name"/>
                                                    <t t-if="line.code == 'ATTDED' and _att_ded_wd and _att_ded_wd.number_of_days">
                                                        <span class="text-muted ms-1">(<t t-out="'%.0f' % _att_ded_wd.number_of_days"/> days)</span>
                                                    </t>
                                                </td>
                                                <td t-out="line.code"/>
                                                <td class="text-end" t-out="'%.2f' % line.total"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

                                <!-- ══════════════════════════════════════════ -->
                                <!--  Signature Block                           -->
                                <!-- ══════════════════════════════════════════ -->
                                <div class="row mt-4 pt-2 text-center">
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>Accountant</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>Accounting Manager</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>HR Manager</strong>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-5 pt-3 text-center">
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>General Manager</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>Applicant</strong><br/>
                                            <span t-out="requester_name"/>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>Document Upload Confirmation</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </t>
                        <t t-else="">
                            <!-- No-payslip warning and Signatures wrapped together so they
                                 never appear alone on a blank page. -->
                            <div style="page-break-inside: avoid">
                                <div class="alert alert-warning mt-3 mb-4">
                                    <strong>Vacation payslip not yet generated.</strong>
                                    The payslip is created automatically upon GM Final Approval.
                                </div>

                                <!-- ══════════════════════════════════════════ -->
                                <!--  Signature Block                           -->
                                <!-- ══════════════════════════════════════════ -->
                                <div class="row mt-4 pt-2 text-center">
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>Accountant</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>Accounting Manager</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>HR Manager</strong>
                                        </div>
                                    </div>
                                </div>
                                <div class="row mt-5 pt-3 text-center">
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>General Manager</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>Applicant</strong><br/>
                                            <span t-out="requester_name"/>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border-top: 1px solid #000; margin: 0 1rem; padding-top: 4px;">
                                            <strong>Document Upload Confirmation</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!--  Report action — bound to hr.leave                           -->
    <!-- ============================================================ -->
    <record id="action_report_annual_vacation" model="ir.actions.report">
        <field name="name">Annual Vacation Report</field>
        <field name="model">hr.leave</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">KSW_payroll.report_annual_vacation</field>
        <field name="report_file">KSW_payroll.report_annual_vacation</field>
        <field name="print_report_name">('Annual Vacation Report - %s' % (object.employee_id.name))</field>
        <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
