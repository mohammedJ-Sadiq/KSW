#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/ksw_payslip_revision_request.py:0
msgid "%(amount).2f SAR handed over by %(user)s."
msgstr "سلم %(user)s مبلغ %(amount).2f ريال."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/ksw_payslip_revision_request.py:0
msgid ""
"%(amount).2f SAR has been approved. Please collect it from the disbursement "
"officer; the request is closed once the handover is confirmed."
msgstr ""
"تم اعتماد مبلغ %(amount).2f ريال. يرجى استلامه من مسؤول الصرف؛ ويغلق الطلب "
"بعد تأكيد التسليم."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/ksw_payslip_revision_request.py:0
msgid ""
"%(amount).2f SAR paid by bank transfer in bank file %(file)s, generated by "
"%(user)s."
msgstr ""
"تم دفع %(amount).2f ريال بتحويل بنكي في ملف البنك %(file)s، الذي أنشأه "
"%(user)s."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/ksw_payslip_revision_request.py:0
msgid ""
"%(amount).2f SAR was paid by %(method)s for the period %(date_from)s → "
"%(date_to)s."
msgstr ""
"تم دفع %(amount).2f ريال عن طريق %(method)s للفترة %(date_from)s ← "
"%(date_to)s."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/payslip_bank_freeze.py:0
msgid ""
"%(emp)s: the payslip is no longer a draft, so the change cannot be applied. "
"Use a Payslip Revision."
msgstr ""
"%(emp)s: كشف الراتب لم يعد مسودة، لذا لا يمكن تطبيق التغيير. استخدم تعديل "
"كشف الراتب."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/hr_payslip_run_journal.py:0
msgid ""
"%(employee)s's payslip nets %(net).2f but the journal entry would post %(posted).2f. A salary rule with an amount on this payslip has no BAS posting configured, so its figure is missing from the entry.\n"
"\n"
"Unmapped rules on this batch: %(rules)s\n"
"\n"
"Set the BAS Posting and account on each of them (Payroll ▸ Configuration ▸ Salary Rules) and export again."
msgstr ""
"صافي كشف راتب %(employee)s هو %(net).2f بينما سيرحل القيد %(posted).2f. توجد قاعدة راتب لها مبلغ في كشف الراتب هذا دون إعداد ترحيل BAS، لذا فإن مبلغها مفقود من القيد.\n"
"\n"
"القواعد غير المربوطة في هذه الدفعة: %(rules)s\n"
"\n"
"حدد ترحيل BAS والحساب لكل منها (الرواتب ▸ الإعدادات ▸ قواعد الرواتب) ثم صدر مرة أخرى."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/hr_payslip_run.py:0
msgid ""
"%(n)s confirmed payslip(s) now carry the bank account they were paid from. "
"Changing an employee's salary account will no longer move them to another "
"bank file."
msgstr ""
"%(n)s كشف راتب معتمد يحمل الآن الحساب البنكي الذي دفع منه. تغيير حساب راتب "
"الموظف لن ينقلها بعد الآن إلى ملف بنك آخر."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/payslip_bank_freeze.py:0
msgid "%(n)s payslip(s) sent to the bank and frozen"
msgstr "%(n)s كشف راتب أرسل إلى البنك وجمد"

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/payslip_bank_freeze.py:0
msgid ""
"%(n)s payslip(s) were already sent to the bank, so the change was not "
"applied. It is waiting under Pending Changes on the batch for a Payroll "
"Manager."
msgstr ""
"%(n)s كشف راتب أرسل إلى البنك بالفعل، لذا لم يطبق التغيير. وهو بانتظار مدير "
"الرواتب ضمن التغييرات المعلقة في الدفعة."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/ksw_payslip_revision_request.py:0
msgid "%(name)s generated by %(user)s."
msgstr "أنشأ %(user)s الملف %(name)s."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/ksw_bas_journal.py:0
msgid ""
"%(name)s has an installment settled in this period but no \"Loan Acc No. in "
"Bas\" on his employee record, so the repayment has no account to be credited"
" to."
msgstr ""
"لدى %(name)s قسط مسدد في هذه الفترة لكن دون \"رقم حساب القرض في BAS\" في سجل"
" الموظف، لذا لا يوجد حساب يقيد له السداد."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/attendance_sheet.py:0
msgid ""
"%(period)s has already been paid (payslip %(slip)s is confirmed), so its "
"attendance can no longer be withdrawn. Ask HR — correcting a paid month is a"
" payslip revision."
msgstr ""
"تم دفع %(period)s بالفعل (كشف الراتب %(slip)s معتمد)، لذا لم يعد من الممكن "
"سحب الحضور والانصراف الخاص به. راجع الموارد البشرية — تصحيح شهر مدفوع يتم "
"عبر تعديل كشف الراتب."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/hr_payslip_run.py:0
msgid "%(reason)s Payslip %(slip)s cancelled."
msgstr "%(reason)s تم إلغاء كشف الراتب %(slip)s."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/payslip_bank_freeze.py:0
msgid ""
"%(reason)s Payslip %(slip)s was already sent to the bank, so it was kept: "
"this month is paid twice and must be recovered."
msgstr ""
"%(reason)s كشف الراتب %(slip)s أرسل إلى البنك بالفعل، لذا تم الإبقاء عليه: "
"هذا الشهر مدفوع مرتين ويجب استرداده."

#. module: KSW_payroll
#. odoo-python
#: code:addons/KSW_payroll/models/hr_payslip.py:0
msgid "%s has no Work Email address, so there is nowhere to send the payslip."
msgstr ""
"لا يوجد لدى %s بريد إلكتروني للعمل، لذا لا توجد جهة لإرسال كشف الراتب إليها."

#. module: KSW_payroll
#: model:ir.actions.report,print_report_name:KSW_payroll.action_report_annual_vacation
msgid "('Annual Vacation Report - %s' % (object.employee_id.name))"
msgstr "('تقرير الإجازة السنوية - %s' % (object.employee_id.name))"

#. module: KSW_payroll
#: model:ir.model.fields,help:KSW_payroll.field_hr_payslip__x_daily_wage
msgid ""
"(Wage + DA + Travel + Meal + Medical + Other) divided by the number of days "
"in the payslip month. Excludes housing allowance (HRA)."
msgstr ""
"(الراتب + بدل الغلاء + السفر + الوجبة + الطبي + أخرى) مقسوماً على عدد أيام "
"شهر قسيمة الراتب. يستثني بدل السكن."

#. module: KSW_payroll
#: model:ir.model.fields,help:KSW_payroll.field_ksw_payslip_revision_request__revision_state
msgid ""
"* When the payslip is created the status is 'Draft'\n"
"                \n"
"* If the payslip is under verification, the status is 'Waiting'.\n"
"                \n"
"* If the payslip is confirmed then status is set to 'Done'.\n"
"                \n"
"* When user cancel payslip the status is 'Rejected'."
msgstr ""
"* عند إنشاء كشف الراتب تكون الحالة 'مسودة'\n"
"                \n"
"* إذا كان كشف الراتب قيد التحقق، تكون الحالة 'بالانتظار'.\n"
"                \n"
"* إذا تم اعتماد كشف الراتب تصبح الحالة 'منتهي'.\n"
"                \n"
"* عندما يلغي المستخدم كشف الراتب تكون الحالة 'مرفوض'."

#. module: KSW_payroll
#: model_terms:ir.ui.view,arch_db:KSW_payroll.view_hr_salary_rule_form_bas
msgid "3201010006"
msgstr ""

#. module: KSW_payroll
#: model_terms:ir.ui.view,arch_db:KSW_payroll.hr_payslip_run_form_inherit_ksw
msgid ""
"<b>Skipped</b> employees got no payslip at all — resolve\n"
"                    the issue shown and re-generate to include them.\n"
"                    Employees marked <b>Processed</b> DO have a payslip, but\n"
"                    their attendance was never sent to payroll, so it was\n"
"                    computed as zero attendance. Ask the supervisor to\n"
"                    confirm the sheet, then recompute those payslips."
msgstr ""
"الموظفون <b>المستبعدون</b> لم يصدر لهم كشف راتب إطلاقا — عالج\n"
"                    المشكلة الظاهرة ثم أعد الإنشاء لتضمينهم.\n"
"                    الموظفون الموسومون <b>تمت المعالجة</b> لديهم كشف راتب، لكن\n"
"                    حضورهم لم يرسل إلى الرواتب، فاحتسب\n"
"                    بحضور صفري. اطلب من المشرف\n"
"                    اعتماد الكشف، ثم أعد احتساب كشوف الراتب تلك."

#. module: KSW_payroll
#: model:mail.template,body_html:KSW_payroll.mail_template_payslip_auto
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Dear <t t-out=\"object.employee_id.name or ''\"/>,</p>\n"
"                    <p>Please find the attached payslip for the period: <t t-out=\"object.date_from\"/> - <t t-out=\"object.date_to\"/></p>\n"
"                    <p>In case of any queries concerning this matter, do not hesitate to contact our HR department.</p>\n"
"                    <br/>\n"
"                    Best Regards,\n"
"                    <br/>\n"
"                    <t t-out=\"user.name\"/>\n"
"                    <br/>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>عزيزي <t t-out=\"object.employee_id.name or ''\"/>,</p>\n"
"                    <p>يرجى الاطلاع على قسيمة الراتب المرفقة للفترة: <t t-out=\"object.date_from\"/> - <t t-out=\"object.date_to\"/></p>\n"
"                    <p>في حال وجود أي استفسارات، لا تتردد في التواصل مع قسم الموارد البشرية.</p>\n"
"                    <br/>\n"
"                    مع التحيات،\n"
"                    <br/>\n"
"                    <t t-out=\"user.name\"/>\n"
"                    <br/>\n"
"                </div>\n"
"            "

