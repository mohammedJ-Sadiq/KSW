<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ksw_payslip_run_done_wizard_form" model="ir.ui.view">
        <field name="name">ksw.payslip.run.done.wizard.form</field>
        <field name="model">ksw.payslip.run.done.wizard</field>
        <field name="arch" type="xml">
            <form string="Mark As Done">
                <field name="run_id" invisible="1"/>
                <p class="text-muted">
                    Tick the bank accounts whose payslips are paid. The rest stay in draft,
                    and the batch is marked done once every account is.
                </p>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="label"/>
                        <field name="slip_count" sum="Total"/>
                        <field name="total_net" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Mark As Done"
                            class="btn-primary"/>
                    <button special="cancel" string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
