#. module: KSW_fleet_package
#. odoo-python
#: code:addons/KSW_fleet_package/models/fleet_package.py:0
msgid "%s already belongs to that department."
msgstr "%s تابعة أصلاً لذلك القسم."

#. module: KSW_fleet_package
#. odoo-python
#: code:addons/KSW_fleet_package/models/fleet_package.py:0
msgid "%s has already been decided."
msgstr "تم البت في %s مسبقاً."

#. module: KSW_fleet_package
#. odoo-python
#: code:addons/KSW_fleet_package/models/fleet_package.py:0
msgid ""
"%s has no custodian to move with it. Release it without its driver, or have "
"HR record its custodian first."
msgstr ""
"لا يوجد صاحب عهدة لـ %s لينتقل معها. استغنِ عنها بدون سائقها، أو اطلب من "
"الموارد البشرية تسجيل صاحب عهدتها أولاً."

#. module: KSW_fleet_package
#. odoo-python
#: code:addons/KSW_fleet_package/models/fleet_package.py:0
msgid ""
"<b>%(v)s</b> moved to <b>%(d)s</b> together with their drivers (%(e)s), "
"effective today. For your action if any: delegation (HR), financial matters "
"(Accounting)."
msgstr ""
"نُقلت <b>%(v)s</b> إلى <b>%(d)s</b> مع سائقيها (%(e)s) اعتباراً من اليوم. "
"لاتخاذ اللازم إن وجد: التفويض (الموارد البشرية)، المتعلقات المالية "
"(الحسابات)."

#. module: KSW_fleet_package
#. odoo-python
#: code:addons/KSW_fleet_package/models/fleet_package.py:0
msgid ""
"A vehicle released with its driver is transferred with him or kept, not sent"
" to the workshop: %s."
msgstr ""
"المركبة المستغنى عنها مع سائقها تُنقل معه أو تبقى، ولا تُرسل إلى الورشة: %s."

#. module: KSW_fleet_package
#. odoo-python
#: code:addons/KSW_fleet_package/models/fleet_package.py:0
msgid "Choose the department that receives them."
msgstr "اختر القسم المستلم."

#. module: KSW_fleet_package
#: model:ir.model,name:KSW_fleet_package.model_ksw_fleet_release_decision_wizard
msgid "Decide Released Vehicles"
msgstr "البت في المركبات المستغنى عنها"

