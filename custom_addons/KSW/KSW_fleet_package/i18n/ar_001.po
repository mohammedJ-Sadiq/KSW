#. module: KSW_fleet_package
#. odoo-python
#: code:addons/KSW_fleet_package/models/fleet_package.py:0
msgid "Only the GM decides a release."
msgstr "المدير العام وحده يبت في الاستغناء."

#. module: KSW_fleet_package
#: model:ir.model.fields,help:KSW_fleet_package.field_ksw_fleet_release_line__x_with_driver
msgid ""
"The vehicle moves together with the employee who answers for it: no "
"workshop, no handover form, and he is transferred too."
msgstr ""
"تنتقل المركبة مع صاحب عهدتها: بلا ورشة ولا نموذج تسليم، ويُنقل هو أيضاً."

