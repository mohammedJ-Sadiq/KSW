<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Plain strings, no reference to the owning modules: a counter whose model
         is not installed is skipped at count time. noupdate so an admin's edits stay. -->
    <record id="inbox_leave_approvals" model="ksw.home.inbox.source">
        <field name="name">Time off awaiting my approval</field>
        <field name="sequence">10</field>
        <field name="model_name">hr.leave</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-plane</field>
    </record>
    <record id="inbox_deductions" model="ksw.home.inbox.source">
        <field name="name">Loans and deductions awaiting my action</field>
        <field name="sequence">20</field>
        <field name="model_name">ksw.deduction</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-money</field>
    </record>
    <record id="inbox_revisions" model="ksw.home.inbox.source">
        <field name="name">Salary revisions awaiting my action</field>
        <field name="sequence">30</field>
        <field name="model_name">ksw.payslip.revision.request</field>
        <field name="domain">[('is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-pencil-square-o</field>
    </record>
    <!-- Commissions (Nov 2026): Accounting checks a handover before the GM
         approves it, so both steps are someone's — the model decides whose.
         Existing databases get these from KSW_commissions' 19.0.4.60.0
         end-migrate (same xml ids), since this file is noupdate. -->
    <record id="inbox_commission_submissions" model="ksw.home.inbox.source">
        <field name="name">Commission submissions to check or approve</field>
        <field name="sequence">40</field>
        <field name="model_name">ksw.pay.submission</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-check-square-o</field>
    </record>
    <record id="inbox_commission_sub_batches" model="ksw.home.inbox.source">
        <field name="name">Commission sub-batches to check or approve</field>
        <field name="sequence">41</field>
        <field name="model_name">ksw.pay.sub.batch</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-scissors</field>
    </record>
    <record id="inbox_purchase_requests" model="ksw.home.inbox.source">
        <field name="name">Purchase requests to approve</field>
        <field name="sequence">50</field>
        <field name="model_name">purchase.request</field>
        <field name="domain">[('state', '=', 'to_approve'), ('assigned_to', '=', uid)]</field>
        <field name="icon">fa-shopping-cart</field>
    </record>
    <record id="inbox_helpdesk_tickets" model="ksw.home.inbox.source">
        <field name="name">Open tickets assigned to me</field>
        <field name="sequence">60</field>
        <field name="model_name">helpdesk.ticket</field>
        <field name="domain">[('user_id', '=', uid), ('stage_id.fold', '=', False)]</field>
        <field name="icon">fa-life-ring</field>
    </record>
    <!-- Vehicles and drivers (Nov 2026): every step a person takes in Vehicle
         Allocation, Vehicle Custody and Employee Transfer, each model's own
         x_is_pending_my_action deciding what is whose. -->
    <record id="inbox_vehicle_requests" model="ksw.home.inbox.source">
        <field name="name">Vehicle requests awaiting my review or decision</field>
        <field name="sequence">70</field>
        <field name="model_name">ksw.fleet.request</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-exchange</field>
    </record>
    <record id="inbox_vehicles_to_receive" model="ksw.home.inbox.source">
        <field name="name">Vehicles on their way to my department</field>
        <field name="sequence">71</field>
        <field name="model_name">ksw.fleet.move</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-truck</field>
    </record>
    <record id="inbox_vehicle_handover_forms" model="ksw.home.inbox.source">
        <field name="name">Vehicle handover forms (HR-12) awaiting me</field>
        <field name="sequence">72</field>
        <field name="model_name">ksw.vehicle.custody.request</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-file-text-o</field>
    </record>
    <record id="inbox_employee_transfers" model="ksw.home.inbox.source">
        <field name="name">Employee transfers awaiting me</field>
        <field name="sequence">73</field>
        <field name="model_name">ksw.employee.transfer</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-users</field>
    </record>
    <!-- Documents register (Nov 2026): HR's documents to confirm or renew,
         and the vehicles and employees still missing some. -->
    <record id="inbox_documents" model="ksw.home.inbox.source">
        <field name="name">Documents to confirm, expiring or expired</field>
        <field name="sequence">80</field>
        <field name="model_name">ksw.document</field>
        <field name="domain">[('x_is_pending_my_action', '=', True)]</field>
        <field name="icon">fa-id-card-o</field>
    </record>
    <record id="inbox_vehicle_documents_missing" model="ksw.home.inbox.source">
        <field name="name">Vehicles missing documents</field>
        <field name="sequence">81</field>
        <field name="model_name">ksw.fleet.vehicle</field>
        <field name="domain">[('x_document_pending_my_action', '=', True)]</field>
        <field name="icon">fa-truck</field>
    </record>
    <record id="inbox_employee_documents_missing" model="ksw.home.inbox.source">
        <field name="name">Employees missing documents</field>
        <field name="sequence">82</field>
        <field name="model_name">hr.employee</field>
        <field name="domain">[('x_document_pending_my_action', '=', True)]</field>
        <field name="icon">fa-id-badge</field>
    </record>
</odoo>
