<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Loan Disbursement Officer hands out a settlement's cash: he must
         open the request it is waiting on, and only while it waits. Read only;
         the handover button writes through sudo() after its own check. -->
    <record id="hr_leave_rule_settlement_cash_officer" model="ir.rule">
        <field name="name">KSW Leave: settlement cash waiting for the disbursement officer</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('KSW_deduction.group_loan_disbursement'))]"/>
        <field name="domain_force">[('x_disb_state', '=', 'cash_pending')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
