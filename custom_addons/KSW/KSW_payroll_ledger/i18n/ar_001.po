#. module: KSW_payroll_ledger
#. odoo-python
#: code:addons/KSW_payroll_ledger/models/settlement_payment.py:0
msgid ""
"%(bank)s belongs to another entity than the one this settlement was booked "
"to."
msgstr "الحساب %(bank)s تابع لجهة غير الجهة التي قُيّدت عليها هذه التسوية."

#. module: KSW_payroll_ledger
#. odoo-python
#: code:addons/KSW_payroll_ledger/models/settlement_payment.py:0
msgid ""
"%(name)s has no bank account of his own to transfer to. Add it on his "
"employee record, or pay by cheque or cash."
msgstr ""
"لا يوجد حساب بنكي للموظف %(name)s للتحويل إليه. أضفه في ملف الموظف، أو اصرف "
"بشيك أو نقدًا."

#. module: KSW_payroll_ledger
#. odoo-python
#: code:addons/KSW_payroll_ledger/models/settlement_payment.py:0
msgid "%(name)s has no paying bank account."
msgstr "لا يوجد حساب بنكي للصرف للموظف %(name)s."

#. module: KSW_payroll_ledger
#. odoo-python
#: code:addons/KSW_payroll_ledger/models/hr_payslip_run.py:0
msgid ""
"%(name)s: posted to the suspense account %(acc)s, no posting map row for "
"some of his figures"
msgstr ""
"%(name)s: رُحِّل إلى الحساب المعلّق %(acc)s، لعدم وجود سطر توجيه لبعض بنوده"

#. module: KSW_payroll_ledger
#. odoo-python
#: code:addons/KSW_payroll_ledger/models/settlement_payment.py:0
msgid "%(slip)s: %(amt)s SAR in cash from %(box)s, %(done)s"
msgstr "%(slip)s: %(amt)s ريال نقدًا من %(box)s، %(done)s"

#. module: KSW_payroll_ledger
#. odoo-python
#: code:addons/KSW_payroll_ledger/models/settlement_payment.py:0
msgid ""
"%(slip)s: %(amt)s SAR to pay, waiting for accounting to choose bank file, "
"bank transfer, cheque or cash"
msgstr ""
"%(slip)s: %(amt)s ريال للصرف، بانتظار اختيار المحاسبة: ملف بنك الرواتب أو "
"تحويل بنكي أو شيك أو نقدًا"

#. module: KSW_payroll_ledger
#. odoo-python
#: code:addons/KSW_payroll_ledger/models/settlement_payment.py:0
msgid ""
"%(slip)s: %(amt)s SAR transferred from %(bank)s on %(date)s (ref. %(ref)s)"
msgstr ""
"%(slip)s: %(amt)s ريال حُوّلت من %(bank)s بتاريخ %(date)s (مرجع %(ref)s)"

#. module: KSW_payroll_ledger
#. odoo-python
#: code:addons/KSW_payroll_ledger/models/settlement_payment.py:0
msgid ""
"%(slip)s: cheque %(no)s on %(bank)s for %(amt)s SAR handed over on %(date)s,"
" %(cashed)s"
msgstr ""
"%(slip)s: الشيك رقم %(no)s على %(bank)s بمبلغ %(amt)s ريال سُلّم بتاريخ "
"%(date)s، %(cashed)s"

#. module: KSW_payroll_ledger
#. odoo-python
#: code:addons/KSW_payroll_ledger/models/posting.py:0
msgid ""
"%(what)s → %(to)s instead of %(default)s; the rest of his salary stays on "
"%(rest)s (%(group)s)"
msgstr ""
"%(what)s ← %(to)s بدلاً من %(default)s؛ وبقية راتبه تبقى على %(rest)s "
"(%(group)s)"

