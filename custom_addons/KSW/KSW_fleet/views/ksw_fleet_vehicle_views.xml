<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ksw_fleet_vehicle_list" model="ir.ui.view">
        <field name="name">ksw.fleet.vehicle.list</field>
        <field name="model">ksw.fleet.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles" decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="client_id" context="{'res_partner_search_mode': 'customer'}"/>
                <field name="vehicle_type"/>
                <field name="tank_number"/>
                <field name="plate_number"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="year"/>
                <field name="driver_name"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- The default kanban for vehicles. On a phone every vehicle picker
         (Workshop request, parts...) opens its select dialog in kanban, and
         without a view here Odoo borrowed the only one there was: the Water
         Delivery Tankers card, which shows tanker groups that a workshop
         requester may not read (AccessError on x_tanker_group_ids). Keep this
         card to fields every vehicle reader can see. The Tankers action binds
         its own card explicitly, so it is unaffected. -->
    <record id="view_ksw_fleet_vehicle_kanban" model="ir.ui.view">
        <field name="name">ksw.fleet.vehicle.kanban</field>
        <field name="model">ksw.fleet.vehicle</field>
        <field name="arch" type="xml">
            <kanban create="0">
                <templates>
                    <t t-name="card">
                        <span class="fw-bold"><field name="name"/></span>
                        <div class="small text-muted">
                            <field name="vehicle_type"/>
                            <t t-if="record.plate_number.raw_value"> · <field name="plate_number"/></t>
                            <t t-if="record.tank_number.raw_value"> · <field name="tank_number"/></t>
                        </div>
                        <div class="small" t-if="record.driver_name.raw_value">
                            <field name="driver_name"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ksw_fleet_vehicle_form" model="ir.ui.view">
        <field name="name">ksw.fleet.vehicle.form</field>
        <field name="model">ksw.fleet.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm"
                            class="oe_highlight"
                            groups="hr.group_hr_user"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <!-- res_partner_search_mode orders the picker by
                                 customer rank AND stamps customer_rank=1 on
                                 anything quick-created from it, so "client not
                                 in the list" needs no wizard. -->
                            <field name="client_id" context="{'res_partner_search_mode': 'customer'}"/>
                            <field name="vehicle_type"/>
                            <field name="tank_number"/>
                            <field name="plate_number"/>
                        </group>
                        <group string="Details">
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="year"/>
                            <field name="driver_id"/>
                            <field name="driver_name"/>
                        </group>
                    </group>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ksw_fleet_vehicle_search" model="ir.ui.view">
        <field name="name">ksw.fleet.vehicle.search</field>
        <field name="model">ksw.fleet.vehicle</field>
        <field name="arch" type="xml">
            <search string="Vehicles">
                <field name="name"/>
                <field name="client_id"/>
                <field name="plate_number"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <group>
                    <filter string="Client" name="groupby_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Vehicle Type" name="groupby_type" context="{'group_by': 'vehicle_type'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ksw_fleet_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">ksw.fleet.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ksw_fleet_vehicle_search"/>
    </record>

</odoo>
