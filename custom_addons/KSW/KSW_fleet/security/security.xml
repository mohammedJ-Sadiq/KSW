<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ksw_fleet" model="ir.module.category">
        <field name="name">KSW Fleet</field>
        <field name="sequence">205</field>
    </record>
    <record id="privilege_fleet_coupling" model="res.groups.privilege">
        <field name="name">Tedder Coupling</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_fleet"/>
    </record>
    <!-- Given to a named person: couples a tedder to a trailer head at once,
         no approval (user decision 2026-11-20). The tank licence is issued on
         the head, so this link is what puts a tedder under valid papers. -->
    <record id="group_tedder_coupling" model="res.groups">
        <field name="name">Couple Tedders to Heads</field>
        <field name="privilege_id" ref="privilege_fleet_coupling"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">10</field>
    </record>
    <!-- HR: keeps the tedders' own data (plate, chassis, tank no.) but not
         which head pulls them. Separate privilege, so it is its own setting
         and never a level of the coupling one. -->
    <record id="privilege_tedder_data" model="res.groups.privilege">
        <field name="name">Tedder Data</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_ksw_fleet"/>
    </record>
    <record id="group_tedder_editor" model="res.groups">
        <field name="name">Edit Tedder Data</field>
        <field name="privilege_id" ref="privilege_tedder_data"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">10</field>
    </record>
</odoo>
