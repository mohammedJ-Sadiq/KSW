<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_ksw_fleet_allocation" model="ir.module.category">
        <field name="name">KSW Vehicle Allocation</field>
        <field name="sequence">212</field>
    </record>

    <record id="privilege_fleet_allocation" model="res.groups.privilege">
        <field name="name">Vehicle Allocation</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_fleet_allocation"/>
    </record>

    <!-- Raises requests for, and receives vehicles into, the departments named
         on his user (Vehicle Departments). The group is the capability; the
         departments are the scope, read by the rules below. -->
    <record id="group_fleet_allocation_user" model="res.groups">
        <field name="name">Department User</field>
        <field name="privilege_id" ref="privilege_fleet_allocation"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="sequence">10</field>
    </record>

    <!-- Sees every department's requests and decides them. Implies the user
         tier so a single choice on the user form covers both (gotcha #200). -->
    <record id="group_fleet_allocation_gm" model="res.groups">
        <field name="name">General Manager</field>
        <field name="privilege_id" ref="privilege_fleet_allocation"/>
        <field name="implied_ids" eval="[(4, ref('group_fleet_allocation_user'))]"/>
        <field name="sequence">20</field>
    </record>

    <!-- Department users: their departments only. The GM rule is wider and
         ORs with this one for him. -->
    <record id="rule_ksw_fleet_request_user" model="ir.rule">
        <field name="name">Vehicle request: own departments</field>
        <field name="model_id" ref="model_ksw_fleet_request"/>
        <field name="domain_force">[('department_id', 'in', user._ksw_fleet_department_ids())]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_user'))]"/>
    </record>
    <record id="rule_ksw_fleet_request_gm" model="ir.rule">
        <field name="name">Vehicle request: GM and administrator see all</field>
        <field name="model_id" ref="model_ksw_fleet_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_gm')), (4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_ksw_fleet_release_line_user" model="ir.rule">
        <field name="name">Vehicle release line: own departments</field>
        <field name="model_id" ref="model_ksw_fleet_release_line"/>
        <field name="domain_force">[('request_id.department_id', 'in', user._ksw_fleet_department_ids())]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_user'))]"/>
    </record>
    <record id="rule_ksw_fleet_release_line_gm" model="ir.rule">
        <field name="name">Vehicle release line: GM and administrator see all</field>
        <field name="model_id" ref="model_ksw_fleet_release_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_gm')), (4, ref('base.group_system'))]"/>
    </record>

    <record id="rule_ksw_fleet_addition_line_user" model="ir.rule">
        <field name="name">Vehicle addition line: own departments</field>
        <field name="model_id" ref="model_ksw_fleet_addition_line"/>
        <field name="domain_force">[('request_id.department_id', 'in', user._ksw_fleet_department_ids())]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_user'))]"/>
    </record>
    <record id="rule_ksw_fleet_addition_line_gm" model="ir.rule">
        <field name="name">Vehicle addition line: GM and administrator see all</field>
        <field name="model_id" ref="model_ksw_fleet_addition_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_gm')), (4, ref('base.group_system'))]"/>
    </record>

    <!-- The receiving side of a transfer reads the release request that sends
         it the vehicle (reason, chatter, notification), read only. -->
    <record id="rule_ksw_fleet_request_user_incoming" model="ir.rule">
        <field name="name">Vehicle request: read releases sending vehicles to own departments</field>
        <field name="model_id" ref="model_ksw_fleet_request"/>
        <field name="domain_force">[('release_line_ids.target_department_id', 'in', user._ksw_fleet_department_ids())]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_ksw_fleet_release_line_user_incoming" model="ir.rule">
        <field name="name">Vehicle release line: read lines sending vehicles to own departments</field>
        <field name="model_id" ref="model_ksw_fleet_release_line"/>
        <field name="domain_force">[('target_department_id', 'in', user._ksw_fleet_department_ids())]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- A department the GM took a vehicle from without its releasing it
         reads the request that took it, read only: where the message about
         it is posted. -->
    <record id="rule_ksw_fleet_request_user_taken_from" model="ir.rule">
        <field name="name">Vehicle request: read requests that took a vehicle from own departments</field>
        <field name="model_id" ref="model_ksw_fleet_request"/>
        <field name="domain_force">[('move_ids.from_department_id', 'in', user._ksw_fleet_department_ids())]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_ksw_fleet_addition_line_user_taken_from" model="ir.rule">
        <field name="name">Vehicle addition line: read lines that took a vehicle from own departments</field>
        <field name="model_id" ref="model_ksw_fleet_addition_line"/>
        <field name="domain_force">[('move_ids.from_department_id', 'in', user._ksw_fleet_department_ids())]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- A department reads the movements into and out of it: its vehicles'
         history and the transfers it has to confirm. -->
    <record id="rule_ksw_fleet_move_user" model="ir.rule">
        <field name="name">Vehicle movement: into or out of own departments</field>
        <field name="model_id" ref="model_ksw_fleet_move"/>
        <field name="domain_force">['|', ('from_department_id', 'in', user._ksw_fleet_department_ids()), ('to_department_id', 'in', user._ksw_fleet_department_ids())]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_user'))]"/>
    </record>
    <record id="rule_ksw_fleet_move_gm" model="ir.rule">
        <field name="name">Vehicle movement: GM and administrator see all</field>
        <field name="model_id" ref="model_ksw_fleet_move"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_fleet_allocation_gm')), (4, ref('base.group_system'))]"/>
    </record>

</odoo>
