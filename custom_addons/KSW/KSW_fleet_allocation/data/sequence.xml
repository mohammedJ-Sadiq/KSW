<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_ksw_fleet_request" model="ir.sequence">
            <field name="name">Vehicle Allocation Request</field>
            <field name="code">ksw.fleet.request</field>
            <field name="prefix">VA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_ksw_vehicle_handover" model="ir.sequence">
            <field name="name">Vehicle Handover Form (HR-12)</field>
            <field name="code">ksw.vehicle.handover</field>
            <field name="prefix">HR12/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
