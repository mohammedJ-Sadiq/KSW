<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ksw_fleet_release_decision_wizard_form" model="ir.ui.view">
        <field name="name">ksw.fleet.release.decision.wizard.form</field>
        <field name="model">ksw.fleet.release.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Decide Released Vehicles">
                <field name="source_department_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="decision" widget="radio"/>
                    </group>
                    <group>
                        <field name="vehicle_types" readonly="1" string="Types"/>
                    </group>
                </group>
                <group invisible="decision != 'transfer'">
                    <field name="addition_line_id" options="{'no_create': True, 'no_open': True}"
                           required="decision == 'transfer'"/>
                    <div colspan="2" class="text-muted small">
                        A vehicle goes only to a department that asked for one, up to the number it
                        asked for, and only to a need it fits (with or without its driver).
                    </div>
                </group>
                <group invisible="decision != 'holding'">
                    <field name="workshop_description"/>
                </group>
                <!-- The vehicles this decision applies to. Remove a row to
                     leave that vehicle waiting and decide it another way. -->
                <separator string="Vehicles"/>
                <field name="release_line_ids" options="{'no_create': True}">
                    <list>
                        <field name="vehicle_id"/>
                        <field name="vehicle_type"/>
                        <field name="department_id" string="Released By"/>
                        <field name="request_id"/>
                        <field name="note"/>
                    </list>
                </field>
                <field name="note" required="decision == 'keep'"
                       placeholder="Note for the departments (required when keeping them: they asked to give them up)..."/>
                <separator string="Requests these vehicles can fill"
                           invisible="not demand_line_ids or decision != 'transfer'"/>
                <field name="demand_line_ids" readonly="1" invisible="not demand_line_ids or decision != 'transfer'">
                    <list>
                        <field name="request_id"/>
                        <field name="department_id"/>
                        <field name="vehicle_type"/>
                        <field name="need"/>
                        <field name="open_quantity" string="Still Needed"/>
                        <field name="note"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Decision" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
