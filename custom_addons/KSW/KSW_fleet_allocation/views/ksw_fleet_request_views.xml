<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ksw_fleet_request_list" model="ir.ui.view">
        <field name="name">ksw.fleet.request.list</field>
        <field name="model">ksw.fleet.request</field>
        <field name="arch" type="xml">
            <list string="Vehicle Requests" decoration-muted="state in ('done', 'cancelled')"
                  decoration-info="state == 'submitted'">
                <field name="name"/>
                <field name="request_type" widget="badge"
                       decoration-warning="request_type == 'release'"
                       decoration-success="request_type == 'addition'"/>
                <field name="department_id"/>
                <field name="line_summary"/>
                <field name="open_line_count"/>
                <field name="user_id" optional="show"/>
                <field name="submitted_date" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_ksw_fleet_request_kanban" model="ir.ui.view">
        <field name="name">ksw.fleet.request.kanban</field>
        <field name="model">ksw.fleet.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile" quick_create="0" group_create="0"
                    group_delete="0" records_draggable="0">
                <field name="state"/>
                <field name="request_type"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="request_type" widget="badge"
                                   decoration-warning="request_type == 'release'"
                                   decoration-success="request_type == 'addition'"/>
                        </div>
                        <field name="department_id" class="text-muted"/>
                        <field name="line_summary" class="small"/>
                        <div class="d-flex justify-content-between mt-1">
                            <span class="small text-muted" invisible="not open_line_count">
                                <field name="open_line_count"/> undecided
                            </span>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ksw_fleet_request_form" model="ir.ui.view">
        <field name="name">ksw.fleet.request.form</field>
        <field name="model">ksw.fleet.request</field>
        <field name="arch" type="xml">
            <form string="Vehicle Request">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="open_line_count" invisible="1"/>
                    <button name="action_decide_release_lines" type="object" string="Decide Vehicles"
                            class="oe_highlight" icon="fa-gavel"
                            groups="KSW_fleet_allocation.group_fleet_allocation_gm"
                            invisible="state != 'submitted' or request_type != 'release' or not open_line_count"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'submitted')"
                            confirm="Cancel this request?"/>
                    <button name="action_reset_draft" type="object" string="Back to Draft"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="x_is_gm" invisible="1"/>
                    <field name="allowed_department_ids" invisible="1"/>
                    <group>
                        <group>
                            <field name="request_type" widget="radio" readonly="state != 'draft'"/>
                            <field name="department_id" options="{'no_create': True, 'no_open': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="submitted_date" invisible="not submitted_date"/>
                        </group>
                    </group>
                    <field name="reason" readonly="state != 'draft'"
                           placeholder="Why these vehicles are not needed / what the extra vehicles are for..."/>
                    <notebook>
                        <page name="release" string="Vehicles to Release" invisible="request_type != 'release'">
                            <field name="release_line_ids" readonly="state != 'draft'"
>
                                <list editable="bottom" decoration-muted="status in ('kept', 'cancelled')"
                                      decoration-success="status in ('transferred', 'holding')"
                                      decoration-info="status == 'in_transfer'">
                                    <field name="department_id" column_invisible="True"/>
                                    <field name="vehicle_id" options="{'no_create': True}"/>
                                    <field name="vehicle_type"/>
                                    <field name="plate_number" optional="show"/>
                                    <field name="driver_name" optional="show"/>
                                    <field name="note"/>
                                    <field name="status" widget="badge" readonly="1"/>
                                    <field name="target_department_id" readonly="1" optional="show"/>
                                    <field name="decision_note" readonly="1" optional="hide"/>
                                    <field name="request_state" column_invisible="True"/>
                                    <button name="action_open_decision" type="object" string="Decide"
                                            class="btn-primary" icon="fa-gavel"
                                            groups="KSW_fleet_allocation.group_fleet_allocation_gm"
                                            invisible="status != 'pending' or request_state != 'submitted'"/>
                                </list>
                            </field>
                        </page>
                        <page name="addition" string="Vehicles Needed" invisible="request_type != 'addition'">
                            <field name="addition_line_ids" readonly="state != 'draft'"
>
                                <list editable="bottom" decoration-muted="status in ('refused', 'cancelled')"
                                      decoration-success="status == 'done'"
                                      decoration-info="status in ('in_transfer', 'waiting_external')">
                                    <field name="vehicle_type"/>
                                    <field name="quantity"/>
                                    <field name="note"/>
                                    <field name="internal_quantity" readonly="1" optional="show"/>
                                    <field name="external_quantity" readonly="1" optional="show"/>
                                    <field name="external_received_quantity" readonly="1" optional="hide"/>
                                    <field name="refused_quantity" readonly="1" optional="show"/>
                                    <field name="open_quantity" readonly="1"/>
                                    <field name="status" widget="badge" readonly="1"/>
                                    <field name="request_state" column_invisible="True"/>
                                    <button name="action_open_decision" type="object" string="Decide"
                                            class="btn-primary" icon="fa-gavel"
                                            groups="KSW_fleet_allocation.group_fleet_allocation_gm"
                                            invisible="request_state != 'submitted' or status not in ('pending', 'waiting_external')"/>
                                </list>
                            </field>
                        </page>
                        <page name="moves" string="Movements" invisible="not move_ids">
                            <field name="move_ids" readonly="1">
                                <list>
                                    <field name="vehicle_id"/>
                                    <field name="kind"/>
                                    <field name="from_department_id"/>
                                    <field name="to_department_id"/>
                                    <field name="source" optional="hide"/>
                                    <field name="date"/>
                                    <field name="received_date"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'in_transfer'"
                                           decoration-success="state == 'done'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ksw_fleet_request_search" model="ir.ui.view">
        <field name="name">ksw.fleet.request.search</field>
        <field name="model">ksw.fleet.request</field>
        <field name="arch" type="xml">
            <search string="Vehicle Requests">
                <field name="name"/>
                <field name="department_id"/>
                <field name="release_line_ids" string="Vehicle" filter_domain="[('release_line_ids.vehicle_id.name', 'ilike', self)]"/>
                <filter string="Open" name="filter_open" domain="[('state', 'in', ('draft', 'submitted'))]"/>
                <filter string="Waiting for GM" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Closed" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Releases" name="filter_release" domain="[('request_type', '=', 'release')]"/>
                <filter string="Additions" name="filter_addition" domain="[('request_type', '=', 'addition')]"/>
                <group>
                    <filter string="Department" name="groupby_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Request" name="groupby_type" context="{'group_by': 'request_type'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ksw_fleet_request" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">ksw.fleet.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_ksw_fleet_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Release vehicles you no longer need, or ask for more</p>
            <p>The GM decides each request: a released vehicle goes to another department or to the
               workshop's holding pool; a need is met from vehicles we have or obtained outside.</p>
        </field>
    </record>

    <!-- One entry point per intent: the form opens on the right type. -->
    <record id="action_ksw_fleet_request_release" model="ir.actions.act_window">
        <field name="name">Release Vehicles</field>
        <field name="res_model">ksw.fleet.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('request_type', '=', 'release')]</field>
        <field name="context">{'default_request_type': 'release', 'search_default_filter_open': 1}</field>
        <field name="search_view_id" ref="view_ksw_fleet_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Give up vehicles your department no longer needs</p>
            <p>Or tick them under Vehicles and press Release Selected. The GM decides where each one goes.</p>
        </field>
    </record>

    <record id="action_ksw_fleet_request_addition" model="ir.actions.act_window">
        <field name="name">Request Vehicles</field>
        <field name="res_model">ksw.fleet.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('request_type', '=', 'addition')]</field>
        <field name="context">{'default_request_type': 'addition', 'search_default_filter_open': 1}</field>
        <field name="search_view_id" ref="view_ksw_fleet_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask for more vehicles</p>
            <p>Say the type and how many. The GM gives you vehicles the company has, obtains them
               outside, or explains why not.</p>
        </field>
    </record>

    <record id="action_ksw_fleet_request_to_decide" model="ir.actions.act_window">
        <field name="name">To Decide</field>
        <field name="res_model">ksw.fleet.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_ksw_fleet_request_search"/>
        <field name="context">{'search_default_filter_submitted': 1, 'search_default_groupby_type': 1}</field>
    </record>

    <!-- Supply and demand side by side: every open line, for the GM. -->
    <record id="view_ksw_fleet_addition_line_list" model="ir.ui.view">
        <field name="name">ksw.fleet.addition.line.list</field>
        <field name="model">ksw.fleet.addition.line</field>
        <field name="arch" type="xml">
            <list string="Vehicles Needed" create="0" edit="0" delete="0">
                <field name="request_id"/>
                <field name="department_id"/>
                <field name="vehicle_type"/>
                <field name="quantity" sum="Total"/>
                <field name="open_quantity" sum="Total"/>
                <field name="external_quantity" optional="show"/>
                <field name="note"/>
                <field name="status" widget="badge"/>
                <field name="request_state" column_invisible="True"/>
                <button name="action_open_decision" type="object" string="Decide" class="btn-primary"
                        icon="fa-gavel" groups="KSW_fleet_allocation.group_fleet_allocation_gm"
                        invisible="request_state != 'submitted' or status not in ('pending', 'waiting_external')"/>
            </list>
        </field>
    </record>

    <record id="view_ksw_fleet_addition_line_search" model="ir.ui.view">
        <field name="name">ksw.fleet.addition.line.search</field>
        <field name="model">ksw.fleet.addition.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="department_id"/>
                <filter string="Open" name="filter_open" domain="[('is_closed', '=', False), ('request_state', '=', 'submitted')]"/>
                <group>
                    <filter string="Vehicle Type" name="groupby_type" context="{'group_by': 'vehicle_type'}"/>
                    <filter string="Department" name="groupby_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ksw_fleet_addition_line_open" model="ir.actions.act_window">
        <field name="name">Open Needs</field>
        <field name="res_model">ksw.fleet.addition.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_ksw_fleet_addition_line_search"/>
        <field name="context">{'search_default_filter_open': 1, 'search_default_groupby_type': 1}</field>
    </record>

    <record id="view_ksw_fleet_release_line_list" model="ir.ui.view">
        <field name="name">ksw.fleet.release.line.list</field>
        <field name="model">ksw.fleet.release.line</field>
        <field name="arch" type="xml">
            <list string="Released Vehicles" create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_decision" type="object" string="Decide Selected"
                            class="btn-primary" groups="KSW_fleet_allocation.group_fleet_allocation_gm"/>
                </header>
                <field name="request_id"/>
                <field name="department_id"/>
                <field name="vehicle_id"/>
                <field name="vehicle_type"/>
                <field name="note"/>
                <field name="status" widget="badge"/>
                <field name="request_state" column_invisible="True"/>
                <button name="action_open_decision" type="object" string="Decide" class="btn-primary"
                        icon="fa-gavel" groups="KSW_fleet_allocation.group_fleet_allocation_gm"
                        invisible="status != 'pending' or request_state != 'submitted'"/>
            </list>
        </field>
    </record>

    <record id="view_ksw_fleet_release_line_search" model="ir.ui.view">
        <field name="name">ksw.fleet.release.line.search</field>
        <field name="model">ksw.fleet.release.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="department_id"/>
                <filter string="Waiting for GM" name="filter_open" domain="[('status', '=', 'pending'), ('request_state', '=', 'submitted')]"/>
                <group>
                    <filter string="Vehicle Type" name="groupby_type" context="{'group_by': 'vehicle_type'}"/>
                    <filter string="Department" name="groupby_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ksw_fleet_release_line_open" model="ir.actions.act_window">
        <field name="name">Released Vehicles</field>
        <field name="res_model">ksw.fleet.release.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_ksw_fleet_release_line_search"/>
        <field name="context">{'search_default_filter_open': 1, 'search_default_groupby_type': 1}</field>
    </record>

</odoo>
