<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Custody > Documents: the papers a supervisor or the GM may
         read (the record rules decide which), read only. The register itself
         (uploads, imports, confirmation) stays in the Documents app, with HR. -->
    <record id="view_ksw_document_list_readonly" model="ir.ui.view">
        <field name="name">ksw.document.list.readonly</field>
        <field name="model">ksw.document</field>
        <field name="inherit_id" ref="KSW_documents.view_ksw_document_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="/list" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_ksw_document_form_readonly" model="ir.ui.view">
        <field name="name">ksw.document.form.readonly</field>
        <field name="model">ksw.document</field>
        <field name="inherit_id" ref="KSW_documents.view_ksw_document_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="/form" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>
    <record id="action_ksw_document_readonly" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">ksw.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'replaced')]</field>
        <field name="search_view_id" ref="KSW_documents.view_ksw_document_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ksw_document_list_readonly')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_ksw_document_form_readonly')})]"/>
        <field name="help" type="html"><p>No documents you may read. You see the papers of your
            departments' vehicles and employees; HR keeps the register.</p></field>
    </record>
    <menuitem id="menu_vehicle_custody_documents" name="Documents"
              parent="menu_vehicle_custody_root" action="action_ksw_document_readonly" sequence="45"
              groups="KSW_fleet_allocation.group_fleet_allocation_user,KSW_fleet_allocation.group_fleet_allocation_gm,group_custody_hr,base.group_system"/>

    <!-- The employee form's Documents tab, for the GM and supervisors who can
         open employee forms: it lists only what the rules let them read. -->
    <record id="view_employee_form_documents_custody" model="ir.ui.view">
        <field name="name">hr.employee.form.documents.custody</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="KSW_documents.view_employee_form_documents"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='ksw_documents']" position="attributes">
                <attribute name="groups">KSW_documents.group_document_officer,base.group_system,KSW_fleet_allocation.group_fleet_allocation_user,KSW_fleet_allocation.group_fleet_allocation_gm</attribute>
            </xpath>
            <xpath expr="//page[@name='ksw_documents']//button[@name='action_upload_documents']" position="attributes">
                <attribute name="groups">KSW_documents.group_document_officer,base.group_system</attribute>
            </xpath>
        </field>
    </record>
</odoo>
