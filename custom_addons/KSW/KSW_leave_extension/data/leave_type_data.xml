<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">

        <!-- Vacation Extension: walks the SAME six approval steps as an
             annual vacation (its own validation type, so KSW_unpaid_leave's
             shortcut at GM final does not apply), and charges nothing to the
             annual balance.

             is_unpaid_leave is deliberately NOT set. The extension's days are
             unpaid all the same : KSW_leave_extension implements that half
             itself (_excuses_absence, _get_durations, _uses_unpaid_return).
             Setting the flag would also hand the request to
             KSW_unpaid_leave's action_gm_final_approve, which jumps straight
             to 'approved' and skips Step 6, the HR document confirmation
             this request exists to reach. -->
        <record id="leave_type_extension" model="hr.leave.type">
            <field name="name">Vacation Extension</field>
            <field name="leave_validation_type">extension_multi</field>
            <field name="is_leave_extension" eval="True"/>
            <field name="is_annual_leave" eval="False"/>
            <field name="is_unpaid_leave" eval="False"/>
            <field name="requires_allocation" eval="False"/>
            <field name="request_unit">day</field>
            <field name="unpaid" eval="True"/>
            <field name="time_type">leave</field>
            <field name="company_id" eval="False"/>
            <field name="country_id" eval="False"/>
            <field name="color" eval="2"/>
            <field name="sequence">16</field>
        </record>

    </data>

</odoo>
