#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"%(name)s can no longer be extended: the manager has already confirmed that "
"the employee came back."
msgstr "لم يعد بالإمكان تمديد %(name)s: فقد أكد المدير مباشرة الموظف للعمل."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "A Vacation Extension must name the vacation it extends."
msgstr "يجب تحديد الإجازة المراد تمديدها في طلب التمديد."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"A Vacation Extension starts the day after the vacation it extends. Expected "
"%(expected)s, got %(actual)s."
msgstr ""
"يبدأ تمديد الإجازة في اليوم التالي لانتهاء الإجازة الممددة. المتوقع "
"%(expected)s، والمُدخل %(actual)s."

#. module: KSW_leave_extension
#: model:ir.model.fields,help:KSW_leave_extension.field_hr_leave__x_ext_passport_fee
msgid ""
"A fixed 120.0 SAR when the passport fee applies, otherwise 0. Derived from "
"the tick box — never typed."
msgstr ""
"مبلغ ثابت 120.0 ريال عند انطباق رسوم الجواز، وإلا 0. مشتق من خانة التحديد — "
"ولا يكتب يدويا."

#. module: KSW_leave_extension
#: model_terms:ir.ui.view,arch_db:KSW_leave_extension.hr_leave_view_form_inherit_extension
msgid "A fixed government charge of 120.00 SAR."
msgstr "رسوم حكومية ثابتة قدرها 120.00 ريال سعودي."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
