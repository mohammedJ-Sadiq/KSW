#. module: KSW_leave_extension
#: model:ir.model.fields,field_description:KSW_leave_extension.field_hr_leave__x_is_leave_extension
#: model:ir.model.fields,field_description:KSW_leave_extension.field_hr_leave_type__is_leave_extension
msgid "Is Vacation Extension"
msgstr "تمديد إجازة"

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "No Vacation Extension leave type is configured."
msgstr "لا يوجد نوع إجازة معرّف لتمديد الإجازة."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"Only %(employee)s, their direct manager or HR can request an extension of "
"this vacation."
msgstr ""
"لا يمكن طلب تمديد هذه الإجازة إلا من %(employee)s أو مديره المباشر أو "
"الموارد البشرية."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "Only Accounting Approvers can fill the accounting note."
msgstr "لا يمكن إدخال ملاحظات المحاسبة إلا لمعتمدي المحاسبة."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "Only HR Approvers can fill the extension fees."
msgstr "لا يمكن إدخال رسوم التمديد إلا لمعتمدي الموارد البشرية."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "Only a Vacation Extension request can extend another vacation."
msgstr "لا يمكن تمديد إجازة إلا من خلال طلب تمديد إجازة."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"Only a vacation that has passed GM final approval can be extended. %(name)s "
"is still being approved."
msgstr ""
"لا يمكن تمديد إلا إجازة اعتمدها المدير العام نهائياً. %(name)s ما زالت قيد "
"الاعتماد."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"Only the current vacation can be extended, and that is %(current)s, not "
"%(name)s. Extensions run one after another."
msgstr ""
"لا يمكن تمديد إلا الإجازة الحالية، وهي %(current)s وليست %(name)s. التمديدات"
" تتتابع الواحد تلو الآخر."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"Only the current vacation can be extended, and that is %(current)s, not this"
" one. Extend that request instead — extensions run one after another."
msgstr ""
"لا يمكن تمديد إلا الإجازة الحالية، وهي %(current)s وليست هذه. قم بتمديد ذلك "
"الطلب — التمديدات تتتابع الواحد تلو الآخر."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "Passport"
msgstr "الجوازات"

#. module: KSW_leave_extension
#: model:ir.model.fields,field_description:KSW_leave_extension.field_hr_leave__x_ext_passport_fee
msgid "Passport Fees"
msgstr "رسوم الجوازات"

#. module: KSW_leave_extension
#: model:ir.model.fields,field_description:KSW_leave_extension.field_hr_leave__x_ext_passport_fee_applied
msgid "Passport Fees Apply"
msgstr "تطبيق رسوم الجوازات"

#. module: KSW_leave_extension
#: model:ir.model.fields,field_description:KSW_leave_extension.field_hr_leave__x_return_state
#: model_terms:ir.ui.view,arch_db:KSW_leave_extension.hr_leave_view_form_inherit_extension
msgid "Return Status"
msgstr "حالة العودة"

#. module: KSW_leave_extension
#: model:ir.model.fields,help:KSW_leave_extension.field_hr_leave__x_is_leave_extension
msgid "Stored related field for reliable use in view invisible expressions."
msgstr "حقل مرتبط مخزن للاستخدام الموثوق في تعابير الإخفاء في الواجهات."

#. module: KSW_leave_extension
#: model:ir.model.fields,help:KSW_leave_extension.field_hr_leave__x_ext_total_fees
msgid ""
"Sum of every extension fee. Recorded on the request for the approvers; it is"
" not posted to payroll."
msgstr ""
"مجموع جميع رسوم التمديد. يسجل في الطلب للمعتمدين؛ ولا يرحل إلى الرواتب."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"The accounting note can only be filled while the request is at the "
"Accounting step."
msgstr "لا يمكن إدخال ملاحظات المحاسبة إلا أثناء مرحلة اعتماد المحاسبة."

#. module: KSW_leave_extension
#: model_terms:ir.ui.view,arch_db:KSW_leave_extension.hr_leave_view_form_inherit_extension
msgid "The approved vacation this request continues."
msgstr "الإجازة المعتمدة التي يكمّلها هذا الطلب."

#. module: KSW_leave_extension
#: model:ir.model.fields,help:KSW_leave_extension.field_hr_leave__x_extended_leave_id
msgid ""
"The approved vacation this request continues. The extension starts the day "
"after that vacation ends."
msgstr "الإجازة المعتمدة التي يكمّلها هذا الطلب."

#. module: KSW_leave_extension
#: model_terms:ir.ui.view,arch_db:KSW_leave_extension.hr_leave_view_form_inherit_extension
msgid "The day the employee actually came back. Days after it are paid again."
msgstr "اليوم الذي عاد فيه الموظف فعلياً. الأيام التي تليه تُصرف مرة أخرى."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"The extension and the vacation it extends must belong to the same employee."
msgstr "يجب أن يكون التمديد والإجازة الممددة لنفس الموظف."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"The extension fees can only be filled while the request is at the HR "
"Approval step. Ask the GM to return it to HR if a figure has to change."
msgstr ""
"لا يمكن إدخال رسوم التمديد إلا أثناء مرحلة اعتماد الموارد البشرية. اطلب من "
"المدير العام إعادة الطلب إلى الموارد البشرية لتعديل أي مبلغ."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"The passport fee and the extension total are worked out from the fees above "
"— they cannot be entered directly."
msgstr ""
"يتم احتساب رسوم الجوازات وإجمالي التمديد من الرسوم أعلاه — ولا يمكن إدخالهما"
" مباشرة."

#. module: KSW_leave_extension
#: model:ir.model.fields,help:KSW_leave_extension.field_hr_leave__x_extendable_leave_ids
msgid ""
"The vacation this request may extend — the employee's current one, and only "
"that. Published as a field because a Many2one domain can name a field but "
"cannot call a method."
msgstr ""
"الإجازة التي يمكن لهذا الطلب تمديدها — الإجازة الحالية للموظف، وهي فقط. "
"منشورة كحقل لأن نطاق Many2one يمكنه تسمية حقل لكن لا يمكنه استدعاء دالة."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"This vacation can no longer be extended: the manager has already confirmed "
"that the employee came back."
msgstr ""
"لم يعد بالإمكان تمديد هذه الإجازة: فقد أكد المدير مباشرة الموظف للعمل."

#. module: KSW_leave_extension
#. odoo-python
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "This would make the extension chain loop back on itself."
msgstr "هذا يجعل سلسلة التمديدات تدور على نفسها."

#. module: KSW_leave_extension
#: model:ir.model.fields,help:KSW_leave_extension.field_hr_leave__x_ext_passport_fee_applied
msgid ""
"Tick when the passport (الجوازات) fee is due. It is a fixed government "
"charge of 120.0 SAR."
msgstr ""
"حدد عند استحقاق رسوم الجوازات. وهي رسوم حكومية ثابتة قدرها 120.0 ريال."

