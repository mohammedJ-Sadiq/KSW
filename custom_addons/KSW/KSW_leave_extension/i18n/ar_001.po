#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "A Vacation Extension must name the vacation it extends."
msgstr "يجب تحديد الإجازة المراد تمديدها في طلب التمديد."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "Only a Vacation Extension request can extend another vacation."
msgstr "لا يمكن تمديد إجازة إلا من خلال طلب تمديد إجازة."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "A request cannot extend itself."
msgstr "لا يمكن للطلب أن يمدد نفسه."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "This would make the extension chain loop back on itself."
msgstr "هذا يجعل سلسلة التمديدات تدور على نفسها."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"The extension and the vacation it extends must belong to the same employee."
msgstr "يجب أن يكون التمديد والإجازة الممددة لنفس الموظف."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"Only a vacation that has passed GM final approval can be extended. %(name)s "
"is still being approved."
msgstr ""
"لا يمكن تمديد إلا إجازة اعتمدها المدير العام نهائياً. %(name)s ما زالت قيد "
"الاعتماد."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"A Vacation Extension starts the day after the vacation it extends. Expected "
"%(expected)s, got %(actual)s."
msgstr ""
"يبدأ تمديد الإجازة في اليوم التالي لانتهاء الإجازة الممددة. المتوقع "
"%(expected)s، والمُدخل %(actual)s."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"Only the current vacation can be extended, and that is %(current)s, not "
"%(name)s. Extensions run one after another."
msgstr ""
"لا يمكن تمديد إلا الإجازة الحالية، وهي %(current)s وليست %(name)s. التمديدات "
"تتتابع الواحد تلو الآخر."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"Only the current vacation can be extended, and that is %(current)s, not this "
"one. Extend that request instead — extensions run one after another."
msgstr ""
"لا يمكن تمديد إلا الإجازة الحالية، وهي %(current)s وليست هذه. قم بتمديد ذلك "
"الطلب — التمديدات تتتابع الواحد تلو الآخر."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"%(name)s can no longer be extended: the manager has already confirmed that "
"the employee came back."
msgstr "لم يعد بالإمكان تمديد %(name)s: فقد أكد المدير مباشرة الموظف للعمل."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"This vacation can no longer be extended: the manager has already confirmed "
"that the employee came back."
msgstr "لم يعد بالإمكان تمديد هذه الإجازة: فقد أكد المدير مباشرة الموظف للعمل."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "A vacation can only be extended once it has passed GM final approval."
msgstr "لا يمكن تمديد الإجازة إلا بعد اعتمادها نهائياً من المدير العام."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "No Vacation Extension leave type is configured."
msgstr "لا يوجد نوع إجازة معرّف لتمديد الإجازة."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"Only %(employee)s, their direct manager or HR can request an extension of "
"this vacation."
msgstr ""
"لا يمكن طلب تمديد هذه الإجازة إلا من %(employee)s أو مديره المباشر أو "
"الموارد البشرية."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "Extend Vacation"
msgstr "تمديد الإجازة"

#. module: KSW_leave_extension
#: model_terms:ir.ui.view,arch_db:KSW_leave_extension.hr_leave_view_form_inherit_extension
msgid "➕ Extend Vacation"
msgstr "➕ تمديد الإجازة"

#. module: KSW_leave_extension
#: model:ir.model.fields,field_description:KSW_leave_extension.field_hr_leave__x_extendable_leave_ids
msgid "Extendable Vacations"
msgstr "الإجازات القابلة للتمديد"

#. module: KSW_leave_extension
#: model:ir.model.fields,field_description:KSW_leave_extension.field_hr_leave__x_can_extend
msgid "Can Be Extended"
msgstr "قابلة للتمديد"

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"The passport fee and the extension total are worked out from the fees above "
"— they cannot be entered directly."
msgstr ""
"يتم احتساب رسوم الجوازات وإجمالي التمديد من الرسوم أعلاه — ولا يمكن إدخالهما "
"مباشرة."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "Only HR Approvers can fill the extension fees."
msgstr "لا يمكن إدخال رسوم التمديد إلا لمعتمدي الموارد البشرية."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"The extension fees can only be filled while the request is at the HR "
"Approval step. Ask the GM to return it to HR if a figure has to change."
msgstr ""
"لا يمكن إدخال رسوم التمديد إلا أثناء مرحلة اعتماد الموارد البشرية. اطلب من "
"المدير العام إعادة الطلب إلى الموارد البشرية لتعديل أي مبلغ."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "Only Accounting Approvers can fill the accounting note."
msgstr "لا يمكن إدخال ملاحظات المحاسبة إلا لمعتمدي المحاسبة."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid ""
"The accounting note can only be filled while the request is at the "
"Accounting step."
msgstr "لا يمكن إدخال ملاحظات المحاسبة إلا أثناء مرحلة اعتماد المحاسبة."

#. module: KSW_leave_extension
#: code:addons/KSW_leave_extension/models/hr_leave.py:0
msgid "Work Permit"
msgstr "رخصة العمل"

