<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_leave_type_view_form_inherit_extension" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.extension</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requires_allocation']" position="before">
                <field name="is_leave_extension"/>
            </xpath>
        </field>
    </record>

</odoo>
