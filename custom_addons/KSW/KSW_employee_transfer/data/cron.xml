<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approved transfers take effect on their date. -->
    <record id="cron_apply_due_transfers" model="ir.cron">
        <field name="name">Employee Transfer: apply transfers that are due</field>
        <field name="model_id" ref="model_ksw_employee_transfer"/>
        <field name="state">code</field>
        <field name="code">model._cron_apply_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
