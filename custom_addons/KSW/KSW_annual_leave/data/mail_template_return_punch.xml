<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Sent to the EMPLOYEE (not the manager) the first time they punch
             in while their vacation is still open in the system. Paired with
             an inbox notification in
             hr.leave._notify_unconfirmed_return_punch: message_notify
             delivers to inbox OR email depending on the recipient's
             notification_type, so the email is sent separately to reach an
             employee who never signs in to Odoo. -->
        <record id="mail_template_return_punch_unconfirmed" model="mail.template">
            <field name="name">Vacation Return Not Confirmed — Employee Alert</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="use_default_to" eval="False"/>
            <field name="email_from">{{ object.company_id.email or user.email_formatted }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="subject">Your return from vacation has not been confirmed</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-out="object.employee_id.name or ''"/>,</p>
                    <p>
                        Your attendance has been recorded
                        <t t-if="ctx.get('ksw_punch_date')">
                            on <t t-out="ctx.get('ksw_punch_date')"/>
                        </t>,
                        but the system still shows you as being on vacation
                        (<t t-out="object.request_date_from"/> &#8594;
                        <t t-out="object.request_date_to"/>).
                    </p>
                    <p>
                        Your direct manager<t t-if="object.employee_id.leave_manager_id">,
                        <b t-out="object.employee_id.leave_manager_id.name"/>,</t>
                        still needs to confirm the date you actually returned
                        to work.
                    </p>
                    <p>
                        <b>Until this is confirmed your monthly payslip cannot
                        be processed.</b> Please ask your manager to open your
                        time off request and press <b>Confirm Return</b>.
                    </p>
                    <br/>
                    Best Regards,
                    <br/>
                    HR Department
                    <br/>
                </div>
            </field>
        </record>

    </data>
</odoo>
