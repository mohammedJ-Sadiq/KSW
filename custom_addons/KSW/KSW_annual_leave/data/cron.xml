<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <record id="cron_refresh_annual_leave" model="ir.cron">
        <field name="name">Refresh Annual Leave Accrued Totals (Daily 3 AM GMT+3)</field>
        <field name="model_id" ref="model_ksw_annual_leave"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="active" eval="True"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall">2026-03-20 00:00:00</field>
    </record>

    <!-- The daily "Remind Managers to Confirm Vacation Returns" cron was
         removed in 19.0.1.10.0. Chasing the manager never changed anything,
         and it treated both employee populations the same. It is replaced
         by two enforcement paths: attendance-sheet employees need the
         supervisor to confirm the month before payroll reads it
         (KSW_attendance_sheet), and fingerprint employees now notify the
         *employee* the moment they punch in with the return unconfirmed
         (hr.attendance.create -> _notify_unconfirmed_return_punch).
         The obsolete cron row is unlinked by migrations/19.0.1.10.0. -->

</odoo>

