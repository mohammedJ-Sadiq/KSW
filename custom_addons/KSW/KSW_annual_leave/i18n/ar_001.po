#. module: KSW_annual_leave
#: model_terms:ir.actions.act_window,help:KSW_annual_leave.action_ksw_annual_leave
msgid ""
"Use the Generate / Refresh All action to create records for all employees."
msgstr "استخدم إجراء \"إنشاء / تحديث الكل\" لإنشاء السجلات لجميع الموظفين."

