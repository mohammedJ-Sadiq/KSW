#. module: KSW_annual_leave
#: model:ir.model.fields,help:KSW_annual_leave.field_absent_days_wizard__entitlement_days
msgid "21 days if < 5 years, 30 days if ≥ 5 years."
msgstr ""
"21 يوما إذا كانت الخدمة أقل من 5 سنوات، و30 يوما إذا بلغت 5 سنوات فأكثر."

#. module: KSW_annual_leave
#: model:ir.model.fields,help:KSW_annual_leave.field_ksw_annual_leave__daily_rate
msgid "21/365 for the first 5 years, 30/365 after that."
msgstr "21/365 للسنوات الخمس الأولى، و30/365 بعد ذلك."

#. module: KSW_annual_leave
#: model_terms:ir.ui.view,arch_db:KSW_annual_leave.view_ksw_leave_attendance_wizard_form
msgid ""
"<strong>Attendance Sheet Employee</strong><br/>\n"
"                        This employee is tracked on a monthly attendance sheet.\n"
"                        The leave period below covers workdays that are currently\n"
"                        marked as <em>attended</em>. You can mark them absent now,\n"
"                        or update the attendance sheet manually later."
msgstr ""
"<strong>موظف كشف الحضور والانصراف</strong><br/> يتابع هذا الموظف عبر كشف "
"حضور شهري. تغطي فترة الإجازة أدناه أيام عمل مسجلة حاليا ك<em>حاضر</em>. "
"يمكنك تعليمها كغياب الآن، أو تحديث كشف الحضور والانصراف يدويا لاحقا."

#. module: KSW_annual_leave
#: model_terms:ir.ui.view,arch_db:KSW_annual_leave.opening_balance_wizard_view_form
msgid ""
"<strong>Go-Live Baseline Setup</strong><br/>\n"
"                        For each employee, enter their last vacation return date as the\n"
"                        <em>Opening Reset Date</em>. From that date, the system will treat\n"
"                        the employee's balance as starting from zero (plus any extra carry-over\n"
"                        days you specify). All annual leaves validated on or after this date\n"
"                        will be tracked automatically by the system."
msgstr ""
"<strong>إعداد خط الأساس للانطلاق</strong><br/> لكل موظف، أدخل تاريخ آخر عودة"
" له من الإجازة في حقل <em>تاريخ إعادة الضبط الافتتاحي</em>. من ذلك التاريخ "
"سيعامل النظام رصيد الموظف على أنه يبدأ من الصفر (بالإضافة إلى أي أيام مرحلة "
"إضافية تحددها). وستتتبع تلقائيا جميع الإجازات السنوية المصدقة في ذلك التاريخ"
" أو بعده."

