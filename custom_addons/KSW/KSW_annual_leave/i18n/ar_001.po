#. module: KSW_annual_leave
#: model:mail.template,body_html:KSW_annual_leave.mail_template_return_punch_unconfirmed
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Dear <t t-out=\"object.employee_id.name or ''\"/>,</p>\n"
"                    <p>\n"
"                        Your attendance has been recorded\n"
"                        <t t-if=\"ctx.get('ksw_punch_date')\">\n"
"                            on <t t-out=\"ctx.get('ksw_punch_date')\"/>\n"
"                        </t>,\n"
"                        but the system still shows you as being on vacation\n"
"                        (<t t-out=\"object.request_date_from\"/> →\n"
"                        <t t-out=\"object.request_date_to\"/>).\n"
"                    </p>\n"
"                    <p>\n"
"                        Your direct manager<t t-if=\"object.employee_id.leave_manager_id\">,\n"
"                        <b t-out=\"object.employee_id.leave_manager_id.name\"/>,</t>\n"
"                        still needs to confirm the date you actually returned\n"
"                        to work.\n"
"                    </p>\n"
"                    <p>\n"
"                        <b>Until this is confirmed your monthly payslip cannot\n"
"                        be processed.</b> Please ask your manager to open your\n"
"                        time off request and press <b>Confirm Return</b>.\n"
"                    </p>\n"
"                    <br/>\n"
"                    Best Regards,\n"
"                    <br/>\n"
"                    HR Department\n"
"                    <br/>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>عزيزي <t t-out=\"object.employee_id.name or ''\"/>،</p>\n"
"                    <p>\n"
"                        تم تسجيل حضورك\n"
"                        <t t-if=\"ctx.get('ksw_punch_date')\">\n"
"                            في <t t-out=\"ctx.get('ksw_punch_date')\"/>\n"
"                        </t>،\n"
"                        لكن النظام لا يزال يظهرك في إجازة\n"
"                        (<t t-out=\"object.request_date_from\"/> ←\n"
"                        <t t-out=\"object.request_date_to\"/>).\n"
"                    </p>\n"
"                    <p>\n"
"                        لا يزال مديرك المباشر<t t-if=\"object.employee_id.leave_manager_id\">،\n"
"                        <b t-out=\"object.employee_id.leave_manager_id.name\"/>،</t>\n"
"                        بحاجة إلى تأكيد التاريخ الفعلي لمباشرتك\n"
"                        العمل.\n"
"                    </p>\n"
"                    <p>\n"
"                        <b>حتى يتم التأكيد لا يمكن معالجة كشف راتبك\n"
"                        الشهري.</b> يرجى الطلب من مديرك فتح\n"
"                        طلب إجازتك والضغط على <b>تأكيد المباشرة</b>.\n"
"                    </p>\n"
"                    <br/>\n"
"                    مع أطيب التحيات،\n"
"                    <br/>\n"
"                    إدارة الموارد البشرية\n"
"                    <br/>\n"
"                </div>\n"
"            "

#. module: KSW_annual_leave
#: model_terms:ir.ui.view,arch_db:KSW_annual_leave.opening_balance_wizard_view_form
msgid ""
"<strong>Go-Live Baseline Setup</strong><br/>\n"
"                        For each employee, enter their last vacation return date as the\n"
"                        <em>Opening Reset Date</em>. From that date, the system will treat\n"
"                        the employee's balance as starting from zero (plus any extra carry-over\n"
"                        days you specify). All annual leaves validated on or after this date\n"
"                        will be tracked automatically by the system."
msgstr ""
"<strong>إعداد خط الأساس للانطلاق</strong><br/> لكل موظف، أدخل تاريخ آخر عودة"
" له من الإجازة في حقل <em>تاريخ إعادة الضبط الافتتاحي</em>. من ذلك التاريخ "
"سيعامل النظام رصيد الموظف على أنه يبدأ من الصفر (بالإضافة إلى أي أيام مرحلة "
"إضافية تحددها). وستتتبع تلقائيا جميع الإجازات السنوية المصدقة في ذلك التاريخ"
" أو بعده."

