<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Layer 1: Module Category                                      -->
    <!-- ============================================================ -->
    <!--
        "KSW Leaves" groups every leave-related privilege under a
        single row in the user form. A single tiered "Leave
        Management" privilege (Self → Supervisor → Supervisor
        Cascading → Officer) confers the FULL create / view / modify /
        delete scope for the chosen tier, plus a separate "Annual
        Leave Approval" dropdown for the HR/Accounting/GM approver
        roles.

        (History: this used to be four orthogonal C/V/M/D privileges
        with 16 tier groups. They were collapsed into one tiered
        privilege — each tier now grants all four CRUD verbs for its
        scope, which is what every real assignment used anyway.)

        "Subordinate" traverses `hr.employee.parent_id` (Supervisor =
        direct reports; Supervisor Cascading = whole sub-tree via
        child_of) — NOT Odoo's `leave_manager_id` — for consistency
        with KSW_deduction's record rules.
    -->
    <record id="module_category_ksw_leaves" model="ir.module.category">
        <field name="name">KSW Leaves</field>
        <field name="sequence">201</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 2: Privileges                                           -->
    <!-- ============================================================ -->
    <record id="privilege_leave_management" model="res.groups.privilege">
        <field name="name">Leave Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_leaves"/>
    </record>

    <!--
        Annual Leave Approval: single dropdown merging the HR /
        Accounting / GM approver roles. The DM (Direct Manager)
        step is NOT a role here — it is derived dynamically from
        `hr.employee.parent_id.user_id` in `action_dm_approve`,
        matching the KSW_deduction pattern.
    -->
    <record id="privilege_annual_leave_approval" model="res.groups.privilege">
        <field name="name">Annual Leave Approval</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_ksw_leaves"/>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Leave Management (tiered, full CRUD)        -->
    <!-- ============================================================ -->
    <!--
        Self: baseline. Every internal user is implicitly
        `group_leave_self` (see the <function> block below making
        `base.group_user` imply it) — this removes the blank "No"
        choice from the privilege dropdown. Self CRUD is provided by
        Odoo's own base.group_user hr.leave rules (read/write/unlink
        own, state-gated); no KSW rule is needed for the Self tier.
    -->
    <record id="group_leave_self" model="res.groups">
        <field name="name">Self</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="privilege_leave_management"/>
        <field name="comment">Create, view, edit and delete one's own leave requests only.</field>
    </record>

    <record id="group_leave_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="privilege_leave_management"/>
        <field name="implied_ids" eval="[
            (4, ref('group_leave_self')),
            (4, ref('hr_holidays.group_hr_holidays_responsible')),
        ]"/>
        <field name="comment">Full create/view/edit/delete on own leaves and those of direct subordinates. Implies "Time Off Responsible" so the Approvals menu is visible.</field>
    </record>

    <record id="group_leave_supervisor_cascading" model="res.groups">
        <field name="name">Supervisor Cascading</field>
        <field name="sequence">3</field>
        <field name="privilege_id" ref="privilege_leave_management"/>
        <field name="implied_ids" eval="[
            (4, ref('group_leave_supervisor')),
        ]"/>
        <field name="comment">Full create/view/edit/delete on own leaves and those of all subordinates (recursive, whole sub-tree).</field>
    </record>

    <record id="group_leave_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="sequence">4</field>
        <field name="privilege_id" ref="privilege_leave_management"/>
        <field name="implied_ids" eval="[
            (4, ref('group_leave_supervisor_cascading')),
            (4, ref('hr_holidays.group_hr_holidays_user')),
        ]"/>
        <field name="comment">Full create/view/edit/delete on every leave request company-wide. Implies "Time Off Officer" for full menu access.</field>
    </record>

    <!--
        Every internal user is implicitly "Self". Uses <function>
        (not <record>) because updating `base.group_user.implied_ids`
        via <record> can stomp existing implications on upgrade. This
        runs on every install/upgrade and is additive via (4, id).
    -->
    <function model="res.groups" name="write">
        <value eval="[ref('base.group_user')]"/>
        <value eval="{'implied_ids': [(4, ref('group_leave_self'))]}"/>
    </function>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Annual Leave Approval                       -->
    <!-- ============================================================ -->
    <!--
        Three parallel approver roles under one privilege dropdown.
        Each approver group also implies the Officer tier so the
        approver can actually see every leave pending their step
        (otherwise a Self-only user who got e.g. GM Approver would
        be unable to see the leaves they need to approve).
    -->
    <record id="group_annual_leave_hr" model="res.groups">
        <field name="name">HR Approver</field>
        <field name="privilege_id" ref="privilege_annual_leave_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_leave_officer'))]"/>
        <field name="comment">Can perform the HR step of annual leave approval (penalty / iqama renewal / flight ticket).</field>
    </record>

    <record id="group_annual_leave_acc" model="res.groups">
        <field name="name">Accounting Approver</field>
        <field name="privilege_id" ref="privilege_annual_leave_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('group_leave_officer'))]"/>
        <field name="comment">Can approve annual leave requests at the accounting step (additional commissions, remaining loans).</field>
    </record>

    <!--
        The GM tier is the one approval group that is NOT company-wide.
        Authority comes from `hr.department.x_effective_gm_id`, so scope has
        to follow it: `group_leave_officer` is deliberately NOT implied here,
        because its rule is [(1,'=',1)] and would hand every GM every
        department's requests — the exact behaviour this tier replaces.

        `(6, 0, [...])` rather than `(4, ...)`: an implication already
        written to the database survives its removal from this file, so the
        list must be set outright to actively drop `group_leave_officer`
        (Odoo 19 Pitfalls #3). `hr_holidays.group_hr_holidays_user` is named
        explicitly because it used to arrive via the Officer tier and carries
        the Time Off menus and the hr.leave ACL — losing it would leave the
        GM with a scoped rule over a model he cannot open.
    -->
    <record id="group_annual_leave_gm" model="res.groups">
        <field name="name">GM Approver</field>
        <field name="privilege_id" ref="privilege_annual_leave_approval"/>
        <field name="implied_ids" eval="[(6, 0, [
            ref('base.group_user'),
            ref('hr_holidays.group_hr_holidays_user'),
        ])]"/>
        <field name="comment">Can perform Initial and Final approval of annual leave requests, for the departments they are set as General Manager of.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — hr.leave (tier scopes)                         -->
    <!-- ============================================================ -->
    <!--
        Notes on rule semantics:
          * One rule per tier now grants ALL FOUR CRUD verbs for that
            tier's scope (read+write+create+unlink), since "Leave
            Management" is a single tiered privilege rather than four
            orthogonal C/V/M/D privileges.
          * Odoo's built-in base.group_user rules already cover the
            Self tier (read/write/unlink own, state-gated; create via
            the neutralised rule_employee_update below). No KSW rule
            is needed for Self.
          * "Subordinate" traverses `hr.employee.parent_id`:
            Supervisor = direct reports (parent_id.user_id == user);
            Supervisor Cascading = whole sub-tree (child_of).
          * `user.employee_ids.ids` covers the multi-company case.
            When the user has no employee record the list is empty
            and child_of returns nothing — falling back to Self.
    -->

    <record id="hr_leave_rule_supervisor" model="ir.rule">
        <field name="name">KSW Leave: supervisor (immediate subordinates, full CRUD)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('group_leave_supervisor'))]"/>
        <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="hr_leave_rule_supervisor_cascading" model="ir.rule">
        <field name="name">KSW Leave: supervisor cascading (sub-tree, full CRUD)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('group_leave_supervisor_cascading'))]"/>
        <field name="domain_force">[('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="hr_leave_rule_officer" model="ir.rule">
        <field name="name">KSW Leave: officer (all, full CRUD)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('group_leave_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — hr.leave, Department GM                        -->
    <!-- ============================================================ -->
    <!--
        The GM's scope is the departments he is General Manager of, and
        nothing else. There is no company-wide fallback on purpose: a GM who
        is not named on a department has no business reading its requests,
        which is the same answer the approve buttons give.

        `x_effective_gm_id` is a stored compute on hr.department, so this is
        a plain join. It already folds in the parent-department climb and the
        company default, so a department left blank still resolves to
        somebody and the domain needs no OR branch for it.

        Employees with NO department are reachable through the company
        default GM only, and that cannot be expressed here (there is no
        department row to join). They are covered by the second rule below.

        Write, not just read: the GM has to stamp the approval state. No
        create and no unlink — a GM approves requests, he does not raise or
        destroy them.
    -->
    <record id="hr_leave_rule_department_gm" model="ir.rule">
        <field name="name">KSW Leave: department GM (own departments)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('group_annual_leave_gm'))]"/>
        <field name="domain_force">[('employee_id.department_id.x_effective_gm_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        103 active employees have no department at all. Their requests fall
        back to the company default GM in `_department_gm_user`, so the same
        person must be able to see them here or the chain stalls on a
        request nobody can open.
    -->
    <record id="hr_leave_rule_department_gm_no_department" model="ir.rule">
        <field name="name">KSW Leave: default GM (employees with no department)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('group_annual_leave_gm'))]"/>
        <field name="domain_force">[
            ('employee_id.department_id', '=', False),
            ('company_id.x_default_gm_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_leave_allocation_rule_view_department_gm" model="ir.rule">
        <field name="name">KSW Allocation: department GM (own departments)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="groups" eval="[(4, ref('group_annual_leave_gm'))]"/>
        <field name="domain_force">[('employee_id.department_id.x_effective_gm_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="ksw_annual_leave_rule_department_gm" model="ir.rule">
        <field name="name">KSW Annual Leave: department GM (own departments)</field>
        <field name="model_id" ref="model_ksw_annual_leave"/>
        <field name="groups" eval="[(4, ref('group_annual_leave_gm'))]"/>
        <field name="domain_force">[('employee_id.department_id.x_effective_gm_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_leave_commission_line_rule_department_gm" model="ir.rule">
        <field name="name">KSW Leave Commission: department GM (own departments)</field>
        <field name="model_id" ref="model_hr_leave_commission_line"/>
        <field name="groups" eval="[(4, ref('group_annual_leave_gm'))]"/>
        <field name="domain_force">[('leave_id.employee_id.department_id.x_effective_gm_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_leave_deduction_line_rule_department_gm" model="ir.rule">
        <field name="name">KSW Leave Other Deduction: department GM (own departments)</field>
        <field name="model_id" ref="model_hr_leave_deduction_line"/>
        <field name="groups" eval="[(4, ref('group_annual_leave_gm'))]"/>
        <field name="domain_force">[('leave_id.employee_id.department_id.x_effective_gm_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — hr.leave, Manager Assistant (delegated)        -->
    <!-- ============================================================ -->
    <!--
        The assistant is NOT a tier on the ladder above. Their scope
        comes from a delegation named by the manager
        (res.users.x_assistant_ids, KSW_base_security), so the domain
        resolves `user._ksw_assisted_manager_ids()` to a flat id list at
        rule-compile time. An undelegated user gets [], i.e. matches
        nothing — the correct fallback.

        Read and write are split into two rules (the same pattern as
        ksw_deduction_rule_officer / _officer_write) so the assistant
        can FOLLOW a request through the whole chain but only EDIT it
        while it is still at its first pending step:

          * ('state', 'in', ['draft', 'confirm'])
                does the work for ordinary leave types, whose progress
                lives in `state`.
          * ('x_annual_approval_state', 'in', [False, 'pending_dm'])
                does the work for the KSW multi-step chains, whose
                `state` stays 'confirm' all the way past GM final
                approval, and whose progress lives here instead.
                Ordinary types leave this field NULL (it has no
                default), so the clause is vacuously true for them.

        The two clauses are AND-ed, never OR-ed: OR would wave a
        pending_gm_final annual leave straight through. And the
        positive `in [False, ...]` form is deliberate — `not in` on a
        nullable column is the classic SQL trap (NULL NOT IN (...)
        is NULL, not TRUE).

        Both the parent_id and the leave_manager_id disjunct are needed:
        action_dm_approve keys on leave_manager_id while the tier rules
        key on parent_id. They usually coincide, but where they diverge
        the assistant must still cover everything their manager will be
        asked to approve.

        There is deliberately NO ('employee_id.user_id', 'in', ...)
        disjunct — the manager's own requests are out of scope; the
        manager files those personally.

        perm_unlink is False on the read rule (August 2026: still not
        delegated for every state — an assistant has no business undoing
        something already approved). It is True on the prepare rule below:
        an assistant who raised a request on their manager's behalf may
        also withdraw it, but only while it is still sitting at its first
        pending step (same domain as edit — before the DM, or before the
        first KSW chain step, has acted). Once that step is signed off the
        domain here no longer matches and deletion falls back to whatever
        broader tier (if any) the assistant separately holds.
    -->
    <record id="hr_leave_rule_manager_assistant_read" model="ir.rule">
        <field name="name">KSW Leave: manager assistant (delegated team, read all states)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('KSW_base_security.group_manager_assistant'))]"/>
        <field name="domain_force">['|',
            ('employee_id.parent_id.user_id', 'in', user._ksw_assisted_manager_ids()),
            ('employee_id.leave_manager_id', 'in', user._ksw_assisted_manager_ids())]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_leave_rule_manager_assistant_prepare" model="ir.rule">
        <field name="name">KSW Leave: manager assistant (prepare/edit before any approval)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('KSW_base_security.group_manager_assistant'))]"/>
        <field name="domain_force">[
            ('state', 'in', ['draft', 'confirm']),
            ('x_annual_approval_state', 'in', [False, 'pending_dm']),
            '|',
                ('employee_id.parent_id.user_id', 'in', user._ksw_assisted_manager_ids()),
                ('employee_id.leave_manager_id', 'in', user._ksw_assisted_manager_ids())]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — hr.leave.allocation (read cascade)             -->
    <!-- ============================================================ -->
    <!--
        Odoo's stock allocation rules let `base.group_user` read only
        own + `leave_manager_id` allocations. When a Supervisor (or
        Create-Supervisor) user picks a subordinate in the leave
        creation form, the leave-type filter `has_valid_allocation`
        must read that subordinate's allocation — but the stock rule
        excludes parent_id descendants, so annual-vacation types
        silently disappear from the dropdown.

        These KSW rules grant **read-only** access to allocations of
        subordinates (parent_id descendants, recursive) for users in
        any KSW Supervisor or Officer Create/View tier. Write/create/
        unlink on allocations remain admin-only — KSW leaves the
        allocation lifecycle to the existing infrastructure.
    -->
    <record id="hr_leave_allocation_rule_view_supervisor" model="ir.rule">
        <field name="name">KSW Allocation: view supervisor (immediate subordinates)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="groups" eval="[(4, ref('group_leave_supervisor'))]"/>
        <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_leave_allocation_rule_view_supervisor_cascading" model="ir.rule">
        <field name="name">KSW Allocation: view supervisor cascading (subordinates, recursive)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="groups" eval="[(4, ref('group_leave_supervisor_cascading'))]"/>
        <field name="domain_force">[('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_leave_allocation_rule_view_officer" model="ir.rule">
        <field name="name">KSW Allocation: view officer (all)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="groups" eval="[(4, ref('group_leave_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Same reason as the supervisor rule above: without read on the
        delegated team's allocations, `has_valid_allocation` silently
        drops annual-vacation types from the leave-type dropdown and
        the assistant simply cannot file one.
    -->
    <record id="hr_leave_allocation_rule_view_manager_assistant" model="ir.rule">
        <field name="name">KSW Allocation: view manager assistant (delegated team)</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
        <field name="groups" eval="[(4, ref('KSW_base_security.group_manager_assistant'))]"/>
        <field name="domain_force">['|',
            ('employee_id.parent_id.user_id', 'in', user._ksw_assisted_manager_ids()),
            ('employee_id.leave_manager_id', 'in', user._ksw_assisted_manager_ids())]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>


    <!-- ============================================================ -->
    <!-- Record Rules — ksw.annual.leave (Dashboard)                   -->
    <!-- ============================================================ -->
    <record id="ksw_annual_leave_rule_self" model="ir.rule">
        <field name="name">KSW Annual Leave: self</field>
        <field name="model_id" ref="model_ksw_annual_leave"/>
        <field name="groups" eval="[(4, ref('group_leave_self'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="ksw_annual_leave_rule_supervisor" model="ir.rule">
        <field name="name">KSW Annual Leave: supervisor (immediate)</field>
        <field name="model_id" ref="model_ksw_annual_leave"/>
        <field name="groups" eval="[(4, ref('group_leave_supervisor'))]"/>
        <field name="domain_force">[('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>

    <record id="ksw_annual_leave_rule_supervisor_cascading" model="ir.rule">
        <field name="name">KSW Annual Leave: supervisor cascading (recursive)</field>
        <field name="model_id" ref="model_ksw_annual_leave"/>
        <field name="groups" eval="[(4, ref('group_leave_supervisor_cascading'))]"/>
        <field name="domain_force">[('employee_id', 'child_of', user.employee_ids.ids)]</field>
    </record>

    <record id="ksw_annual_leave_rule_officer" model="ir.rule">
        <field name="name">KSW Annual Leave: officer (all)</field>
        <field name="model_id" ref="model_ksw_annual_leave"/>
        <field name="groups" eval="[(4, ref('group_leave_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Explicit read-only, unlike the tier rules above which leave the
         perm_* flags at their default and rely on the ACL alone. The
         assistant tier is display-only on every satellite model. -->
    <record id="ksw_annual_leave_rule_manager_assistant" model="ir.rule">
        <field name="name">KSW Annual Leave: manager assistant (delegated team)</field>
        <field name="model_id" ref="model_ksw_annual_leave"/>
        <field name="groups" eval="[(4, ref('KSW_base_security.group_manager_assistant'))]"/>
        <field name="domain_force">['|',
            ('employee_id.parent_id.user_id', 'in', user._ksw_assisted_manager_ids()),
            ('employee_id.leave_manager_id', 'in', user._ksw_assisted_manager_ids())]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
