<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Requests: a Supervisor sees every one (any of them may ask about any
         client), and so does a Water GM, to review them (deciding is still
         only for the GM named on the request). Anyone else sees the ones he must decide or raised himself:
         authority is the GM named on the request, not a group. -->
    <record id="rule_request_supervisor" model="ir.rule">
        <field name="name">Multiplier requests: all (Water Supervisor)</field>
        <field name="model_id" ref="model_ksw_client_multiplier_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('KSW_water_delivery.group_water_dispatcher')), (4, ref('KSW_water_delivery.group_water_gm')), (4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_request_gm" model="ir.rule">
        <field name="name">Multiplier requests: mine to decide or raised by me</field>
        <field name="model_id" ref="model_ksw_client_multiplier_request"/>
        <field name="domain_force">['|', ('gm_user_id', '=', user.id), ('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
