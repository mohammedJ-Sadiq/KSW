<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One list for both audiences. The Request Change column carries the
         Supervisor group, so accounting reads exactly the same page without
         any way to change it. -->
    <record id="view_client_multiplier_list" model="ir.ui.view">
        <field name="name">ksw.client.multiplier.list</field>
        <field name="model">ksw.client.multiplier</field>
        <field name="arch" type="xml">
            <list string="Client Multipliers" create="0" edit="0" delete="0"
                  decoration-muted="is_stopped" decoration-info="pending_request_id">
                <field name="bas_code"/>
                <field name="name"/>
                <field name="current_multiplier"/>
                <field name="current_since" optional="show"/>
                <field name="next_multiplier" optional="show" invisible="not next_date"/>
                <field name="next_date" optional="show"/>
                <field name="pending_request_id" optional="show"/>
                <field name="bas_factor" optional="show"/>
                <field name="differs_from_bas" optional="hide" widget="boolean"/>
                <field name="is_stopped" column_invisible="1"/>
                <button name="action_request_change" type="object" string="Request Change"
                        icon="fa-pencil-square-o" class="btn-link"
                        groups="KSW_water_delivery.group_water_dispatcher"/>
            </list>
        </field>
    </record>

    <record id="view_client_multiplier_form" model="ir.ui.view">
        <field name="name">ksw.client.multiplier.form</field>
        <field name="model">ksw.client.multiplier</field>
        <field name="arch" type="xml">
            <form string="Client Multiplier" create="0" edit="0" delete="0">
                <header>
                    <button name="action_request_change" type="object" string="Request Change"
                            class="btn-primary" groups="KSW_water_delivery.group_water_dispatcher"
                            invisible="pending_request_id"/>
                    <button name="action_request_change" type="object" string="Open Pending Request"
                            groups="KSW_water_delivery.group_water_dispatcher"
                            invisible="not pending_request_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="bas_code"/>
                    </div>
                    <group>
                        <group string="«الرد المضاعف»">
                            <field name="current_multiplier"/>
                            <field name="current_since"/>
                            <field name="next_multiplier" invisible="not next_date"/>
                            <field name="next_date" invisible="not next_date"/>
                            <field name="pending_request_id" invisible="not pending_request_id"/>
                        </group>
                        <group string="BAS">
                            <field name="bas_factor"/>
                            <field name="bas_checked_on"/>
                            <field name="differs_from_bas"/>
                            <field name="partner_id"/>
                            <field name="is_stopped"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="History" name="history">
                            <field name="rate_ids" readonly="1">
                                <list>
                                    <field name="date_from" string="Effective From"/>
                                    <field name="multiplier"/>
                                    <field name="source"/>
                                    <field name="request_id"/>
                                    <field name="approved_by_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Requests" name="requests">
                            <field name="request_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="old_multiplier"/>
                                    <field name="new_multiplier"/>
                                    <field name="effective_date"/>
                                    <field name="requested_by_id"/>
                                    <field name="gm_employee_id"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_client_multiplier_search" model="ir.ui.view">
        <field name="name">ksw.client.multiplier.search</field>
        <field name="model">ksw.client.multiplier</field>
        <field name="arch" type="xml">
            <search string="Client Multipliers">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('bas_code', 'ilike', self)]"/>
                <field name="current_multiplier"/>
                <filter name="active_clients" string="Active in BAS" domain="[('is_stopped', '=', False)]"/>
                <filter name="scheduled" string="Change Scheduled" domain="[('next_date', '!=', False)]"/>
                <filter name="differs" string="Differs from BAS" domain="[('differs_from_bas', '=', True)]"/>
                <filter name="no_value" string="No Multiplier" domain="[('current_multiplier', '=', 0)]"/>
                <group>
                    <filter name="g_multiplier" string="Multiplier" context="{'group_by': 'current_multiplier'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_client_multipliers" model="ir.actions.act_window">
        <field name="name">Client Multipliers</field>
        <field name="res_model">ksw.client.multiplier</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_clients': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No clients yet</p>
            <p>Clients come from the BAS customer accounts; the daily refresh adds them.</p>
        </field>
    </record>

    <record id="action_refresh_client_multipliers" model="ir.actions.server">
        <field name="name">Refresh from BAS</field>
        <field name="model_id" ref="model_ksw_client_multiplier"/>
        <field name="binding_model_id" ref="model_ksw_client_multiplier"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_refresh_from_bas()</field>
    </record>

</odoo>
