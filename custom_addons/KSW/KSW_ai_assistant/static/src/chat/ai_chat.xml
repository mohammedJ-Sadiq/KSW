<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="KSW_ai_assistant.Chat">
        <div class="ksw_ai" t-att-class="{ 'ksw_ai_compact': props.compact }">
            <t t-if="state.status and !state.status.enabled">
                <p class="ksw_ai_muted">
                    The AI assistant is not set up yet.
                    <t t-if="state.status.is_admin">Choose a provider and add its key in Settings › General Settings › AI Assistant.</t>
                </p>
            </t>
            <t t-elif="state.status">
                <div class="ksw_ai_turns" t-if="state.turns.length">
                    <div t-foreach="state.turns" t-as="turn" t-key="turn_index" class="ksw_ai_turn">
                        <div class="ksw_ai_q"><span t-esc="turn.question"/></div>
                        <div class="ksw_ai_a" t-att-class="{ 'ksw_ai_error': turn.error }">
                            <t t-if="turn.answer === null">
                                <span class="ksw_ai_thinking"><i class="fa fa-circle-o-notch fa-spin me-2"/>Looking it up…</span>
                            </t>
                            <t t-else="">
                                <div class="ksw_ai_text" t-out="turn.answer"/>
                                <div t-foreach="turn.blocks" t-as="block" t-key="block_index" class="ksw_ai_block">
                                    <div class="ksw_ai_block_head">
                                        <strong t-esc="block.title or block.model_label"/>
                                        <span class="ksw_ai_count">
                                            <t t-if="block.kind == 'table'">
                                                <t t-esc="block.rows.length"/> / <t t-esc="block.total"/>
                                            </t>
                                        </span>
                                        <button type="button" class="btn btn-sm btn-secondary ms-auto"
                                                t-on-click="() => this.openList(block)">
                                            <i class="fa fa-external-link me-1"/>Open in Odoo
                                        </button>
                                    </div>
                                    <div class="ksw_ai_filter">
                                        <i class="fa fa-filter me-1" title="Filter used"/>
                                        <span t-esc="block.model_label"/>: <span t-esc="block.filter_text"/>
                                    </div>
                                    <div class="ksw_ai_table_wrap">
                                        <table class="table table-sm table-hover mb-0">
                                            <thead><tr><th t-foreach="block.columns" t-as="col" t-key="col_index" t-esc="col"/></tr></thead>
                                            <tbody>
                                                <tr t-foreach="block.rows" t-as="row" t-key="row_index"
                                                    t-att-class="{ 'ksw_ai_link': block.kind == 'table' }"
                                                    t-on-click="() => this.openRecord(block, row_index)">
                                                    <td t-foreach="row" t-as="cell" t-key="cell_index" t-esc="formatCell(cell)"/>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div t-if="sumEntries(block).length" class="ksw_ai_sums">
                                        <span>Total of all <t t-esc="block.total"/>:</span>
                                        <t t-foreach="sumEntries(block)" t-as="sum" t-key="sum[0]">
                                            <span class="ksw_ai_sum"><t t-esc="sum[0]"/>: <strong t-esc="formatCell(sum[1])"/></span>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
                <div t-if="state.page and state.page.res_id" class="ksw_ai_page">
                    <i class="fa fa-file-text-o me-1"/>
                    <span>About: </span><strong t-esc="state.page.title or state.page.model"/>
                    <button type="button" class="btn btn-link btn-sm p-0 ms-2" t-on-click="dropPage"
                            title="Ask without this record">×</button>
                </div>
                <div class="ksw_ai_examples" t-if="!state.turns.length">
                    <button t-foreach="examples" t-as="ex" t-key="ex_index" type="button"
                            class="btn btn-sm btn-light ksw_ai_chip" t-on-click="() => this.useExample(ex)"
                            t-esc="ex"/>
                </div>
                <div class="ksw_ai_input">
                    <i class="fa fa-magic" aria-hidden="true"/>
                    <textarea t-ref="input" rows="1" t-model="state.question" t-on-keydown="onKeydown"
                              t-att-disabled="state.busy"
                              placeholder="Ask about your data, in Arabic or English…"
                              aria-label="Ask the AI assistant"/>
                    <button type="button" class="btn btn-primary" t-att-disabled="state.busy or !state.question.trim()"
                            t-on-click="ask" title="Ask">
                        <i class="fa fa-paper-plane"/>
                    </button>
                    <button t-if="state.turns.length" type="button" class="btn btn-link" t-on-click="newChat"
                            title="New conversation">New</button>
                </div>
                <p class="ksw_ai_note">Answers can be wrong: check the filter under each table. The assistant only reads, with your own access rights.</p>
            </t>
        </div>
    </t>

    <t t-name="KSW_ai_assistant.Dialog">
        <Dialog title.translate="Ask Odoo" size="'lg'" footer="false">
            <KswAiChat compact="true" close="props.close" page="props.page"/>
        </Dialog>
    </t>

    <t t-name="KSW_ai_assistant.Systray">
        <div class="o_nav_entry">
            <button type="button" class="btn btn-link o-dropdown--narrow ksw_ai_systray" t-on-click="open"
                    title="Ask Odoo (AI assistant)" aria-label="Ask Odoo">
                <i class="fa fa-magic"/>
            </button>
        </div>
    </t>

    <!-- Home: the Ask box above "Waiting for you". -->
    <t t-inherit="KSW_backend_theme.Home" t-inherit-mode="extension">
        <xpath expr="//section[hasclass('ksw_home_waiting_section')]" position="before">
            <section class="ksw_home_section ksw_ai_home" aria-label="Ask Odoo">
                <div class="ksw_home_section_head">
                    <h2>Ask Odoo</h2>
                </div>
                <KswAiChat/>
            </section>
        </xpath>
    </t>
</templates>
