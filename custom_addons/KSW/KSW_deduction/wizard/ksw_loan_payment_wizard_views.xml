<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="ksw_loan_payment_wizard_view_form" model="ir.ui.view">
        <field name="name">ksw.loan.payment.wizard.form</field>
        <field name="model">ksw.loan.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Payment">
                <sheet>
                    <!-- Hidden fields loaded for invisible= expressions -->
                    <field name="is_full_payment" invisible="1"/>

                    <group string="Deduction">
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="deduction_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_outstanding" readonly="1"
                                   string="Outstanding Balance"/>
                            <field name="pending_count" readonly="1"
                                   string="Pending Installments"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <separator string="Payment Details"/>

                    <group>
                        <group>
                            <field name="payment_amount"/>
                            <field name="payment_date"/>
                            <field name="note" placeholder="Receipt #, bank reference…"/>
                            <field name="application_mode" widget="radio"/>
                        </group>
                        <group string="Result">
                            <!-- Full payment: identical in both modes -->
                            <div invisible="not is_full_payment"
                                 class="alert alert-success mb-0">
                                <i class="fa fa-check-circle me-1"/>
                                <strong>Full payment</strong> — all
                                <field name="pending_count" class="oe_inline"
                                       readonly="1" nolabel="1"/>
                                pending installment(s) will be marked as paid.
                            </div>
                            <!-- Partial: settle earliest installments first -->
                            <div invisible="is_full_payment or not payment_amount or application_mode != 'sequential'"
                                 class="alert alert-info mb-0">
                                <i class="fa fa-info-circle me-1"/>
                                <strong>Settle earliest first</strong> —
                                <field name="seq_settled_count" class="oe_inline"
                                       readonly="1" nolabel="1"/>
                                installment(s) will be fully settled.
                                <span invisible="not seq_partial_label">
                                    <br/>
                                    <field name="seq_partial_label"
                                           class="oe_inline" readonly="1"
                                           nolabel="1"/>
                                    is partially settled:
                                    <field name="seq_partial_paid"
                                           class="oe_inline" readonly="1"
                                           nolabel="1"/>
                                    paid,
                                    <field name="seq_partial_remainder"
                                           class="oe_inline" readonly="1"
                                           nolabel="1"/>
                                    stays pending in the same month.
                                </span>
                                <br/>Later installments keep their original
                                amounts and dates.
                            </div>
                            <!-- Partial: redistribute across all installments -->
                            <div invisible="is_full_payment or not payment_amount or application_mode != 'redistribute'"
                                 class="alert alert-info mb-0">
                                <i class="fa fa-info-circle me-1"/>
                                <strong>Redistribute</strong> — remaining
                                <field name="remaining_after" class="oe_inline"
                                       readonly="1" nolabel="1"/>
                                will be redistributed across
                                <field name="pending_count" class="oe_inline"
                                       readonly="1" nolabel="1"/>
                                installment(s):
                                each becomes
                                <field name="new_installment_amount"
                                       class="oe_inline" readonly="1"
                                       nolabel="1"/>.
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm Payment"
                            class="btn-primary"
                            invisible="not payment_amount"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
