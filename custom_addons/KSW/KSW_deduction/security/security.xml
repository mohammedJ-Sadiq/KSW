<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Layer 1: Module Category                                      -->
    <!-- ============================================================ -->
    <record id="module_category_ksw_deduction" model="ir.module.category">
        <field name="name">KSW Deductions</field>
        <field name="sequence">202</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 2: Privileges                                           -->
    <!-- ============================================================ -->
    <!--
        Privilege: Deduction Management
        Every internal user is at least "User" (see group_deduction_user
        below — it is implied by base.group_user, which removes the
        implicit "No" choice from the privilege dropdown).
    -->
    <record id="privilege_deduction_management" model="res.groups.privilege">
        <field name="name">Deduction Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_deduction"/>
    </record>

    <!--
        Privilege: Loan Approval
        There is no "DM Approver" role here: DM approval is conferred by
        being the employee's direct manager (hr.employee.parent_id.user_id).
        The remaining approver roles are explicit, since they are not
        derivable from any employee relation.
    -->
    <record id="privilege_loan_approval" model="res.groups.privilege">
        <field name="name">Loan Approval</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_ksw_deduction"/>
    </record>

    <!--
        Privilege: Loan Modification
        Single dropdown covering all loan edit/delete capabilities,
        formerly split across two privileges ("Loan Request
        Modification (pre-confirmation)" and "Loan Installment
        Modification (post-confirmation)"). Single-select, four
        cumulative-where-it-makes-sense options:

            (blank)   – No edit/delete rights on loans.
            Edit only – Edit amount & installments where the
                        state/approval-step permits (pre-confirmation).
            Delete only – Delete records (subject to the "no paid
                        installments" guard). Cannot edit.
            Edit and Delete – Both of the above.
            Full (incl. active installments) – Edit & Delete PLUS the
                        post-confirmation power to change the year/
                        month/amount of pending installments on an
                        already-active loan, open the loan payment
                        wizard, and close any deduction type. Typically
                        granted to accounting staff.

        Orthogonal to the approver roles (HR / Acc / GM): an Accounting
        Approver can approve loans yet be refused edit rights by leaving
        this blank, and vice-versa.
    -->
    <record id="privilege_loan_modification" model="res.groups.privilege">
        <field name="name">Loan Modification</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_ksw_deduction"/>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Deduction Management                        -->
    <!-- ============================================================ -->
    <!--
        User: baseline role. Auto-granted to every internal user
        (base.group_user implies group_deduction_user — see below).
        Scope: own deductions + any subordinate's deductions.
    -->
    <record id="group_deduction_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="comment">Read own deductions and any subordinate's (employees who report directly to me).</field>
    </record>

    <!-- Make every internal user implicitly a Deduction User.
         This removes the empty/"No" choice from the privilege dropdown
         in the user form. Uses <function> (not <record>) because updating
         base.group_user's implied_ids via <record> is unreliable; a
         direct write runs on every install and upgrade. -->
    <function model="res.groups" name="write">
        <value eval="[ref('base.group_user')]"/>
        <value eval="{'implied_ids': [(4, ref('group_deduction_user'))]}"/>
    </function>

    <!--
        Supervisor: can submit loan requests on behalf of direct subordinates
        (employee.parent_id.user_id == user). Does not grant officer-level
        access to all employees — scope is strictly own + subordinates (enforced
        by the user record rule and by a server-side guard in action_submit).
    -->
    <record id="group_deduction_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="implied_ids" eval="[(4, ref('group_deduction_user'))]"/>
        <field name="comment">Can create and submit loan requests for direct subordinates. Scope limited to own employee + direct reports.</field>
    </record>

    <!--
        Accounting Data Entry (Non-Loan): the data-entry staff in the
        accounting team who own every non-loan deduction (gov.
        penalties, internal penalties, salary advances). Formerly named
        "HR Officer (Non-Loan)" — the role was moved out of HR in
        August 2026; only the label and the xml id changed, the group
        record and its members are the same (see migration
        19.0.1.1.0/pre-migrate.py).
        Scope: create/manage `managed_by='acc_data_entry'` deductions
        for all employees, WITHOUT loan visibility or loan-approval
        rights. Deliberately NOT implied by Officer/Manager any more:
        HR-side roles now only READ these deductions.
    -->
    <record id="group_acc_data_entry" model="res.groups">
        <field name="name">Accounting Data Entry (Non-Loan)</field>
        <field name="sequence">3</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Create and manage non-loan deductions (penalties, salary advances) for all employees — the accounting data-entry role. Does NOT grant loan visibility or loan-approval rights.</field>
    </record>

    <!--
        Officer no longer implies the data-entry role: non-loan
        deductions belong to accounting now, so Officer (an HR-side
        role) keeps full rights on loans and READ-ONLY access to
        accounting data-entry deductions (see the split officer record
        rules below).
    -->
    <record id="group_deduction_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="sequence">4</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_deduction_user')])]"/>
        <field name="comment">Create and edit loan deductions for all employees, and read every deduction. Non-loan (Accounting Data Entry) deductions are read-only for this role.</field>
    </record>

    <record id="group_deduction_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="implied_ids" eval="[(4, ref('group_deduction_officer'))]"/>
        <field name="comment">Administrator role: full access to every deduction including delete, so the system stays administrable when the accounting data-entry staff are unavailable. Loan-specific edit/delete still requires the dedicated "Loan Modification" privilege — Manager does NOT auto-grant it, so an HR/Admin can be Deduction Manager without being able to touch loan amount/installments or delete loans.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Loan Approval workflow                      -->
    <!-- ============================================================ -->
    <!-- NOTE: "DM Approver" intentionally removed. DM approval is
         derived dynamically from employee.parent_id.user_id. -->
    <!-- (6, 0, ...) not (4, ...): an earlier version of this file had
         group_loan_hr imply the non-loan officer role, and an additive
         command would never undo that in databases where it was already
         written (CLAUDE.md gotcha #3). HR Approvers are read-only on
         non-loan deductions now, so the implication must actually go. -->
    <record id="group_loan_hr" model="res.groups">
        <field name="name">HR Approver</field>
        <field name="privilege_id" ref="privilege_loan_approval"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_loan_acc" model="res.groups">
        <field name="name">Accounting Approver</field>
        <field name="privilege_id" ref="privilege_loan_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_loan_gm" model="res.groups">
        <field name="name">GM Final Approver</field>
        <field name="privilege_id" ref="privilege_loan_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_loan_disbursement" model="res.groups">
        <field name="name">Loan Disbursement Officer</field>
        <field name="privilege_id" ref="privilege_loan_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Loan Modification (single dropdown)          -->
    <!-- ============================================================ -->
    <!--
        Four options under the one "Loan Modification" privilege.
        "Edit and Delete" implies BOTH "Edit only" and "Delete only";
        "Full (incl. active installments)" implies "Edit and Delete"
        on top of its own post-confirmation installment powers, so
        has_group() checks for any lower tier return True for a Full
        holder. Picking the blank option = no group = no extra rights.
    -->
    <record id="group_loan_edit" model="res.groups">
        <field name="name">Edit only</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="privilege_loan_modification"/>
        <field name="comment">May edit amount and installments on loan deductions (where the state/approval step otherwise permits it).</field>
    </record>

    <record id="group_loan_delete" model="res.groups">
        <field name="name">Delete only</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="privilege_loan_modification"/>
        <field name="comment">May delete deductions (subject to the "no paid installments" guard). Cannot edit amount or installments.</field>
    </record>

    <record id="group_loan_edit_delete" model="res.groups">
        <field name="name">Edit and Delete</field>
        <field name="sequence">3</field>
        <field name="privilege_id" ref="privilege_loan_modification"/>
        <field name="implied_ids" eval="[(4, ref('group_loan_edit')), (4, ref('group_loan_delete'))]"/>
        <field name="comment">Edit and delete loan records (pre-confirmation). NOT auto-granted to Deduction Managers; must be set explicitly so an HR/Admin can be a Deduction Manager without inheriting loan modification rights.</field>
    </record>

    <!--
        Full: the former "Loan Installment Modification" power, now the
        top option of this merged dropdown. Implies Edit and Delete, so
        a Full holder also has pre-confirmation edit/delete (a slight,
        intentional widening over the old split — accounting is the most
        trusted loan role). On top it may change the year/month/amount
        of pending installments on a confirmed/active loan (changing a
        date pushes all subsequent pending installments forward by the
        same month-delta), open the loan payment wizard, and close any
        deduction type.
    -->
    <record id="group_installment_edit" model="res.groups">
        <field name="name">Full (incl. active installments)</field>
        <field name="sequence">4</field>
        <field name="privilege_id" ref="privilege_loan_modification"/>
        <field name="implied_ids" eval="[(4, ref('group_loan_edit_delete'))]"/>
        <field name="comment">Everything in "Edit and Delete" plus post-confirmation installment edits on active loans, the loan payment wizard, and closing any deduction type. Typically granted to accounting staff.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules                                                  -->
    <!-- ============================================================ -->
    <!--
        User rule: a plain user READS
          (a) their own deductions — every type, not just loans, so an
              employee can look up the penalty or advance being taken off
              their salary, and
          (b) deductions of any employee whose direct manager is them.
        Department membership is NOT used.

        READ ONLY since August 2026. This rule used to carry all four
        permissions, which mattered the moment the ACL row for
        group_deduction_user gained write/unlink (self-service edits
        below): it would have handed every internal user write access to
        their own — and their subordinates' — penalties, in any state.
        Write scope now comes from a rule per role: supervisor,
        self-service, and the officer/manager/approver rules further down.
    -->
    <record id="ksw_deduction_rule_user" model="ir.rule">
        <field name="name">Deduction: own + subordinates (read)</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_deduction_user'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Supervisors keep the full own + subordinates scope the read rule
        above used to give them: they raise and edit loan requests on
        behalf of their direct reports (ACL grants read/write/create, no
        unlink).
    -->
    <record id="ksw_deduction_rule_supervisor" model="ir.rule">
        <field name="name">Deduction: supervisor manages own + subordinates</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_deduction_supervisor'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>

    <!--
        Self-service: an employee may correct or withdraw their OWN loan
        request until the first approver signs.

        `state` stays 'draft' for the whole DM → HR → Acc → GM chain, so
        `approval_state` is the real gate: False (not submitted yet) or
        'pending_dm' (submitted, nobody has signed) — the same window the
        manager-assistant prepare rule uses.

        Loans only, and never create: penalties and advances belong to the
        accounting data-entry team, and the only route into a new loan is
        the self-service wizard (which creates via sudo). What may be SET
        on these records is whitelisted server-side in
        ksw.deduction._check_employee_self_write.
    -->
    <record id="ksw_deduction_rule_user_self_service" model="ir.rule">
        <field name="name">Deduction: employee edits own request before approval</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_deduction_user'))]"/>
        <field name="domain_force">[('is_loan', '=', True),
            ('state', '=', 'draft'),
            ('approval_state', 'in', [False, 'pending_dm']),
            ('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!--
        Loan Modification = "Delete only" / "Edit and Delete" / "Full"
        grants an unlink ACL on its own (access_ksw_deduction_loan_delete).
        Its scope used to ride on the user rule above; now that that rule
        is read-only, restate it here so a holder without a management
        role keeps exactly the reach they had.
    -->
    <record id="ksw_deduction_rule_loan_delete_scope" model="ir.rule">
        <field name="name">Deduction: loan-delete privilege scope (own + subordinates)</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_loan_delete'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Officers READ everything (loans and non-loan alike). -->
    <record id="ksw_deduction_rule_officer" model="ir.rule">
        <field name="name">Deduction: officer reads all</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_deduction_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ...but they may only CREATE/EDIT/DELETE what is not owned by the
         accounting data-entry team. Non-loan deductions moved to accounting
         in August 2026: Officer keeps loans, and reads the rest. -->
    <record id="ksw_deduction_rule_officer_write" model="ir.rule">
        <field name="name">Deduction: officer edits everything except accounting data-entry deductions</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_deduction_officer'))]"/>
        <field name="domain_force">[('managed_by', '!=', 'acc_data_entry')]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Deduction Manager is the administrator role and keeps full control of
         every deduction (rules are ORed across a user's groups, so this
         re-grants what the officer split above withholds). Without it nobody
         but the accounting data-entry staff could fix a bad penalty row. -->
    <record id="ksw_deduction_rule_manager_all" model="ir.rule">
        <field name="name">Deduction: manager full access</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_deduction_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Loan approvers (HR/Accounting/GM/Disbursement) see all loan deductions
         so they can act on the ones pending their step. -->
    <record id="ksw_deduction_rule_loan_approvers" model="ir.rule">
        <field name="name">Deduction: loan approvers see all loans</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_loan_hr')), (4, ref('group_loan_acc')), (4, ref('group_loan_gm')), (4, ref('group_loan_disbursement'))]"/>
        <field name="domain_force">[('is_loan', '=', True)]</field>
    </record>

    <!-- Deduction officers and all loan-workflow groups need to read the full
         hr.employee record for the employees on the deductions they manage.
         Without this, the deduction form crashes with "Access Denied by record
         rules for operation: read on hr.employee" for users who are not in
         hr.group_hr_user (whose own rule already grants all employees). -->
    <record id="rule_hr_employee_deduction_groups_all" model="ir.rule">
        <field name="name">Employee: Deduction officers and loan approvers see all employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_deduction_officer')),
                                    (4, ref('group_acc_data_entry')),
                                    (4, ref('group_loan_hr')),
                                    (4, ref('group_loan_acc')),
                                    (4, ref('group_loan_gm')),
                                    (4, ref('group_loan_disbursement'))]"/>
    </record>

    <!-- The accounting data-entry team owns non-loan deductions outright:
         create, edit and delete. -->
    <record id="ksw_deduction_rule_acc_data_entry" model="ir.rule">
        <field name="name">Deduction: accounting data entry manages non-loan deductions</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_acc_data_entry'))]"/>
        <field name="domain_force">[('managed_by', '=', 'acc_data_entry')]</field>
    </record>

    <!-- HR Approvers keep VISIBILITY of non-loan deductions (they still need
         the employee's full deduction picture when approving a loan) but may
         no longer touch them — read-only since August 2026. Odoo ORs rules per
         user and per operation, so group_loan_hr reads is_loan=True OR
         managed_by='acc_data_entry', and writes only is_loan=True. -->
    <record id="ksw_deduction_rule_non_loan_readonly" model="ir.rule">
        <field name="name">Deduction: HR approvers read non-loan deductions</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_loan_hr'))]"/>
        <field name="domain_force">[('managed_by', '=', 'acc_data_entry')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ================================================================ -->
    <!-- Manager Assistant: prepare loans for a delegated manager's team   -->
    <!-- ================================================================ -->
    <!--
        The assistant nominated on res.users.x_assistant_ids
        (KSW_base_security) may raise and edit a loan request for the
        direct subordinates of that manager, up until the manager
        performs the DM approval. They never approve anything:
        _compute_x_can_dm_approve does not consult this group, and this
        group must never imply group_deduction_officer, which IS an
        unconditional DM-approve override there.

        Scope is LOANS ONLY, deliberately. Non-loan deductions belong to
        the accounting data-entry team and go draft -> active with no DM
        step at all, so delegating them would produce records the manager
        could never approve. This mirrors exactly what the manager
        themselves can raise today (see _check_acc_data_entry_ownership).

        Read and prepare are split so the assistant can follow the loan
        through the whole approval chain but only edit it while it is
        still at the DM step. A loan's `state` stays 'draft' for the
        entire DM -> HR -> Acc -> GM chain, so `approval_state` is what
        actually gates the edit window.

        No unlink on either rule: withdrawing a request is not delegated.
    -->
    <record id="ksw_deduction_rule_manager_assistant_read" model="ir.rule">
        <field name="name">Deduction: manager assistant reads delegated teams' loans</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('KSW_base_security.group_manager_assistant'))]"/>
        <field name="domain_force">[('is_loan', '=', True),
            ('employee_id.parent_id.user_id', 'in', user._ksw_assisted_manager_ids())]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="ksw_deduction_rule_manager_assistant_prepare" model="ir.rule">
        <field name="name">Deduction: manager assistant prepares loans before DM approval</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('KSW_base_security.group_manager_assistant'))]"/>
        <field name="domain_force">[('is_loan', '=', True),
            ('state', '=', 'draft'),
            ('approval_state', 'in', [False, 'pending_dm']),
            ('employee_id.parent_id.user_id', 'in', user._ksw_assisted_manager_ids())]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- The deduction form reads the full hr.employee record of its
         employee; without this the assistant hits "Access Denied by record
         rules ... on hr.employee" the moment the form opens. Scoped to the
         delegated team, unlike the blanket officer rule above. -->
    <record id="rule_hr_employee_manager_assistant_deduction" model="ir.rule">
        <field name="name">Employee: manager assistant sees delegated teams' employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('KSW_base_security.group_manager_assistant'))]"/>
        <field name="domain_force">[('parent_id.user_id', 'in', user._ksw_assisted_manager_ids())]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>


