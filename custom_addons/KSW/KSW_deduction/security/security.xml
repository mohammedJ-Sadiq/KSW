<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Layer 1: Module Category                                      -->
    <!-- ============================================================ -->
    <record id="module_category_ksw_deduction" model="ir.module.category">
        <field name="name">KSW Deductions</field>
        <field name="sequence">202</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 2: Privileges                                           -->
    <!-- ============================================================ -->
    <!--
        Privilege: Deduction Management
        Every internal user is at least "User" (see group_deduction_user
        below — it is implied by base.group_user, which removes the
        implicit "No" choice from the privilege dropdown).
    -->
    <record id="privilege_deduction_management" model="res.groups.privilege">
        <field name="name">Deduction Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_deduction"/>
    </record>

    <!--
        Privilege: Loan Approval
        There is no "DM Approver" role here: DM approval is conferred by
        being the employee's direct manager (hr.employee.parent_id.user_id).
        The remaining approver roles are explicit, since they are not
        derivable from any employee relation.
    -->
    <record id="privilege_loan_approval" model="res.groups.privilege">
        <field name="name">Loan Approval</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_ksw_deduction"/>
    </record>

    <!--
        Privilege: Loan Modification
        Single dropdown covering all loan edit/delete capabilities,
        formerly split across two privileges ("Loan Request
        Modification (pre-confirmation)" and "Loan Installment
        Modification (post-confirmation)"). Single-select, four
        cumulative-where-it-makes-sense options:

            (blank)   – No edit/delete rights on loans.
            Edit only – Edit amount & installments where the
                        state/approval-step permits (pre-confirmation).
            Delete only – Delete records (subject to the "no paid
                        installments" guard). Cannot edit.
            Edit and Delete – Both of the above.
            Full (incl. active installments) – Edit & Delete PLUS the
                        post-confirmation power to change the year/
                        month/amount of pending installments on an
                        already-active loan, open the loan payment
                        wizard, and close any deduction type. Typically
                        granted to accounting staff.

        Orthogonal to the approver roles (HR / Acc / GM): an Accounting
        Approver can approve loans yet be refused edit rights by leaving
        this blank, and vice-versa.
    -->
    <record id="privilege_loan_modification" model="res.groups.privilege">
        <field name="name">Loan Modification</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_ksw_deduction"/>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Deduction Management                        -->
    <!-- ============================================================ -->
    <!--
        User: baseline role. Auto-granted to every internal user
        (base.group_user implies group_deduction_user — see below).
        Scope: own deductions + any subordinate's deductions.
    -->
    <record id="group_deduction_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="comment">Read own deductions and any subordinate's (employees who report directly to me).</field>
    </record>

    <!-- Make every internal user implicitly a Deduction User.
         This removes the empty/"No" choice from the privilege dropdown
         in the user form. Uses <function> (not <record>) because updating
         base.group_user's implied_ids via <record> is unreliable; a
         direct write runs on every install and upgrade. -->
    <function model="res.groups" name="write">
        <value eval="[ref('base.group_user')]"/>
        <value eval="{'implied_ids': [(4, ref('group_deduction_user'))]}"/>
    </function>

    <!--
        Supervisor: can submit loan requests on behalf of direct subordinates
        (employee.parent_id.user_id == user). Does not grant officer-level
        access to all employees — scope is strictly own + subordinates (enforced
        by the user record rule and by a server-side guard in action_submit).
    -->
    <record id="group_deduction_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="implied_ids" eval="[(4, ref('group_deduction_user'))]"/>
        <field name="comment">Can create and submit loan requests for direct subordinates. Scope limited to own employee + direct reports.</field>
    </record>

    <!--
        HR Officer (Non-Loan): folded into the Deduction Management
        dropdown (it used to live under its own "Non-Loan HR
        Management" privilege). Scope: create/manage HR-managed
        non-loan deductions (gov. penalties, internal penalties,
        salary advances) for all employees, WITHOUT loan visibility
        or loan-approval rights. group_loan_hr still implies this so
        HR Approvers keep their non-loan access; full Officer (below)
        implies it too since Officer is a strict superset.
    -->
    <record id="group_hr_deduction_officer" model="res.groups">
        <field name="name">HR Officer (Non-Loan)</field>
        <field name="sequence">3</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Create and manage HR-managed non-loan deductions (penalties, salary advances) for all employees. Does NOT grant loan visibility or loan-approval rights.</field>
    </record>

    <record id="group_deduction_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="sequence">4</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="implied_ids" eval="[(4, ref('group_deduction_user')), (4, ref('group_hr_deduction_officer'))]"/>
        <field name="comment">Create and edit deductions for all employees (loans and non-loan). Implies "HR Officer (Non-Loan)" since the full Officer scope is a superset of it.</field>
    </record>

    <record id="group_deduction_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="privilege_deduction_management"/>
        <field name="implied_ids" eval="[(4, ref('group_deduction_officer'))]"/>
        <field name="comment">Full access to non-loan deductions including delete. Loan-specific edit/delete still requires the dedicated "Loan Modification" privilege — Manager does NOT auto-grant it, so an HR/Admin can be Deduction Manager without being able to touch loan amount/installments or delete loans.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Loan Approval workflow                      -->
    <!-- ============================================================ -->
    <!-- NOTE: "DM Approver" intentionally removed. DM approval is
         derived dynamically from employee.parent_id.user_id. -->
    <record id="group_loan_hr" model="res.groups">
        <field name="name">HR Approver</field>
        <field name="privilege_id" ref="privilege_loan_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_loan_acc" model="res.groups">
        <field name="name">Accounting Approver</field>
        <field name="privilege_id" ref="privilege_loan_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_loan_gm" model="res.groups">
        <field name="name">GM Final Approver</field>
        <field name="privilege_id" ref="privilege_loan_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_loan_disbursement" model="res.groups">
        <field name="name">Loan Disbursement Officer</field>
        <field name="privilege_id" ref="privilege_loan_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Loan Modification (single dropdown)          -->
    <!-- ============================================================ -->
    <!--
        Four options under the one "Loan Modification" privilege.
        "Edit and Delete" implies BOTH "Edit only" and "Delete only";
        "Full (incl. active installments)" implies "Edit and Delete"
        on top of its own post-confirmation installment powers, so
        has_group() checks for any lower tier return True for a Full
        holder. Picking the blank option = no group = no extra rights.
    -->
    <record id="group_loan_edit" model="res.groups">
        <field name="name">Edit only</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="privilege_loan_modification"/>
        <field name="comment">May edit amount and installments on loan deductions (where the state/approval step otherwise permits it).</field>
    </record>

    <record id="group_loan_delete" model="res.groups">
        <field name="name">Delete only</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="privilege_loan_modification"/>
        <field name="comment">May delete deductions (subject to the "no paid installments" guard). Cannot edit amount or installments.</field>
    </record>

    <record id="group_loan_edit_delete" model="res.groups">
        <field name="name">Edit and Delete</field>
        <field name="sequence">3</field>
        <field name="privilege_id" ref="privilege_loan_modification"/>
        <field name="implied_ids" eval="[(4, ref('group_loan_edit')), (4, ref('group_loan_delete'))]"/>
        <field name="comment">Edit and delete loan records (pre-confirmation). NOT auto-granted to Deduction Managers; must be set explicitly so an HR/Admin can be a Deduction Manager without inheriting loan modification rights.</field>
    </record>

    <!--
        Full: the former "Loan Installment Modification" power, now the
        top option of this merged dropdown. Implies Edit and Delete, so
        a Full holder also has pre-confirmation edit/delete (a slight,
        intentional widening over the old split — accounting is the most
        trusted loan role). On top it may change the year/month/amount
        of pending installments on a confirmed/active loan (changing a
        date pushes all subsequent pending installments forward by the
        same month-delta), open the loan payment wizard, and close any
        deduction type.
    -->
    <record id="group_installment_edit" model="res.groups">
        <field name="name">Full (incl. active installments)</field>
        <field name="sequence">4</field>
        <field name="privilege_id" ref="privilege_loan_modification"/>
        <field name="implied_ids" eval="[(4, ref('group_loan_edit_delete'))]"/>
        <field name="comment">Everything in "Edit and Delete" plus post-confirmation installment edits on active loans, the loan payment wizard, and closing any deduction type. Typically granted to accounting staff.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules                                                  -->
    <!-- ============================================================ -->
    <!--
        User rule: a plain user sees
          (a) their own deductions, and
          (b) deductions of any employee whose direct manager is them.
        Department membership is NOT used.
    -->
    <record id="ksw_deduction_rule_user" model="ir.rule">
        <field name="name">Deduction: own + subordinates</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_deduction_user'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
    </record>

    <!-- Officers see everything -->
    <record id="ksw_deduction_rule_officer" model="ir.rule">
        <field name="name">Deduction: officer all</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_deduction_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Loan approvers (HR/Accounting/GM/Disbursement) see all loan deductions
         so they can act on the ones pending their step. -->
    <record id="ksw_deduction_rule_loan_approvers" model="ir.rule">
        <field name="name">Deduction: loan approvers see all loans</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_loan_hr')), (4, ref('group_loan_acc')), (4, ref('group_loan_gm')), (4, ref('group_loan_disbursement'))]"/>
        <field name="domain_force">[('is_loan', '=', True)]</field>
    </record>

    <!-- group_hr_deduction_officer can create and manage HR-managed non-loan
         deductions. group_loan_hr also sees them so they can close
         installments from the HR approval context. Odoo ORs rules per
         user, so group_loan_hr sees: is_loan=True OR managed_by='hr'. -->
    <record id="ksw_deduction_rule_hr_managed" model="ir.rule">
        <field name="name">Deduction: HR officers and HR approvers see HR-managed deductions</field>
        <field name="model_id" ref="model_ksw_deduction"/>
        <field name="groups" eval="[(4, ref('group_hr_deduction_officer')), (4, ref('group_loan_hr'))]"/>
        <field name="domain_force">[('managed_by', '=', 'hr')]</field>
    </record>

</odoo>


