#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/hr_payslip.py:0
msgid " — pulled forward, due %(period)s"
msgstr " — مقدم، مستحق في %(period)s"

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/wizard/ksw_deduction_statement_wizard.py:0
msgid "\"From\" must be on or before \"To\"."
msgstr "يجب أن يكون \"من\" في تاريخ \"إلى\" أو قبله."

#. module: KSW_deduction
#: model:ir.model.fields,help:KSW_deduction.field_ksw_deduction_line__settlement_label
msgid ""
"\"Payslip <ref>\" for auto-paid lines, \"Manual by <user> on <date>\" for "
"manual lines."
msgstr ""
"\"كشف الراتب <ref>\" للبنود المدفوعة تلقائيا، و\"يدوي بواسطة <user> في "
"<date>\" للبنود اليدوية."

#. module: KSW_deduction
#: model:ir.model.fields,field_description:KSW_deduction.field_ksw_deduction_reschedule_wizard__pct_of_gross
msgid "% of Gross"
msgstr "% من الإجمالي"

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/ksw_deduction.py:0
msgid ""
"%(emp)s already has %(n)d other personal loan(s) in progress, with %(out).2f"
" still outstanding. This request can still be approved, but the %(role)s "
"must click '⚠ Accept Concurrent Loan' first so the decision is on record."
msgstr ""
"لدى %(emp)s عدد %(n)d قرض شخصي آخر قيد السداد، والمتبقي منها %(out).2f. لا "
"يزال بالإمكان اعتماد هذا الطلب، لكن يجب على %(role)s الضغط على '⚠ قبول القرض"
" المتزامن' أولا ليسجل القرار."

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/ksw_deduction.py:0
msgid ""
"%(emp)s has no other personal loan in progress — there is nothing to accept."
msgstr "ليس لدى %(emp)s قرض شخصي آخر قيد السداد — لا يوجد ما يقبل."

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/ksw_deduction.py:0
msgid ""
"%(name)s can no longer be deleted. You may delete your own request only "
"while it is still waiting for the first approval — afterwards use Cancel, "
"which keeps a trace of the request."
msgstr ""
"لم يعد بالإمكان حذف %(name)s. يمكنك حذف طلبك فقط ما دام بانتظار الاعتماد "
"الأول — بعد ذلك استخدم الإلغاء، الذي يحتفظ بأثر الطلب."

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/ksw_deduction.py:0
msgid ""
"%(name)s can no longer be edited. A request can only be changed by the "
"employee who raised it, and only while it is still waiting for the first "
"approval."
msgstr ""
"لم يعد بالإمكان تعديل %(name)s. لا يمكن تغيير الطلب إلا من الموظف الذي قدمه،"
" وفقط ما دام بانتظار الاعتماد الأول."

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/hr_payslip.py:0
msgid ""
"%(type)s [%(ref)s] inst %(n)s/%(total)s — already collected in %(slip)s"
msgstr ""
"%(type)s [%(ref)s] القسط %(n)s/%(total)s — تم تحصيله بالفعل في %(slip)s"

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/ksw_deduction.py:0
msgid ""
"%(type)s deductions are a single installment. A system administrator can "
"unlock this on the deduction type."
msgstr ""
"خصومات %(type)s تكون بقسط واحد. يمكن لمدير النظام إلغاء هذا القيد من نوع "
"الخصم."

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/wizard/ksw_deduction_statement_wizard.py:0
msgid "%(type)s granted — %(n)s installment(s)"
msgstr "تم منح %(type)s — %(n)s قسط"

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/ksw_deduction.py:0
msgid ""
"'%(type)s' deductions are handled by the Accounting Data Entry team. Ask an "
"administrator to grant you Settings → Users → Access Rights → KSW Deductions"
" → Deduction Management = Accounting Data Entry (Non-Loan)."
msgstr ""
"خصومات '%(type)s' يتولاها فريق إدخال بيانات المحاسبة. اطلب من مدير النظام "
"منحك الإعدادات ← المستخدمون ← صلاحيات الوصول ← خصومات KSW ← إدارة الخصومات ="
" إدخال بيانات المحاسبة (غير القروض)."

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/ksw_deduction.py:0
msgid ""
"'%(type)s' deductions are handled by the Officer / Accounting (Loans) team. "
"Ask an administrator to grant you Settings → Users → Access Rights → KSW "
"Deductions → Deduction Management = Officer, or Loan Modification = Full."
msgstr ""
"خصومات '%(type)s' يتولاها فريق المسؤول / المحاسبة (القروض). اطلب من مدير "
"النظام منحك الإعدادات ← المستخدمون ← صلاحيات الوصول ← خصومات KSW ← إدارة "
"الخصومات = مسؤول، أو تعديل القروض = كامل."

#. module: KSW_deduction
#: model:ir.actions.report,print_report_name:KSW_deduction.action_report_deduction_statement
msgid ""
"'Statement of Account - %s - %s' % (object.employee_id.name or '', "
"object.date_to)"
msgstr ""
"'كشف حساب - %s - %s' % (object.employee_id.name or '', object.date_to)"

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.report_deduction_statement
msgid ""
".\n"
"                            Balances are stated as at"
msgstr ""
".\n"
"                            الأرصدة كما في"

