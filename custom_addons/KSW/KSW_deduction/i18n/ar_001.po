msgstr "أنت تطلب"

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.view_ksw_loan_return_approver_wizard_form
msgid ""
"You are returning this request as a Deduction\n"
"                            Manager. Only the steps the request has already\n"
"                            passed are listed. Everything the approvers\n"
"                            entered is kept — only the stamps from the step\n"
"                            you pick onward are cleared."
msgstr ""
"أنت تعيد هذا الطلب بصفتك مدير\n"
"                            الخصومات. تعرض فقط الخطوات التي اجتازها\n"
"                            الطلب. يحتفظ بكل ما أدخله\n"
"                            المعتمدون — وتمسح فقط الأختام من الخطوة\n"
"                            التي تختارها فما بعدها."

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/wizard/loan_request_wizard.py:0
