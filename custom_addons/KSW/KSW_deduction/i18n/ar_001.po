#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.hr_leave_view_form_inherit_ksw_deduction_picture
msgid ""
"<strong>The payslip cannot cover every deduction.</strong>\n"
"                    The full amount is shown so the employee's position is\n"
"                    visible, which is why the net may be negative. Only the\n"
"                    <em>Collected by the Payslip</em> part is settled as paid —\n"
"                    the rest stays <strong>pending</strong> and is collected by\n"
"                    a later payroll run."
msgstr ""
"<strong>لا يغطي كشف الراتب جميع الخصومات.</strong>\n"
"                    يعرض المبلغ الكامل لإظهار وضع الموظف،\n"
"                    ولهذا قد يكون الصافي سالبا. يسوى كمدفوع فقط\n"
"                    الجزء <em>المحصل بكشف الراتب</em> —\n"
"                    ويبقى الباقي <strong>معلقا</strong> ويحصل في\n"
"                    دورة رواتب لاحقة."

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_loan_refuse_wizard_form
msgid "<strong>You are about to refuse this loan request.</strong>"
msgstr "<strong>أنت على وشك رفض طلب القرض هذا.</strong>"

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_deduction_view_form
msgid ""
"<strong>You can still change this request.</strong>\n"
"                        The amount, installments, start month and\n"
"                        justification stay editable, and you can delete the\n"
"                        request entirely, until the first approver acts on\n"
"                        it. After that, use <b>Cancel</b> — it keeps a trace\n"
"                        of the request."
msgstr ""
"<strong>لا يزال بإمكانك تغيير هذا الطلب.</strong>\n"
"                        يبقى المبلغ والأقساط وشهر البداية\n"
"                        والمبرر قابلة للتعديل، ويمكنك حذف\n"
"                        الطلب كليا، حتى يتخذ المعتمد الأول إجراء\n"
"                        عليه. بعد ذلك استخدم <b>إلغاء</b> — فهو يحتفظ بأثر\n"
"                        الطلب."

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_deduction_view_form
msgid "<strong>⚠️ This employee already has another personal loan</strong>"
msgstr "<strong>⚠️ لدى هذا الموظف قرض شخصي آخر بالفعل</strong>"

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_deduction_view_form
msgid "<strong>⛔ Loan Request Refused</strong>"
msgstr "<strong>⛔ تم رفض طلب القرض</strong>"

#. module: KSW_deduction
#: model:ir.model.fields,help:KSW_deduction.field_ksw_loan_refuse_wizard__reason
msgid ""
"A clear, factual explanation of why this loan request is being refused. This"
" will be visible to the employee on the loan form and recorded in the "
"chatter history."
msgstr ""
"شرح واضح وموضوعي لسبب رفض طلب القرض هذا. سيكون مرئيا للموظف على نموذج القرض "
"ومسجلا في سجل المحادثات."

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/models/ksw_deduction.py:0
#: code:addons/KSW_deduction/wizard/loan_refuse_wizard.py:0
msgid "A refusal reason is required."
msgstr "سبب الرفض مطلوب."

#. module: KSW_deduction
#. odoo-python
#: code:addons/KSW_deduction/wizard/ksw_deduction_reschedule_wizard.py:0
msgid ""
"A repayment plan cannot exceed 120 months — you entered %(n)d. Check the "
"monthly amount."
msgstr ""
