"                                <span class=\"badge text-bg-secondary mx-1\">2. الموارد البشرية</span>\n"
"                                <i class=\"fa fa-angle-right mx-1\" title=\"ثم\" role=\"img\" aria-hidden=\"true\"/>\n"
"                                <span class=\"badge text-bg-secondary mx-1\">3. المحاسبة</span>\n"
"                                <i class=\"fa fa-angle-right mx-1\" title=\"ثم\" role=\"img\" aria-hidden=\"true\"/>\n"
"                                <span class=\"badge text-bg-secondary mx-1\">4. المدير العام</span>.\n"
"                                تابع التقدم من <b>قروضي</b>."

