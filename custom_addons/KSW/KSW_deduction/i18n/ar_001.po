"<br/>Later installments keep their original\n"
"                                amounts and dates."
msgstr ""
"<br/>تحتفظ الأقساط اللاحقة بمبالغها\n"
"                                وتواريخها الأصلية."

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_loan_refuse_wizard_form
msgid ""
"<i class=\"fa fa-ban fa-lg me-2 mt-1\" title=\"Refuse\" role=\"img\" aria-"
"label=\"Refuse\"/>"
msgstr ""
"<i class=\"fa fa-ban fa-lg me-2 mt-1\" title=\"رفض\" role=\"img\" aria-"
"label=\"رفض\"/>"

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_loan_payment_wizard_view_form
msgid ""
"<i class=\"fa fa-check-circle me-1\"/>\n"
"                                <strong>Full payment</strong> — all"
msgstr ""
"<i class=\"fa fa-check-circle me-1\"/>\n"
"                                <strong>سداد كامل</strong> — جميع"

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.view_ksw_loan_request_wizard_form
msgid ""
"<i class=\"fa fa-info-circle fa-lg me-2 mt-1\" title=\"Info\" role=\"img\" "
"aria-label=\"Info\"/>"
msgstr ""
"<i class=\"fa fa-info-circle fa-lg me-2 mt-1\" title=\"معلومة\" role=\"img\""
" aria-label=\"معلومة\"/>"

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_deduction_reschedule_wizard_view_form
msgid ""
"<i class=\"fa fa-info-circle me-1\" title=\"Info\" role=\"img\" aria-label=\"Info\"/>\n"
"                        Only the <b>outstanding</b> balance is re-spread.\n"
"                        Installments already collected stay exactly as they\n"
"                        are, and the total amount of each deduction does not\n"
"                        change — this changes the plan, not the debt."
msgstr ""
"<i class=\"fa fa-info-circle me-1\" title=\"معلومة\" role=\"img\" aria-label=\"معلومة\"/>\n"
"                        يعاد توزيع الرصيد <b>المتبقي</b> فقط.\n"
"                        تبقى الأقساط المحصلة كما هي تماما،\n"
"                        ولا يتغير المبلغ الإجمالي لأي خصم\n"
"                        — هذا يغير الخطة، لا الدين."

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_loan_payment_wizard_view_form
msgid ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                <strong>Redistribute</strong> — remaining"
msgstr ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                <strong>إعادة التوزيع</strong> — المتبقي"

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_loan_payment_wizard_view_form
msgid ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                <strong>Settle earliest first</strong> —"
msgstr ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                <strong>تسوية الأقدم أولا</strong> —"

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_deduction_view_form
msgid ""
"<i class=\"fa fa-info-circle\" title=\"Info\" role=\"img\" aria-label=\"Info\"/>\n"
"                                <b class=\"ms-1\">Tip</b> — type an optional\n"
"                                note in the <i>Note</i> column, then click\n"
"                                <b>Mark Paid</b> on the row to record a\n"
"                                payment settled <b>outside payroll</b>.\n"
"                                Use <i>Add a line</i> only for partial or\n"
"                                split payments that don't match a scheduled\n"
"                                installment."
msgstr ""
"<i class=\"fa fa-info-circle\" title=\"معلومة\" role=\"img\" aria-label=\"معلومة\"/>\n"
"                                <b class=\"ms-1\">تلميح</b> — اكتب ملاحظة\n"
"                                اختيارية في عمود <i>الملاحظة</i>، ثم اضغط\n"
"                                <b>تحديد كمسدد</b> في الصف لتسجيل\n"
"                                سداد تم <b>خارج الرواتب</b>.\n"
"                                استخدم <i>إضافة بند</i> فقط للسداد الجزئي\n"
"                                أو المجزأ الذي لا يطابق قسطا\n"
"                                مجدولا."

#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.ksw_deduction_reschedule_wizard_view_form
msgid ""
"<i class=\"fa fa-lightbulb-o me-1\" title=\"Tip\" role=\"img\" aria-label=\"Tip\"/>\n"
"                            A monthly figure is a decision about the\n"
"                            <b>employee</b>, not about one contract. Leave\n"
"                            these selected to bring the whole outstanding book\n"
"                            down to a single monthly total; each deduction\n"
"                            still keeps its own reference and ledger."
msgstr ""
"<i class=\"fa fa-lightbulb-o me-1\" title=\"تلميح\" role=\"img\" aria-label=\"تلميح\"/>\n"
"                            المبلغ الشهري قرار يخص\n"
"                            <b>الموظف</b>، لا عقدا بعينه. اترك\n"
"                            هذه محددة لخفض كامل الرصيد المتبقي\n"
"                            إلى إجمالي شهري واحد؛ ويحتفظ كل خصم\n"
"                            بمرجعه وسجله الخاص."

