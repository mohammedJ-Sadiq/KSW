#. module: KSW_deduction
#: model_terms:ir.ui.view,arch_db:KSW_deduction.view_hr_payslip_form_inherit_ksw_deduction_coverage
msgid ""
"<strong>Deductions exceed this payslip.</strong>\n"
"                    The full outstanding amount is shown below for review.\n"
"                    Only the part marked <em>Collected by This Payslip</em>\n"
"                    is settled as paid — the rest stays\n"
"                    <strong>pending</strong> on the deduction schedule and is\n"
"                    collected by a later payroll run."
msgstr ""
"<strong>الخصومات تتجاوز كشف الراتب هذا.</strong>\n"
"                    يعرض المبلغ المتبقي كاملا أدناه للمراجعة.\n"
"                    يسوى كمدفوع فقط الجزء المحدد ب <em>المحصل بكشف الراتب هذا</em>\n"
"                    — ويبقى الباقي\n"
"                    <strong>معلقا</strong> في جدول الخصم\n"
"                    ويحصل في دورة رواتب لاحقة."

