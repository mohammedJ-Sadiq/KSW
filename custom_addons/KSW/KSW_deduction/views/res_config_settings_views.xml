<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_ksw_deduction" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ksw.deduction</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="KSW_payroll.res_config_settings_view_form_ksw_payroll"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='ksw_gosi_settings']" position="after">
                <h2>Payslip Revisions</h2>
                <div class="row mt16 o_settings_container" id="ksw_revision_settings">
                    <div class="col-lg-6 col-12 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="ksw_overpay_recovery_type_id"/>
                            <div class="text-muted">
                                When a revision shows the employee was over-paid it cannot
                                be confirmed. It is cancelled instead, and a draft deduction
                                of this type is opened for the difference so it is recovered
                                from a later payroll run.
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="ksw_overpay_recovery_type_id"
                                           class="o_light_label"
                                           options="{'no_create': True, 'no_open': True}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
