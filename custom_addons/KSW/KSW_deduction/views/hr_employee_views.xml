<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit_ksw_deduction" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.ksw.deduction</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_deductions" icon="fa-money"
                        groups="hr.group_hr_user">
                    <field name="x_deduction_count" widget="statinfo"
                           string="Deductions"/>
                </button>
                <!-- Next to the count, the account behind it. `type="action"`
                     passes active_id; the wizard's default_get reads it to
                     preselect this employee. -->
                <button class="oe_stat_button" type="action"
                        name="%(KSW_deduction.action_ksw_deduction_statement)d"
                        icon="fa-list-alt"
                        groups="KSW_deduction.group_deduction_officer,KSW_deduction.group_acc_data_entry,KSW_deduction.group_loan_hr,KSW_deduction.group_loan_acc,KSW_deduction.group_loan_gm,KSW_deduction.group_installment_edit">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Statement</span>
                        <span class="o_stat_text">of Account</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <separator string="Loans"/>
                <group>
                    <field name="x_loan_acc_no" groups="hr.group_hr_user"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_employee_filter_add_loan_acc_no" model="ir.ui.view">
        <field name="name">hr.employee.search.loan.acc.no</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="KSW_base_security.view_employee_filter_add_ssnid"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="filter_domain">['|', '|', '|', '|', ('work_email', 'ilike', self), ('name', 'ilike', self), ('ssnid', 'ilike', self), ('x_employee_no', 'ilike', self), ('x_loan_acc_no', 'ilike', self)]</attribute>
            </field>
            <field name="ssnid" position="after">
                <field name="x_employee_no" string="Employee No."
                       groups="hr.group_hr_user"/>
                <field name="x_loan_acc_no" string="Loan Acc No. in Bas"
                       groups="hr.group_hr_user"/>
            </field>
        </field>
    </record>

</odoo>

