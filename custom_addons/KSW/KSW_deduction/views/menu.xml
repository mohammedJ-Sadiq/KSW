<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Top-level app menu                                             -->
    <!-- ============================================================ -->
    <menuitem id="menu_ksw_deduction_root"
              name="Deductions"
              sequence="90"
              web_icon="KSW_deduction,static/description/icon.png"/>

    <!-- ============================================================ -->
    <!-- 1. Dashboard (officers + approvers + supervisors)              -->
    <!-- ============================================================ -->
    <menuitem id="menu_ksw_deduction_dashboard"
              name="Dashboard"
              parent="menu_ksw_deduction_root"
              action="action_ksw_deduction_dashboard"
              sequence="1"
              groups="KSW_deduction.group_deduction_officer,KSW_deduction.group_deduction_supervisor,KSW_deduction.group_acc_data_entry,KSW_deduction.group_loan_hr,KSW_deduction.group_loan_acc,KSW_deduction.group_loan_gm"/>

    <!-- ============================================================ -->
    <!-- 2. Self-Service (every internal user)                          -->
    <!-- ============================================================ -->
    <!--
        Sequence=5 so plain users (who only see Self-Service) land on
        "My Loans" when clicking the root menu. Officers/approvers land
        on Dashboard (seq=1) first.
    -->
    <menuitem id="menu_ksw_deduction_self_service"
              name="Self-Service"
              parent="menu_ksw_deduction_root"
              sequence="5"/>

    <menuitem id="menu_ksw_my_loans"
              name="My Loans"
              parent="menu_ksw_deduction_self_service"
              action="action_ksw_my_loans"
              sequence="10"/>

    <menuitem id="menu_ksw_loan_request"
              name="Request a Loan"
              parent="menu_ksw_deduction_self_service"
              action="action_ksw_loan_request"
              sequence="20"/>

    <!-- Every deduction taken off my salary, not just my loans. -->
    <menuitem id="menu_ksw_my_deductions"
              name="My Deductions"
              parent="menu_ksw_deduction_self_service"
              action="action_ksw_my_deductions"
              sequence="30"/>

    <!-- ============================================================ -->
    <!-- 3. Operations (officers + approvers + supervisors)             -->
    <!-- ============================================================ -->
    <menuitem id="menu_ksw_deduction_operations"
              name="Operations"
              parent="menu_ksw_deduction_root"
              sequence="10"
              groups="KSW_deduction.group_deduction_officer,KSW_deduction.group_deduction_supervisor,KSW_deduction.group_acc_data_entry,KSW_deduction.group_loan_hr,KSW_deduction.group_loan_acc,KSW_deduction.group_loan_gm,KSW_base_security.group_manager_assistant"/>

    <menuitem id="menu_ksw_deduction_all"
              name="All Deductions"
              parent="menu_ksw_deduction_operations"
              action="action_ksw_deduction_all"
              sequence="10"
              groups="KSW_deduction.group_deduction_officer"/>

    <!-- Loans: officers, loan approvers, and supervisors (record rule limits
         supervisors to their own + subordinates scope automatically) -->
    <menuitem id="menu_ksw_deduction_loans"
              name="Loans"
              parent="menu_ksw_deduction_operations"
              action="action_ksw_deduction_loans"
              sequence="20"
              groups="KSW_deduction.group_deduction_officer,KSW_deduction.group_deduction_supervisor,KSW_deduction.group_loan_hr,KSW_deduction.group_loan_acc,KSW_deduction.group_loan_gm,KSW_base_security.group_manager_assistant"/>

    <!-- Accounting data entry: single consolidated view of the non-loan
         deductions they own (mirrors "Loans" for approvers) -->
    <menuitem id="menu_ksw_deduction_acc_data_entry"
              name="Deductions"
              parent="menu_ksw_deduction_operations"
              action="action_ksw_deduction_acc_data_entry"
              sequence="20"
              groups="KSW_deduction.group_acc_data_entry"/>

    <!-- ============================================================ -->
    <!-- 5. Reports (officers + approvers + supervisors)                -->
    <!-- ============================================================ -->
    <!--
        A child menu's EFFECTIVE groups are the intersection of its own and
        every ancestor's: `_visible_menu_ids` stops walking upward at a
        parent the user cannot see, and the child is silently orphaned with
        nothing in the data or the logs to say so. `group_installment_edit`
        (accounting, "Loan Modification: Full") and `group_loan_disbursement`
        imply none of the groups previously listed here, so the Statement of
        Account below could not have reached them. Widened here rather than
        narrowing the statement, because both roles work with deductions
        daily and belong in Reports on their own merits.
    -->
    <menuitem id="menu_ksw_deduction_reports"
              name="Reports"
              parent="menu_ksw_deduction_root"
              sequence="30"
              groups="KSW_deduction.group_deduction_officer,KSW_deduction.group_deduction_supervisor,KSW_deduction.group_acc_data_entry,KSW_deduction.group_loan_hr,KSW_deduction.group_loan_acc,KSW_deduction.group_loan_gm,KSW_deduction.group_installment_edit,KSW_deduction.group_loan_disbursement"/>

    <menuitem id="menu_ksw_deduction_report_by_employee"
              name="By Employee"
              parent="menu_ksw_deduction_reports"
              action="action_ksw_deduction_report_by_employee"
              sequence="10"/>

    <menuitem id="menu_ksw_deduction_report_by_department"
              name="By Department"
              parent="menu_ksw_deduction_reports"
              action="action_ksw_deduction_report_by_department"
              sequence="20"/>

    <menuitem id="menu_ksw_deduction_report_by_type"
              name="By Type"
              parent="menu_ksw_deduction_reports"
              action="action_ksw_deduction_report_by_type"
              sequence="30"/>

    <menuitem id="menu_ksw_deduction_installment_schedule"
              name="Installment Schedule"
              parent="menu_ksw_deduction_reports"
              action="action_ksw_deduction_installment_schedule"
              sequence="40"/>

    <!-- Every group here is also on the parent, or the item is orphaned.
         Supervisors are deliberately left out: the statement is an
         accounting/HR document. Adding group_deduction_supervisor later
         needs no other change — the record rules already scope them to
         their own reports. -->
    <menuitem id="menu_ksw_deduction_statement"
              name="Statement of Account"
              parent="menu_ksw_deduction_reports"
              action="action_ksw_deduction_statement"
              sequence="50"
              groups="KSW_deduction.group_deduction_officer,KSW_deduction.group_acc_data_entry,KSW_deduction.group_loan_hr,KSW_deduction.group_loan_acc,KSW_deduction.group_loan_gm,KSW_deduction.group_installment_edit"/>

    <!-- ============================================================ -->
    <!-- 6. Configuration (managers only)                               -->
    <!-- ============================================================ -->
    <menuitem id="menu_ksw_deduction_config"
              name="Configuration"
              parent="menu_ksw_deduction_root"
              sequence="90"
              groups="KSW_deduction.group_deduction_manager"/>

    <menuitem id="menu_ksw_deduction_types"
              name="Deduction Types"
              parent="menu_ksw_deduction_config"
              action="action_ksw_deduction_type"
              sequence="10"/>

</odoo>
