<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Optional per-driver narrowing. Maintained by dispatch rather than HR,
         so the gate is this view's groups= and not a model-level one. -->
    <record id="view_employee_form_water_clients" model="ir.ui.view">
        <field name="name">hr.employee.form.water.clients</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- The employee's cost centre is an HR fact (payroll will use it
                 too), so it sits on HR Settings, not on the Water tab. -->
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="Accounting" name="ksw_cost_centre">
                    <field name="x_analytic_account_id" options="{'no_create': True}"
                           placeholder="His own cost centre (Employee Cost Centre)"/>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="water_delivery" string="Water Delivery"
                      groups="KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_billing,hr.group_hr_manager">
                    <group>
                        <field name="x_water_client_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               context="{'res_partner_search_mode': 'customer'}"
                               placeholder="Leave empty to use the branch's client list"/>
                    </group>
                    <group string="Supervisor" groups="hr.group_hr_manager">
                        <field name="x_water_tanker_group_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Tanker groups this supervisor looks after"/>
                    </group>
                    <div class="text-muted">
                        Leave this empty and the driver sees every client his
                        branch serves. Fill it in to narrow him to these clients
                        only — he can still reach the others by ticking
                        <b>Client not listed</b>, which marks the note as off
                        the usual route.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
