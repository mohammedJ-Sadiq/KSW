<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A top-level app of its own: a driver's phone should open on this and
         nothing else. Note every menuitem below repeats parent= and name=
         (KSW gotcha #1). -->
    <!-- What the app opens on. Without it Odoo opens the first child, New
         Delivery: a dialog (target new) over an empty page, full screen on a
         phone, so a supervisor never saw the menu bar behind it. A driver
         goes to the driver app (/water/, online and offline in one); anyone
         who oversees lands in the notes list with the whole menu. -->
    <record id="action_water_delivery_home" model="ir.actions.server">
        <field name="name">Water Delivery</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(6, 0, [ref('KSW_water_delivery.group_water_driver'), ref('KSW_water_delivery.group_water_dispatcher'), ref('KSW_water_delivery.group_water_billing')])]"/>
        <field name="code">
oversees = (env.user.has_group('KSW_water_delivery.group_water_dispatcher')
            or env.user.has_group('KSW_water_delivery.group_water_billing'))
if oversees:
    action = env['ir.actions.act_window']._for_xml_id(
        'KSW_water_delivery.action_water_delivery_all_notes')
else:
    action = env['ir.actions.act_url']._for_xml_id(
        'KSW_water_delivery.action_water_driver_app')
        </field>
    </record>

    <menuitem id="menu_water_delivery_root"
              name="Water Delivery"
              action="action_water_delivery_home"
              web_icon="KSW_water_delivery,static/description/icon.png"
              sequence="47"
              groups="KSW_water_delivery.group_water_driver,KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_billing"/>

    <menuitem id="menu_water_delivery_new"
              name="New Delivery"
              parent="menu_water_delivery_root"
              action="action_water_driver_app"
              sequence="10"
              groups="KSW_water_delivery.group_water_driver"/>

    <menuitem id="menu_water_delivery_my_notes"
              name="My Deliveries"
              parent="menu_water_delivery_root"
              action="action_water_delivery_my_notes"
              sequence="20"
              groups="KSW_water_delivery.group_water_driver"/>

    <menuitem id="menu_water_delivery_all_notes"
              name="Delivery Notes"
              parent="menu_water_delivery_root"
              action="action_water_delivery_all_notes"
              sequence="30"
              groups="KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_billing"/>

    <!-- The dispatcher's queue. Sits next to the notes rather than under
         Configuration, because it is day-to-day work: a held delivery is one
         a driver has already made. -->
    <menuitem id="menu_water_delivery_captures"
              name="App Deliveries"
              parent="menu_water_delivery_root"
              action="action_water_captures"
              sequence="40"
              groups="KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_billing"/>

    <!-- Also day-to-day work: under the enforce rule a client with no
         approved location cannot receive a note, so a pending one is a
         driver waiting to deliver. -->
    <menuitem id="menu_water_delivery_locations"
              name="Client Locations"
              parent="menu_water_delivery_root"
              action="action_water_location_requests"
              sequence="45"
              groups="KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_billing"/>

    <!-- Who drives which tanker. The app fetches the tanker from here and
         never lets the driver choose, so this is dispatch's daily lever. -->
    <menuitem id="menu_water_delivery_tankers"
              name="Fleet Management"
              parent="menu_water_delivery_root"
              action="action_water_tankers"
              sequence="47"
              groups="KSW_water_delivery.group_water_dispatcher"/>

    <!-- Month end. -->
    <menuitem id="menu_water_delivery_invoice"
              name="Invoice Delivery Notes"
              parent="menu_water_delivery_root"
              action="action_water_invoice_wizard"
              sequence="50"
              groups="KSW_water_delivery.group_water_billing"/>

    <menuitem id="menu_water_delivery_config"
              name="Configuration"
              parent="menu_water_delivery_root"
              sequence="90"
              groups="KSW_water_delivery.group_water_billing"/>

    <menuitem id="menu_water_delivery_rates"
              name="Client Rates"
              parent="menu_water_delivery_config"
              action="action_water_rates"
              sequence="10"
              groups="KSW_water_delivery.group_water_billing"/>

    <menuitem id="menu_water_delivery_revenue_accounts"
              name="Revenue Accounts"
              parent="menu_water_delivery_config"
              action="action_water_revenue_accounts"
              sequence="15"
              groups="KSW_water_delivery.group_water_billing"/>

    <menuitem id="menu_water_delivery_branch_clients"
              name="Branch Clients"
              parent="menu_water_delivery_config"
              action="action_water_client_branches"
              sequence="20"
              groups="KSW_water_delivery.group_water_billing"/>

</odoo>
