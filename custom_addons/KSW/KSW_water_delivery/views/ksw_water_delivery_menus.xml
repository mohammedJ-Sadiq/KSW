<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A top-level app of its own: a driver's phone should open on this and
         nothing else. Note every menuitem below repeats parent= and name=
         (KSW gotcha #1). -->
    <!-- What the app opens on. Without it Odoo opens the first child, New
         Delivery: a dialog (target new) over an empty page, full screen on a
         phone, so a supervisor never saw the menu bar behind it. A driver
         goes to the driver app (/water/, online and offline in one); anyone
         who oversees lands in the notes list with the whole menu. -->
    <record id="action_water_delivery_home" model="ir.actions.server">
        <field name="name">Water Delivery</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(6, 0, [ref('KSW_water_delivery.group_water_driver'), ref('KSW_water_delivery.group_water_dispatcher'), ref('KSW_water_delivery.group_water_billing'), ref('KSW_water_delivery.group_water_dispatch')])]"/>
        <field name="code">
oversees = (env.user.has_group('KSW_water_delivery.group_water_dispatcher')
            or env.user.has_group('KSW_water_delivery.group_water_billing'))
# Supervisor and General Manager include Dispatcher (Oct 2026), so whoever
# oversees is asked first: only a pure Dispatcher opens on his dispatches.
if oversees:
    action = env['ir.actions.act_window']._for_xml_id(
        'KSW_water_delivery.action_water_delivery_all_notes')
elif env.user.has_group('KSW_water_delivery.group_water_dispatch'):
    action = env['ir.actions.act_window']._for_xml_id(
        'KSW_water_delivery.action_water_dispatches')
else:
    action = env['ir.actions.act_url']._for_xml_id(
        'KSW_water_delivery.action_water_driver_app')
        </field>
    </record>

    <menuitem id="menu_water_delivery_root"
              name="Water Delivery"
              action="action_water_delivery_home"
              web_icon="KSW_water_delivery,static/description/icon.png"
              sequence="47"
              groups="KSW_water_delivery.group_water_driver,KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_billing,KSW_water_delivery.group_water_dispatch,KSW_water_delivery.group_water_gm"/>

    <menuitem id="menu_water_delivery_new"
              name="New Delivery"
              parent="menu_water_delivery_root"
              action="action_water_driver_app"
              sequence="10"
              groups="KSW_water_delivery.group_water_driver"/>

    <menuitem id="menu_water_delivery_my_notes"
              name="My Deliveries"
              parent="menu_water_delivery_root"
              action="action_water_delivery_my_notes"
              sequence="20"
              groups="KSW_water_delivery.group_water_driver"/>

    <!-- The overseers' work in two dropdowns, so the bar reads
         New Delivery / My Deliveries for a driver and Operations / Clients /
         Invoice / Configuration for everyone else. The headers carry no
         groups= of their own: a folder menu shows while any child is
         visible, so it can never orphan an item (gotcha #41). -->
    <menuitem id="menu_water_delivery_operations"
              name="Operations"
              parent="menu_water_delivery_root"
              sequence="30"/>

    <menuitem id="menu_water_delivery_clients"
              name="Clients"
              parent="menu_water_delivery_root"
              sequence="40"/>

    <!-- Only does anything on a branch switched to dispatch mode. -->
    <menuitem id="menu_water_delivery_dispatches"
              name="Dispatches"
              parent="menu_water_delivery_operations"
              action="action_water_dispatches"
              sequence="10"
              groups="KSW_water_delivery.group_water_dispatch,KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_gm"/>

    <menuitem id="menu_water_delivery_all_notes"
              name="Delivery Notes"
              parent="menu_water_delivery_operations"
              action="action_water_delivery_all_notes"
              sequence="20"
              groups="KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_billing,KSW_water_delivery.group_water_gm"/>

    <!-- The dispatcher's queue. Sits next to the notes rather than under
         Configuration, because it is day-to-day work: a held delivery is one
         a driver has already made. -->
    <menuitem id="menu_water_delivery_captures"
              name="App Deliveries"
              parent="menu_water_delivery_operations"
              action="action_water_captures"
              sequence="30"
              groups="KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_billing,KSW_water_delivery.group_water_gm"/>

    <!-- Also day-to-day work: under the enforce rule a client with no
         approved location cannot receive a note, so a pending one is a
         driver waiting to deliver. -->
    <menuitem id="menu_water_delivery_locations"
              name="Client Locations"
              parent="menu_water_delivery_clients"
              action="action_water_location_requests"
              sequence="10"
              groups="KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_billing,KSW_water_delivery.group_water_gm"/>

    <!-- Who drives which tanker. The app fetches the tanker from here and
         never lets the driver choose, so this is dispatch's daily lever. -->
    <menuitem id="menu_water_delivery_tankers"
              name="Fleet Management"
              parent="menu_water_delivery_operations"
              action="action_water_tankers"
              sequence="40"
              groups="KSW_water_delivery.group_water_dispatcher,KSW_water_delivery.group_water_gm"/>

    <!-- Month end. -->
    <!-- Billing is accounting work: it lives with customer invoices (Oct
         2026; it used to be on the Water Delivery bar). The Billing role
         includes Accounting's Invoicing for this. -->
    <menuitem id="menu_water_delivery_invoice"
              name="Invoice Delivery Notes"
              parent="account.menu_finance_receivables"
              action="action_water_invoice_wizard"
              sequence="5"
              groups="KSW_water_delivery.group_water_billing"/>

    <!-- base.group_system too: Branches below is the administrator's, and a
         child under a narrower parent is orphaned (KSW gotcha #41). -->
    <menuitem id="menu_water_delivery_config"
              name="Configuration"
              parent="menu_water_delivery_root"
              sequence="90"
              groups="KSW_water_delivery.group_water_billing,base.group_system,KSW_water_delivery.group_water_gm"/>

    <!-- Per branch: who starts a delivery (driver, or dispatcher) and who
         dispatches. The switch for the dispatch sequence. -->
    <menuitem id="menu_water_delivery_branches"
              name="Branches"
              parent="menu_water_delivery_config"
              action="action_water_branches"
              sequence="5"
              groups="base.group_system"/>

    <menuitem id="menu_water_delivery_rates"
              name="Client Rates"
              parent="menu_water_delivery_config"
              action="action_water_rates"
              sequence="10"
              groups="KSW_water_delivery.group_water_billing,KSW_water_delivery.group_water_gm"/>

    <!-- Revenue determination belongs to the chart of accounts (SAP VKOA,
         Oracle AutoAccounting): Accounting > Configuration > Accounting. -->
    <menuitem id="menu_water_delivery_revenue_accounts"
              name="Revenue Account Determination"
              parent="account.account_account_menu"
              action="action_water_revenue_accounts"
              sequence="40"
              groups="-KSW_water_delivery.group_water_billing,account.group_account_manager"/>

    <menuitem id="menu_water_delivery_branch_clients"
              name="Branch Clients"
              parent="menu_water_delivery_config"
              action="action_water_client_branches"
              sequence="20"
              groups="KSW_water_delivery.group_water_billing,KSW_water_delivery.group_water_gm"/>

</odoo>
