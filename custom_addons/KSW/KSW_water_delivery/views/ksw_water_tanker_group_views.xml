<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kept by the Employees Administrator (Employees > Configuration):
         which tankers each supervisor looks after. -->
    <record id="view_water_tanker_group_list" model="ir.ui.view">
        <field name="name">ksw.water.tanker.group.list</field>
        <field name="model">ksw.water.tanker.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="vehicle_count"/>
                <field name="supervisor_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_water_tanker_group_form" model="ir.ui.view">
        <field name="name">ksw.water.tanker.group.form</field>
        <field name="model">ksw.water.tanker.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Trailers"/></h1>
                    </div>
                    <group>
                        <field name="supervisor_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page name="tankers" string="Tankers">
                            <field name="vehicle_ids" options="{'no_create': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="vehicle_type"/>
                                    <field name="plate_number"/>
                                    <field name="driver_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_water_tanker_group_search" model="ir.ui.view">
        <field name="name">ksw.water.tanker.group.search</field>
        <field name="model">ksw.water.tanker.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="supervisor_ids"/>
                <field name="vehicle_ids" string="Tanker"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_water_tanker_groups" model="ir.actions.act_window">
        <field name="name">Tanker Groups</field>
        <field name="res_model">ksw.water.tanker.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a tanker group</p>
            <p>Group the tankers (Trailers, Isuzu, Tanks...) and attach the
               supervisors who look after them. In Water Delivery > Fleet Management a
               supervisor sees only the tankers in his groups.</p>
        </field>
    </record>

    <!-- Repeats parent= and name= (KSW gotcha #1). The parent is gated to
         hr.group_hr_manager, and so is this item (gotcha #41). -->
    <menuitem id="menu_water_tanker_groups"
              name="Tanker Groups"
              parent="hr.menu_config_employee"
              action="action_water_tanker_groups"
              sequence="90"
              groups="hr.group_hr_manager"/>

</odoo>
