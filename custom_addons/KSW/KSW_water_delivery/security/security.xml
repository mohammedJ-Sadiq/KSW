<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_water_delivery" model="ir.module.category">
        <field name="name">KSW Water Delivery</field>
        <field name="sequence">210</field>
    </record>

    <!-- Two questions, not three (KSW standing rule: one question per role).
         Driving and billing are different jobs; dispatcher is the senior half
         of the driving one, so it sits in the same dropdown. -->
    <record id="privilege_water_delivery" model="res.groups.privilege">
        <field name="name">Water Delivery</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_water_delivery"/>
    </record>

    <record id="privilege_water_billing" model="res.groups.privilege">
        <field name="name">Water Delivery Billing</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_water_delivery"/>
    </record>

    <!-- Every group below implies base.group_user on purpose: issuing a note
         posts the signed PDF to the chatter, and mail.message create is gated
         on the internal-user group (KSW gotcha #11). -->
    <record id="group_water_driver" model="res.groups">
        <field name="name">Driver</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="privilege_water_delivery"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Issues delivery notes for his own trips and sees only those.</field>
    </record>

    <record id="group_water_dispatcher" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">2</field>
        <field name="privilege_id" ref="privilege_water_delivery"/>
        <!-- (6, 0, ...) and not (4, ...): it used to imply Driver as well, and an
             implication a file stops declaring lives on in the database (KSW
             gotcha #3). A supervisor reviews; he does not issue notes, so he
             must not inherit New Delivery / My Deliveries. -->
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Supervises the drivers: sees every delivery note, accepts offline deliveries, approves client locations, and assigns tankers and each driver's clients. Does not issue notes.</field>
    </record>

    <record id="group_water_billing" model="res.groups">
        <field name="name">Billing</field>
        <field name="sequence">1</field>
        <field name="privilege_id" ref="privilege_water_billing"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Reads every water delivery note for month-end invoicing. Does not issue or correct notes.</field>
    </record>

    <!-- Turn on the core "Signature" feature on delivery orders. This is the
         Inventory settings checkbox, which grants the group through
         base.group_user.implied_ids. A record override of another module's
         group is silently skipped on every upgrade after the first install
         (KSW gotcha #2); a function calls write() directly and is not. -->
    <function model="res.groups" name="write">
        <value eval="[ref('base.group_user')]"/>
        <value eval="{'implied_ids': [(4, ref('stock.group_stock_sign_delivery'))]}"/>
    </function>

    <!-- A driver sees his own notes and nothing else. -->
    <record id="rule_water_picking_driver" model="ir.rule">
        <field name="name">Water delivery notes: own only</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="groups" eval="[(4, ref('group_water_driver'))]"/>
        <field name="domain_force">[('x_driver_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- A supervisor sees his TEAM: drivers who report to him, directly or up
         to three levels down (hr.employee.parent_id). System administrators
         see every driver.

         Explicit levels rather than child_of on purpose: ir.rule domains are
         ormcached per user, and child_of on hr.employee (no parent_store) is
         resolved to a list of ids at that point, so a driver newly put under
         a supervisor would stay invisible until the cache happened to clear.
         A dotted path stays a live subquery. -->
    <record id="rule_water_picking_dispatcher" model="ir.rule">
        <field name="name">Water delivery notes: his team (supervisor)</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="groups" eval="[(4, ref('group_water_dispatcher'))]"/>
        <field name="domain_force">[('x_is_water_delivery', '=', True)] + ([(1, '=', 1)] if user.has_group('base.group_system') else ['|', '|', ('x_driver_id.parent_id.user_id', '=', user.id), ('x_driver_id.parent_id.parent_id.user_id', '=', user.id), ('x_driver_id.parent_id.parent_id.parent_id.user_id', '=', user.id)])</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- A driver sees what HIS phone sent, and nothing else. He needs to,
         because the app shows him what happened to each capture, but the
         queue of another driver's exceptions is not his business.

         Note the ACL gives him read only: a capture is created by the
         controller under sudo() after `_check_driver()`, the same shape as the
         wizard (which does the privileged work under sudo after checking
         authority once). Nothing a driver can call writes to this model. -->
    <record id="rule_water_capture_driver" model="ir.rule">
        <field name="name">Offline deliveries: own only</field>
        <field name="model_id" ref="model_ksw_water_capture"/>
        <field name="groups" eval="[(4, ref('group_water_driver'))]"/>
        <field name="domain_force">[('driver_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_water_capture_dispatcher" model="ir.rule">
        <field name="name">Offline deliveries: his team (supervisor)</field>
        <field name="model_id" ref="model_ksw_water_capture"/>
        <field name="groups" eval="[(4, ref('group_water_dispatcher'))]"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') else ['|', '|', ('driver_id.parent_id.user_id', '=', user.id), ('driver_id.parent_id.parent_id.user_id', '=', user.id), ('driver_id.parent_id.parent_id.parent_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Client locations his team's drivers sent. Billing has no rule on
         this model, so it keeps reading all of them. -->
    <record id="rule_water_location_request_dispatcher" model="ir.rule">
        <field name="name">Client locations: his team (supervisor)</field>
        <field name="model_id" ref="model_ksw_water_location_request"/>
        <field name="groups" eval="[(4, ref('group_water_dispatcher'))]"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') else ['|', '|', ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.parent_id.parent_id.user_id', '=', user.id), ('employee_id.parent_id.parent_id.parent_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_water_capture_billing" model="ir.rule">
        <field name="name">Offline deliveries: all (billing)</field>
        <field name="model_id" ref="model_ksw_water_capture"/>
        <field name="groups" eval="[(4, ref('group_water_billing'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_water_picking_billing" model="ir.rule">
        <field name="name">Water delivery notes: all (billing)</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="groups" eval="[(4, ref('group_water_billing'))]"/>
        <field name="domain_force">[('x_is_water_delivery', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
