<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="KSW_water_delivery.GeolocationWidget">
        <div class="o_ksw_geolocation w-100 mb-2">
            <div class="d-flex align-items-center gap-2 small">
                <span t-if="state.status === 'locating'" class="text-muted">
                    <i class="fa fa-spinner fa-spin me-1"/>
                    <t t-esc="state.message"/>
                </span>
                <span t-elif="state.status === 'located'" class="text-success">
                    <i class="fa fa-map-marker me-1"/>
                    <t t-esc="state.message"/>
                </span>
                <span t-else="" t-att-class="isRequired ? 'text-danger' : 'text-muted'">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <t t-esc="state.message"/>
                </span>
            </div>
            <div t-if="state.hint" class="small text-muted mt-1">
                <t t-esc="state.hint"/>
            </div>
            <!-- Always available, not only after a refusal: a tap carries a
                 user gesture, and iOS does not reliably raise the prompt for a
                 request made on page load. -->
            <button t-if="canRetry" type="button"
                    class="btn btn-secondary btn-sm mt-1" t-on-click="onRetry">
                <i class="fa fa-map-marker me-1"/>Record my location
            </button>
        </div>
    </t>

    <t t-name="KSW_water_delivery.ClientLocationPin">
        <div t-if="applies and (needsPin or isPending)" class="o_ksw_client_pin alert mb-2"
             t-att-class="isPending ? 'alert-info' : 'alert-warning'" role="alert">
            <t t-if="isPending">
                <i class="fa fa-clock-o me-1"/>
                Location sent: waiting for the office to approve it. You can issue a
                note for this client once it is approved.
            </t>
            <t t-else="">
                <div class="mb-2">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    This client has no approved location yet, so no note can be issued.
                </div>
                <button type="button" class="btn btn-primary"
                        t-att-disabled="state.busy" t-on-click="onSend">
                    <t t-if="state.busy">
                        <i class="fa fa-spinner fa-spin me-1"/>Getting an accurate fix<t t-if="state.accuracy"> (±<t t-esc="state.accuracy"/> m)</t>…
                    </t>
                    <t t-else="">
                        <i class="fa fa-map-marker me-1"/>Send my location for this client
                    </t>
                </button>
            </t>
        </div>
    </t>

</templates>
