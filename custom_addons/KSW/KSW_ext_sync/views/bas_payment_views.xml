<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bas_payment_list" model="ir.ui.view">
        <field name="name">ksw.bas.payment.list</field>
        <field name="model">ksw.bas.payment</field>
        <field name="arch" type="xml">
            <list string="BAS Payment Vouchers" default_order="payment_date desc">
                <field name="payment_date"/>
                <field name="number"/>
                <field name="branch_code"/>
                <field name="ftype"/>
                <field name="from_account"/>
                <field name="to_account"/>
                <field name="amount" sum="Total"/>
                <field name="pay_mode"/>
                <field name="remark"/>
                <field name="last_synced" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bas_payment_search" model="ir.ui.view">
        <field name="name">ksw.bas.payment.search</field>
        <field name="model">ksw.bas.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="number"/>
                <field name="from_account"/>
                <field name="to_account"/>
                <field name="remark"/>
                <filter name="receipts" string="Receipts" domain="[('ftype','=','Receipt')]"/>
                <filter name="payments_out" string="Payments" domain="[('ftype','=','Payment')]"/>
                <filter name="this_month" string="This Month"
                    domain="[('payment_date','&gt;=', (context_today()).strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter name="group_type" string="Type" domain="[]" context="{'group_by':'ftype'}"/>
                <filter name="group_branch" string="Branch" domain="[]" context="{'group_by':'branch_code'}"/>
                <filter name="group_month" string="Month" domain="[]" context="{'group_by':'payment_date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_bas_payment" model="ir.actions.act_window">
        <field name="name">BAS Payment Vouchers</field>
        <field name="res_model">ksw.bas.payment</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_bas_payment_search"/>
        <field name="context">{'search_default_this_month': 1}</field>
    </record>
</odoo>
