<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A section of Accounting, not an app of its own: these are read-only
         mirrors of BAS ledgers, and only the administrator opens them.
         Between Reporting (20) and Configuration (35). The menu's groups are
         the intersection with Accounting's (gotcha #41), which an
         administrator holds. -->
    <menuitem id="menu_bas_root"
        name="BAS Mirror"
        parent="account.menu_finance"
        sequence="30"
        groups="base.group_system"/>

    <menuitem id="menu_bas_accounts"
        name="Loans &amp; Advances"
        parent="menu_bas_root"
        action="action_bas_account"
        sequence="10"/>

    <menuitem id="menu_bas_customers"
        name="Customers"
        parent="menu_bas_root"
        action="action_bas_customer"
        sequence="5"/>

    <menuitem id="menu_bas_invoices"
        name="Sales Invoices"
        parent="menu_bas_root"
        action="action_bas_invoice"
        sequence="20"/>

    <menuitem id="menu_bas_payments"
        name="Payment Vouchers"
        parent="menu_bas_root"
        action="action_bas_payment"
        sequence="30"/>

    <menuitem id="menu_bas_ledger"
        name="Customer Ledger"
        parent="menu_bas_root"
        action="action_bas_ledger_line"
        sequence="35"/>
</odoo>
