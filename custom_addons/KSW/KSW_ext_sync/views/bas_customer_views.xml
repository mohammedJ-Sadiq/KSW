<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bas_customer_list" model="ir.ui.view">
        <field name="name">ksw.bas.customer.list</field>
        <field name="model">ksw.bas.customer</field>
        <field name="arch" type="xml">
            <list string="BAS Customers">
                <header>
                    <button name="action_match_or_create_partners"
                            string="Match / Create Contacts"
                            type="object" class="btn-primary"
                            display="always"
                            confirm="Match every unlinked BAS customer to an existing contact by name, or create a new contact when no match is found. Continue?"/>
                </header>
                <field name="bas_code"/>
                <field name="name_en"/>
                <field name="name_ar"/>
                <field name="seller_name" string="Sales Rep (BAS)"/>
                <field name="collector_name" string="Collection Rep (BAS)"/>
                <field name="partner_id"/>
                <field name="partner_created" string="New Contact"/>
                <field name="is_stopped"/>
                <field name="last_synced"/>
            </list>
        </field>
    </record>

    <record id="view_bas_customer_search" model="ir.ui.view">
        <field name="name">ksw.bas.customer.search</field>
        <field name="model">ksw.bas.customer</field>
        <field name="arch" type="xml">
            <search>
                <field name="bas_code"/>
                <field name="name_ar"/>
                <field name="name_en"/>
                <field name="seller_name" string="Sales Rep (BAS)"/>
                <field name="collector_name" string="Collection Rep (BAS)"/>
                <field name="partner_id"/>
                <filter name="unlinked" string="No Contact Linked"
                        domain="[('partner_id', '=', False)]"/>
                <filter name="stopped" string="Stopped in BAS"
                        domain="[('is_stopped', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_bas_customer" model="ir.actions.act_window">
        <field name="name">BAS Customers</field>
        <field name="res_model">ksw.bas.customer</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_bas_customer_search"/>
        <field name="context">{'search_default_unlinked': 1}</field>
    </record>
</odoo>
