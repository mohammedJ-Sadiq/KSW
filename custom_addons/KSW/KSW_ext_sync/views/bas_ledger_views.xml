<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bas_ledger_line_list" model="ir.ui.view">
        <field name="name">ksw.bas.ledger.line.list</field>
        <field name="model">ksw.bas.ledger.line</field>
        <field name="arch" type="xml">
            <list string="BAS Customer Ledger" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="ftype"/>
                <field name="number"/>
                <field name="branch_code" optional="hide"/>
                <field name="debit_account"/>
                <field name="credit_account"/>
                <field name="description"/>
                <field name="amount" sum="Total"/>
                <field name="tax_amount" optional="hide" sum="Total"/>
                <field name="seller_code"/>
                <field name="seller_name"/>
                <field name="term_days" optional="hide"/>
                <field name="last_synced" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bas_ledger_line_search" model="ir.ui.view">
        <field name="name">ksw.bas.ledger.line.search</field>
        <field name="model">ksw.bas.ledger.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="debit_account"/>
                <field name="credit_account"/>
                <field name="description"/>
                <field name="number"/>
                <field name="seller_code"/>
                <field name="seller_name"/>
                <filter name="sales" string="Month-end Invoices (002)"
                        domain="[('ftype', '=', '002')]"/>
                <filter name="receipts" string="Receipts (018/015)"
                        domain="[('ftype', 'in', ['018', '015'])]"/>
                <separator/>
                <filter name="group_type" string="Doc Type"
                        context="{'group_by': 'ftype'}"/>
                <filter name="group_rep" string="Rep"
                        context="{'group_by': 'seller_name'}"/>
                <filter name="group_month" string="Month"
                        context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_bas_ledger_line" model="ir.actions.act_window">
        <field name="name">BAS Customer Ledger</field>
        <field name="res_model">ksw.bas.ledger.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
