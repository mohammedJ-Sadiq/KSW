<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bas_account_list" model="ir.ui.view">
        <field name="name">ksw.bas.account.list</field>
        <field name="model">ksw.bas.account</field>
        <field name="arch" type="xml">
            <list string="BAS Accounts" default_order="bas_code">
                <field name="bas_code"/>
                <field name="name_ar"/>
                <field name="name_en"/>
                <field name="category"/>
                <field name="opening_balance" sum="Opening"/>
                <field name="current_debit" sum="Debit"/>
                <field name="current_credit" sum="Credit"/>
                <field name="balance" sum="Balance" decoration-danger="balance &lt; 0" decoration-success="balance &gt; 0"/>
                <field name="last_synced"/>
            </list>
        </field>
    </record>

    <record id="view_bas_account_search" model="ir.ui.view">
        <field name="name">ksw.bas.account.search</field>
        <field name="model">ksw.bas.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="bas_code"/>
                <field name="name_ar"/>
                <field name="name_en"/>
                <filter name="advances" string="Employee Advances" domain="[('category','=','advance')]"/>
                <filter name="loans" string="Bank Loans" domain="[('category','=','loan')]"/>
                <filter name="nonzero" string="Non-Zero Balance" domain="[('balance','!=',0)]"/>
                <separator/>
                <filter name="group_category" string="Category" domain="[]" context="{'group_by':'category'}"/>
            </search>
        </field>
    </record>

    <record id="action_bas_account" model="ir.actions.act_window">
        <field name="name">BAS Accounts (Loans &amp; Advances)</field>
        <field name="res_model">ksw.bas.account</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_bas_account_search"/>
        <field name="context">{'search_default_nonzero': 1}</field>
    </record>
</odoo>
