#. module: KSW_attendance_leave
#: model_terms:ir.ui.view,arch_db:KSW_attendance_leave.biometric_device_details_view_form_ksw
msgid ""
"<strong>Download Specific Attendance:</strong> Re-downloads\n"
"                one period only, optionally for selected employees, and rebuilds\n"
"                that period's absences and weekend grants. Use this after\n"
"                clearing and re-downloading attendance."
msgstr ""
"<strong>تنزيل حضور محدد:</strong> يعيد تنزيل\n"
"                فترة واحدة فقط، اختياريا لموظفين محددين، ويعيد بناء\n"
"                الغياب ومنح العطلات الأسبوعية لتلك الفترة. استخدمه بعد\n"
"                مسح الحضور وإعادة تنزيله."

#. module: KSW_attendance_leave
#: model_terms:ir.ui.view,arch_db:KSW_attendance_leave.biometric_device_details_view_form_ksw
msgid ""
"<strong>Weekend Grants:</strong> Checks for and re-creates\n"
"                the granted Friday/Saturday days on their own. These live only\n"
"                in Odoo, so the device never gives them back."
msgstr ""
"<strong>منح العطلات الأسبوعية:</strong> يتحقق من أيام\n"
"                الجمعة/السبت الممنوحة ويعيد إنشاءها منفردة. هذه موجودة\n"
"                في Odoo فقط، لذا لا يعيدها الجهاز أبدا."

