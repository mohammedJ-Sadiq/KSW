<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Public Holidays: which holiday bonus each day pays. -->
    <record id="resource_calendar_leaves_tree_pay_occasion" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.list.pay.occasion</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="hr_holidays.resource_calendar_leaves_tree_inherit"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_pay_occasion" optional="show"/>
            </field>
        </field>
    </record>

    <record id="resource_calendar_leave_form_pay_occasion" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.form.pay.occasion</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="inherit_id" ref="resource.resource_calendar_leave_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="x_pay_occasion" invisible="resource_id"/>
            </field>
        </field>
    </record>
</odoo>
