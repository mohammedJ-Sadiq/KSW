<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Pay Component — the catalog. Adding a pay type happens here.       -->
    <!-- ================================================================ -->
    <record id="view_ksw_pay_component_form" model="ir.ui.view">
        <field name="name">ksw.pay.component.form</field>
        <field name="model">ksw.pay.component</field>
        <field name="arch" type="xml">
            <form string="Pay Component">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Overtime"/></h1>
                        <h3><field name="code" placeholder="OT"/></h3>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="calculation" invisible="1"/>
                    <field name="has_options" invisible="1"/>

                    <group>
                        <group string="What it is">
                            <field name="kind"/>
                            <field name="scope"/>
                            <field name="sequence"/>
                        </group>
                        <group string="How it is worked out">
                            <field name="calculation" nolabel="0"/>
                            <!-- With options the rate lives on each of
                                 them, so asking for one here would be a
                                 second, contradictory answer. -->
                            <field name="rate"
                                   invisible="calculation != 'qty_rate' or has_options"
                                   required="calculation == 'qty_rate' and not has_options"/>
                            <field name="divisor"
                                   invisible="calculation != 'wage_rate'"
                                   required="calculation == 'wage_rate'"/>
                            <field name="factor"
                                   invisible="calculation != 'wage_rate'"/>
                            <field name="qty_label"
                                   invisible="calculation == 'fixed'"/>
                        </group>
                    </group>

                    <div class="alert alert-info" role="alert"
                         invisible="calculation != 'wage_rate'">
                        Amount = basic salary ÷ divisor × factor × quantity,
                        computed in one expression so the rate is never rounded
                        before it is multiplied.
                    </div>

                    <notebook>
                        <page string="Entry Screen" name="entry">
                            <group>
                                <group string="What to ask for">
                                    <field name="needs_date"/>
                                    <field name="needs_location"/>
                                    <field name="needs_reason"/>
                                </group>
                                <group string="Extras">
                                    <field name="importer"/>
                                    <field name="entries_import_only"
                                           invisible="not importer"/>
                                </group>
                            </group>
                            <field name="description" nolabel="1"
                                   placeholder="What this component is for…"/>
                        </page>

                        <page string="Options" name="options"
                              invisible="calculation != 'qty_rate'">
                            <field name="option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code" optional="show"/>
                                    <field name="rate"/>
                                    <field name="active"
                                           widget="boolean_toggle"
                                           optional="hide"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                Variants of the same pay, differing only in
                                what a unit is worth — Breakfast, Lunch,
                                Dinner. The supervisor picks one per row on a
                                single screen instead of opening a batch per
                                variant. Leave this empty when the component
                                has one rate; anything that differs in more
                                than the rate is a component of its own.
                            </div>
                        </page>

                        <page string="Employee Rates" name="employee_rates"
                              invisible="calculation != 'qty_rate'">
                            <field name="employee_rate_ids"
                                   context="{'default_component_id': id}">
                                <list editable="bottom">
                                    <field name="has_options" column_invisible="1"/>
                                    <field name="employee_id"
                                           options="{'no_create': True}"/>
                                    <field name="option_id"
                                           options="{'no_create': True}"
                                           optional="show"/>
                                    <field name="rate"/>
                                    <field name="standard_rate" optional="show"/>
                                    <field name="date_from"
                                           widget="date"
                                           options="{'min_precision': 'months'}"/>
                                    <field name="date_to"
                                           widget="date"
                                           options="{'min_precision': 'months'}"/>
                                    <field name="reason" optional="show"/>
                                    <field name="active"
                                           widget="boolean_toggle"
                                           optional="hide"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                The rate above is the policy; these are its
                                exceptions. An employee listed here is paid
                                their own rate per unit from the date it takes
                                effect — earlier months keep computing at
                                whatever applied then. Leave "Valid To" empty
                                until the exception ends.
                            </div>
                        </page>

                        <page string="Rate Tiers" name="tiers"
                              invisible="calculation != 'tiered'">
                            <field name="tier_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="site_id"
                                           options="{'no_create': True}"/>
                                    <field name="width"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2">
                                Quantity above the entry's free allowance
                                waterfalls down these bands in order. Leave the
                                last band's size at 0 so it absorbs the
                                remainder.
                            </div>
                        </page>

                        <page string="Who May Record It" name="access">
                            <field name="entry_group_ids" widget="many2many_tags"
                                   nolabel="1"/>
                            <div class="text-muted mt-2">
                                Leave empty and any commission supervisor may
                                record it. Set it only when you actually need
                                the distinction — no group has to exist
                                otherwise.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ksw_pay_component_list" model="ir.ui.view">
        <field name="name">ksw.pay.component.list</field>
        <field name="model">ksw.pay.component</field>
        <field name="arch" type="xml">
            <list string="Pay Components" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="calculation"/>
                <field name="rate" optional="show"/>
                <field name="has_options" string="Has Options" optional="hide"/>
                <field name="qty_label" optional="hide"/>
                <field name="scope" optional="show"/>
                <field name="importer" optional="hide"/>
                <field name="entries_import_only" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ksw_pay_component_search" model="ir.ui.view">
        <field name="name">ksw.pay.component.search</field>
        <field name="model">ksw.pay.component</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="earnings" string="Earnings"
                        domain="[('kind','=','earning')]"/>
                <filter name="deductions" string="Deductions"
                        domain="[('kind','=','deduction')]"/>
                <separator/>
                <filter name="inactive" string="Archived"
                        domain="[('active','=',False)]"/>
                <group>
                    <filter string="Calculation" name="grp_calc" domain="[]"
                            context="{'group_by': 'calculation'}"/>
                    <filter string="Scope" name="grp_scope" domain="[]"
                            context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ksw_pay_component" model="ir.actions.act_window">
        <field name="name">Pay Components</field>
        <field name="res_model">ksw.pay.component</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ksw_pay_component_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define a kind of extra pay
            </p>
            <p>
                Overtime, driver trips, meals, allowances and bonuses are all
                rows here. Adding one is configuration — it needs no
                development, no new screen and no new access group.
            </p>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Recurring entries — SAP infotype 0014, the repeating half          -->
    <!-- ================================================================ -->
    <record id="view_ksw_pay_recurring_list" model="ir.ui.view">
        <field name="name">ksw.pay.recurring.list</field>
        <field name="model">ksw.pay.recurring</field>
        <field name="arch" type="xml">
            <list string="Recurring Entries" editable="bottom">
                <!-- Carries the picker's domain: the departments this user
                     runs plus his cascading reporting chain. -->
                <field name="allowed_employee_ids" column_invisible="1"/>
                <field name="employee_id" options="{'no_create': True}"/>
                <field name="component_id" options="{'no_create': True}"/>
                <field name="has_options" column_invisible="1"/>
                <field name="needs_reason" column_invisible="1"/>
                <field name="option_id" options="{'no_create': True}"
                       required="has_options" optional="show"/>
                <field name="department_id" optional="show" readonly="1"/>
                <field name="quantity"/>
                <field name="amount"/>
                <!-- On a catch-all component the reason is what tells two
                     standing payments for the same employee apart, so it is
                     shown by default and required where the component asks
                     for it. -->
                <field name="reason" required="needs_reason" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ksw_pay_recurring_search" model="ir.ui.view">
        <field name="name">ksw.pay.recurring.search</field>
        <field name="model">ksw.pay.recurring</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="component_id"/>
                <field name="department_id"/>
                <group>
                    <filter string="Component" name="grp_component" domain="[]"
                            context="{'group_by': 'component_id'}"/>
                    <filter string="Department" name="grp_department" domain="[]"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ksw_pay_recurring" model="ir.actions.act_window">
        <field name="name">Recurring Entries</field>
        <field name="res_model">ksw.pay.recurring</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ksw_pay_recurring_search"/>
        <field name="context">{'search_default_grp_component': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up pay that repeats every month
            </p>
            <p>
                A mobile-phone allowance, a project-management allowance. The
                supervisor pulls these into the month's batch with one button
                instead of typing them twelve times a year.
            </p>
        </field>
    </record>

    <!-- ================================================================ -->
    <!-- Employee Rates — the exceptions to a component's rate             -->
    <!-- ================================================================ -->
    <record id="view_ksw_pay_employee_rate_list" model="ir.ui.view">
        <field name="name">ksw.pay.employee.rate.list</field>
        <field name="model">ksw.pay.employee.rate</field>
        <field name="arch" type="xml">
            <list string="Employee Rates" editable="bottom"
                  decoration-muted="not active">
                <field name="has_options" column_invisible="1"/>
                <field name="employee_id" options="{'no_create': True}"/>
                <field name="component_id" options="{'no_create': True}"/>
                <field name="option_id" options="{'no_create': True}"
                       required="has_options" optional="show"/>
                <field name="department_id" optional="show" readonly="1"/>
                <field name="rate"/>
                <field name="standard_rate" optional="show"/>
                <field name="date_from" widget="date"
                       options="{'min_precision': 'months'}"/>
                <field name="date_to" widget="date"
                       options="{'min_precision': 'months'}"/>
                <field name="reason" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ksw_pay_employee_rate_form" model="ir.ui.view">
        <field name="name">ksw.pay.employee.rate.form</field>
        <field name="model">ksw.pay.employee.rate</field>
        <field name="arch" type="xml">
            <form string="Employee Rate">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="has_options" invisible="1"/>
                    <group>
                        <group string="Who and what">
                            <field name="employee_id"
                                   options="{'no_create': True}"/>
                            <field name="component_id"
                                   options="{'no_create': True}"/>
                            <field name="option_id"
                                   options="{'no_create': True}"
                                   invisible="not has_options"
                                   required="has_options"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group string="What a unit is worth">
                            <label for="rate"/>
                            <div class="o_row">
                                <field name="rate" class="oe_inline"/>
                                <span class="text-muted ms-2">
                                    per <field name="qty_label"
                                               class="oe_inline" readonly="1"
                                               nolabel="1"/>
                                </span>
                            </div>
                            <field name="standard_rate"/>
                            <field name="date_from" widget="date"
                                   options="{'min_precision': 'months'}"/>
                            <field name="date_to" widget="date"
                                   options="{'min_precision': 'months'}"/>
                            <field name="reason"
                                   placeholder="Agreed with the GM, Sep 2026…"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Entries dated inside this window are worked out at this
                        rate instead of the component's. Months already
                        approved are never restated — closing this row off and
                        starting a new one is what a rate change looks like.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ksw_pay_employee_rate_search" model="ir.ui.view">
        <field name="name">ksw.pay.employee.rate.search</field>
        <field name="model">ksw.pay.employee.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="component_id"/>
                <field name="department_id"/>
                <filter name="current" string="In Force Today"
                        domain="['&amp;', ('date_from', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                 '|', ('date_to', '=', False),
                                 ('date_to', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Component" name="grp_component" domain="[]"
                            context="{'group_by': 'component_id'}"/>
                    <filter string="Employee" name="grp_employee" domain="[]"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="grp_department" domain="[]"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ksw_pay_employee_rate" model="ir.actions.act_window">
        <field name="name">Employee Rates</field>
        <field name="res_model">ksw.pay.employee.rate</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ksw_pay_employee_rate_search"/>
        <field name="context">{'search_default_grp_component': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pay one employee a different rate
            </p>
            <p>
                A component's rate is the policy — a Friday is 100. An
                exception here says this employee's Friday is 150, from a
                given month onwards. Everything else keeps computing at the
                standard rate, and approved months are never restated.
            </p>
        </field>
    </record>

</odoo>
