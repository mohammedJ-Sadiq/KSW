<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================================================================
         Commission entries on the leave's Accounting page.

         The commissions twin of KSW_deduction's "Employee Deduction
         Picture": what the employee is still owed in the Commissions app is
         listed here and paid automatically on the vacation payslip
         (KSW_COM_* inputs), so Accounting no longer re-types it under
         Additional Commissions Detail. An Html render, not a relational
         field: approvers have no read on ksw.pay.entry.
         ================================================================== -->
    <record id="hr_leave_view_form_inherit_ksw_commission_entries"
            model="ir.ui.view">
        <field name="name">hr.leave.form.inherit.ksw.commission.entries</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id"
               ref="KSW_annual_leave.hr_leave_view_form_inherit_annual_return"/>
        <field name="arch" type="xml">

            <xpath expr="//separator[@name='commission_lines_section']"
                   position="before">
                <field name="x_commission_entries_applies" invisible="1"/>
                <field name="x_commission_entries_settled" invisible="1"/>
                <field name="x_commission_entries_count" invisible="1"/>
                <field name="x_commission_manual_duplicate" invisible="1"/>

                <separator string="Commissions from the Commissions App"
                           name="ksw_commission_entries_section"
                           invisible="not x_commission_entries_applies"/>
                <div name="ksw_commission_entries"
                     invisible="not x_commission_entries_applies">
                    <p class="text-muted"
                       invisible="x_commission_entries_count or x_commission_entries_settled">
                        No commission or allowance entries are outstanding
                        for this employee.
                    </p>
                    <p class="text-muted"
                       invisible="not x_commission_entries_count or x_commission_entries_settled">
                        Recorded in the Commissions app and not yet paid.
                        They are paid automatically on the vacation payslip,
                        and the monthly commission run will not pay them
                        again.
                    </p>
                    <p class="text-muted"
                       invisible="not x_commission_entries_settled">
                        Paid on the confirmed vacation payslip. The monthly
                        commission run leaves these entries out.
                    </p>
                    <field name="x_commission_entries_html" nolabel="1"
                           readonly="1"
                           invisible="not x_commission_entries_count"/>
                </div>

                <div class="alert alert-warning" role="alert"
                     invisible="not x_commission_manual_duplicate">
                    <strong>Possible double payment.</strong>
                    The payslip already pays the
                    <field name="x_commission_entries_total" readonly="1"
                           class="oe_inline"/> SAR recorded in the
                    Commissions app (above). The lines under
                    <em>Additional Commissions Detail</em> are paid
                    <strong>on top</strong> of that — keep them only for
                    amounts that are not in the Commissions app.
                </div>
            </xpath>

        </field>
    </record>

</odoo>
