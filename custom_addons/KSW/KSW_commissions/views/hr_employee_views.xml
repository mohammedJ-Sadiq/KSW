<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inject the Work Site field into the HR Employee form -->
    <record id="view_hr_employee_form_site" model="ir.ui.view">
        <field name="name">hr.employee.form.ksw.commission.site</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add work-site and import-alias fields next to the attendance-sheet toggle -->
            <field name="x_is_attendance_sheet" position="after">
                <field name="x_site_id"
                       groups="hr.group_hr_user,base.group_system"
                       invisible="not x_is_attendance_sheet"/>
                <field name="x_commission_import_name"
                       groups="hr.group_hr_user,base.group_system"/>
                <field name="x_deduct_commission_priority"
                       groups="hr.group_hr_user,base.group_system"/>
                <field name="x_bas_driver_cost_center"
                       groups="hr.group_hr_user,base.group_system"
                       invisible="not x_is_attendance_sheet"/>
                <!-- Read-only: the BAS pull owns it. Shown because the
                     journal entry's cost-centre column comes from here. -->
                <field name="x_bas_equipment_code"
                       groups="hr.group_hr_user,base.group_system"
                       invisible="not x_bas_driver_cost_center"/>
                <!-- Only shown once the main one is set: it is a fix for a
                     BAS split, not a second field to fill in routinely. -->
                <field name="x_bas_driver_cost_center_alt"
                       groups="hr.group_hr_user,base.group_system"
                       placeholder="e.g. عرفان الله قاسم 1483"
                       invisible="not x_bas_driver_cost_center"/>
            </field>
        </field>
    </record>
</odoo>


