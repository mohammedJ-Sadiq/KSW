<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Commission data on the customer, on the Sales & Purchase tab where
         the rest of the customer's sales data lives (Oct 2026: it used to sit
         in the header, under Job Position). The sales rep is Odoo's own
         Salesperson (user_id); this module no longer keeps a second one. -->
    <record id="view_partner_form_ksw_commission" model="ir.ui.view">
        <field name="name">res.partner.form.ksw.commission</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']/field[@name='user_id']" position="after">
                <field name="x_collection_rep_id"
                       placeholder="Employee who earns collection commission on this customer's BAS receipts"/>
            </xpath>
            <!-- The BAS account no. is the Reference itself (KSW_ext_sync). -->
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']/field[@name='ref']" position="attributes">
                <attribute name="placeholder">BAS account no., e.g. 120301080</attribute>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']/field[@name='ref']" position="after">
                <field name="x_commission_import_name"
                       placeholder="Name as in the Excel Sales file (fallback if no account no.)"/>
            </xpath>
        </field>
    </record>
</odoo>
