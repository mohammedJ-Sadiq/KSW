#. module: KSW_commissions
#: model:mail.template,body_html:KSW_commissions.mail_template_submission_to_gm
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    <t t-out=\"object.submitted_by.name or ''\">A supervisor</t>\n"
"                    has submitted the commissions for\n"
"                    <strong><t t-out=\"object.display_name or ''\">Department</t></strong>\n"
"                    and they are waiting for your approval.\n"
"                </p>\n"
"                <table style=\"border-collapse: collapse; margin: 12px 0;\">\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">Batches</td>\n"
"                        <td style=\"padding: 4px 0;\"><strong><t t-out=\"object.batch_count or 0\">0</t></strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">Records</td>\n"
"                        <td style=\"padding: 4px 0;\"><strong><t t-out=\"object.entry_count or 0\">0</t></strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">Employees</td>\n"
"                        <td style=\"padding: 4px 0;\"><strong><t t-out=\"object.employee_count or 0\">0</t></strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">Total</td>\n"
"                        <td style=\"padding: 4px 0;\">\n"
"                            <strong><t t-out=\"'%.2f' % (object.total_amount or 0.0)\">0.00</t>\n"
"                            <t t-out=\"object.currency_id.name or ''\">SAR</t></strong>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>\n"
"                    Open the Monthly Pay Run to see which departments are in,\n"
"                    who is due to be paid and what their loans consume, then\n"
"                    approve the month.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\" dir=\"rtl\">\n"
"                <p>السلام عليكم،</p>\n"
"                <p>\n"
"                    قام <t t-out=\"object.submitted_by.name or ''\">أحد المشرفين</t>\n"
"                    بتقديم عمولات\n"
"                    <strong><t t-out=\"object.display_name or ''\">القسم</t></strong>\n"
"                    وهي بانتظار اعتمادكم.\n"
"                </p>\n"
"                <table style=\"border-collapse: collapse; margin: 12px 0;\">\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">الدفعات</td>\n"
"                        <td style=\"padding: 4px 0;\"><strong><t t-out=\"object.batch_count or 0\">0</t></strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">السجلات</td>\n"
"                        <td style=\"padding: 4px 0;\"><strong><t t-out=\"object.entry_count or 0\">0</t></strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">الموظفون</td>\n"
"                        <td style=\"padding: 4px 0;\"><strong><t t-out=\"object.employee_count or 0\">0</t></strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">الإجمالي</td>\n"
"                        <td style=\"padding: 4px 0;\">\n"
"                            <strong><t t-out=\"'%.2f' % (object.total_amount or 0.0)\">0.00</t>\n"
"                            <t t-out=\"object.currency_id.name or ''\">ريال</t></strong>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>\n"
"                    افتح دورة المستحقات الشهرية لترى الأقسام المُسلَّمة، ومن سيُصرَف له، وما تستهلكه قروضهم، ثم اعتمد الشهر.\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_sales_commission_import_wizard_form
msgid ""
"<i class=\"fa fa-calculator me-1\" role=\"img\" aria-label=\"VAT\"/>\n"
"                            Target and Collected amounts will be divided by <b>1.15</b>\n"
"                            to remove the 15% VAT before being saved."
msgstr ""
"<i class=\"fa fa-calculator me-1\" role=\"img\" aria-label=\"ضريبة القيمة المضافة\"/>\n"
"                            تُقسَم مبالغ المستهدف والمحصَّل على <b>١٫١٥</b> لإزالة ضريبة القيمة المضافة ١٥٪ قبل الحفظ."

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_salesperson_profile_form
msgid ""
"<i class=\"fa fa-code-fork me-2\"/>\n"
"                                Define client buckets that receive <b>separate</b> commission\n"
"                                lines on the monthly sheet. Each split must reference a\n"
"                                <i>Client-specific</i> or <i>Employee + Client</i> rule whose\n"
"                                <b>Clients</b> list names the customers in this bucket.\n"
"                                The <b>general</b> line will receive the remaining sales\n"
"                                (total minus all split amounts). Leave empty when the\n"
"                                employee has a single uniform rule."
msgstr ""
"<i class=\"fa fa-code-fork me-2\"/>\n"
"                                حدّد مجموعات عملاء تحصل على بنود عمولة <b>منفصلة</b> في الكشف الشهري. ويجب أن تشير كل مجموعة إلى قاعدة <i>خاصة بعميل</i> أو <i>الموظف + العميل</i> تضمّ قائمة <b>العملاء</b> فيها عملاء هذه المجموعة. أمّا البند <b>العام</b> فيحصل على المبيعات المتبقّية (الإجمالي ناقص كل مبالغ المجموعات). اتركه فارغًا إذا كانت للموظف قاعدة واحدة موحّدة."

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_sales_commission_override_wizard_form
msgid ""
"<i class=\"fa fa-exclamation-triangle me-2\" title=\"Warning\" role=\"img\" "
"aria-label=\"Warning\"/>"
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-2\" title=\"تحذير\" role=\"img\" "
"aria-label=\"تحذير\"/>"

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_salesperson_profile_form
msgid ""
"<i class=\"fa fa-exclamation-triangle me-2\"/>\n"
"                        <b>Collection Target is now derived from BAS</b> —\n"
"                        the sum of overdue balance (past each customer's own\n"
"                        BAS credit term) across every customer this employee\n"
"                        collects for. <b>Annual Collection Target</b> and the\n"
"                        monthly split on the <i>Monthly Targets</i> tab\n"
"                        below are <b>no longer used</b> for the actual\n"
"                        calculation; they're kept only as historical\n"
"                        reference. Limited to this fiscal year's BAS data —\n"
"                        debt carried over from before Jan 1 isn't visible."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-2\"/>\n"
"                        <b>مستهدف التحصيل صار مشتقًّا من BAS</b> — وهو مجموع الأرصدة المتأخّرة (بعد مدة الائتمان الخاصة بكل عميل في BAS) لكل عميل يُحصّل له هذا الموظف. أمّا <b>المستهدف السنوي للتحصيل</b> والتوزيع الشهري في تبويب <i>المستهدفات الشهرية</i> أدناه فلم <b>يعودا يُستخدمان</b> في الاحتساب الفعلي؛ ويُحتفظ بهما كمرجع تاريخي فقط. ويقتصر ذلك على بيانات BAS للسنة المالية الحالية — فالديون المرحّلة من قبل ١ يناير غير ظاهرة."

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_sales_commission_import_wizard_form
msgid ""
"<i class=\"fa fa-info-circle me-2\" title=\"Info\" role=\"img\" aria-label=\"Info\"/>\n"
"                        Upload the monthly Excel files produced by the accountant application.\n"
"                        You may upload one or both files — only the uploaded file(s) will update\n"
"                        the corresponding achieved amounts. The other column is left unchanged."
msgstr ""
"<i class=\"fa fa-info-circle me-2\" title=\"معلومة\" role=\"img\" aria-label=\"معلومة\"/>\n"
"                        ارفع ملفات إكسل الشهرية الصادرة من برنامج المحاسبة. يمكنك رفع ملف واحد أو كليهما — ولن تُحدَّث إلا المبالغ المحقَّقة المقابلة للملف المرفوع، ويبقى العمود الآخر كما هو."

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_sales_commission_sheet_form
msgid ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                            Use <b>Open Adjustments</b> above to add addition/deduction lines\n"
"                                            on this employee's own page."
msgstr ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                            استخدم <b>فتح التسويات</b> أعلاه لإضافة بنود إضافة أو خصم في صفحة هذا الموظف."

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_salesperson_profile_form
msgid ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                <b>Sales Target</b> below still feeds the\n"
"                                commission sheet directly. <b>Collection\n"
"                                Target</b> is historical only — the sheet\n"
"                                now computes it live from BAS AR aging\n"
"                                instead (see the warning banner above)."
msgstr ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                ما زال <b>مستهدف المبيعات</b> أدناه يُغذّي كشف العمولة مباشرةً. أمّا <b>مستهدف التحصيل</b> فمرجعي تاريخي فقط — إذ يحتسبه الكشف الآن مباشرةً من أعمار ذمم BAS (راجع شريط التحذير أعلاه)."

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_salesperson_profile_form
msgid ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                On import, <b>Achieved Collection</b> will be set\n"
"                                to the <b>grand total</b> of all collections from\n"
"                                the Excel file (all reps combined), and\n"
"                                <b>Target Collection</b> will be set to the grand\n"
"                                total of all targets from the same file."
msgstr ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                                عند الاستيراد يُضبط <b>التحصيل المحقَّق</b> على <b>الإجمالي الكلي</b> لكل التحصيلات في ملف إكسل (لجميع المندوبين معًا)، ويُضبط <b>التحصيل المستهدف</b> على الإجمالي الكلي لكل المستهدفات في الملف نفسه."

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_salesperson_profile_form
msgid ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                            Select which commission rule applies to this employee.\n"
"                            Leave blank to auto-select the most-specific active rule\n"
"                            by scope matching."
msgstr ""
"<i class=\"fa fa-info-circle me-2\"/>\n"
"                            حدّد قاعدة العمولة التي تنطبق على هذا الموظف. اتركه فارغًا ليُختار تلقائيًا أدقّ قاعدة نشطة مطابقةً للنطاق."

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_deduction_form_inherit_awaiting_commission
msgid ""
"<i class=\"fa fa-info-circle\" title=\"Info\" role=\"img\" aria-label=\"Info\"/>\n"
"                    <b class=\"ms-1\">Recouping a slice via the Commission Sheet</b> —\n"
"                    when an employee can't afford a full installment from\n"
"                    salary alone, you can route part (or all) of it to\n"
"                    their monthly commission sheet:"
msgstr ""
"<i class=\"fa fa-info-circle\" title=\"معلومة\" role=\"img\" aria-label=\"معلومة\"/>\n"
"                    <b class=\"ms-1\">استرجاع جزء عبر كشف العمولة</b> —\n"
"                    عندما لا يستطيع الموظف تحمل قسط كامل من الراتب\n"
"                    وحده، يمكنك تحويل جزء (أو كله) إلى كشف عمولته\n"
"                    الشهري:"

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_sales_commission_import_wizard_form
msgid ""
"<i class=\"fa fa-link me-2\" title=\"Mapping\" role=\"img\" aria-label=\"Mapping\"/>\n"
"                        <b>Employee mapping:</b> the wizard matches the salesman name in the Excel file\n"
"                        using the <i>Commission Import Name</i> field on each employee record.\n"
"                        If blank, it falls back to the employee's <i>Name</i>.\n"
"                        Unmatched names are listed in the sheet's chatter after import."
msgstr ""
"<i class=\"fa fa-link me-2\" title=\"المطابقة\" role=\"img\" aria-label=\"المطابقة\"/>\n"
"                        <b>مطابقة الموظفين:</b> يطابق المعالج اسم المندوب في ملف إكسل باستخدام حقل <i>اسم استيراد العمولة</i> في سجل كل موظف. وإن كان فارغًا يعود إلى <i>اسم</i> الموظف. وتُدرَج الأسماء غير المطابَقة في محادثة الكشف بعد الاستيراد."

#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_sales_commission_sheet_form
msgid ""
"<i class=\"fa fa-shield me-2\" title=\"Override\" role=\"img\" aria-label=\"Override\"/>\n"
"                                            <strong>Condition overridden by Sales Manager.</strong>"
msgstr ""
"<i class=\"fa fa-shield me-2\" title=\"تجاوز\" role=\"img\" aria-label=\"تجاوز\"/>\n"
"                                            <strong>تم تجاوز الشرط من مدير المبيعات.</strong>"

