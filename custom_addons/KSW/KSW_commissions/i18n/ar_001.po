msgstr "لا يمكن تجاوز شرط العمولة على أي سطر إلا لمدير المبيعات."

#. module: KSW_commissions
#: code:addons/KSW_commissions/models/ksw_sales_commission_sheet.py:0
msgid "The commission sheet must be in draft state to pull from BAS."
msgstr "يجب أن يكون كشف العمولة في وضع المسودة للسحب من BAS."

#. module: KSW_commissions
#: code:addons/KSW_commissions/models/ksw_sales_commission_sheet.py:0
msgid "Set the period before pulling from BAS."
msgstr "حدّد الفترة قبل السحب من BAS."

#. module: KSW_commissions
#: code:addons/KSW_commissions/models/ksw_sales_commission_sheet.py:0
msgid ""
"✔ Commission-condition <b>override granted</b> on line for <b>%(emp)s</b> by"
" <b>%(user)s</b>.<br/><b>Reason:</b> %(reason)s"
msgstr ""
"✔ <b>مُنح تجاوز</b> لشرط العمولة على سطر <b>%(emp)s</b> من "
"<b>%(user)s</b>.<br/><b>السبب:</b> %(reason)s"

#. module: KSW_commissions
#: code:addons/KSW_commissions/models/ksw_sales_commission_sheet.py:0
msgid "Only draft sheets can be confirmed."
msgstr "لا يمكن اعتماد إلا الكشوف في وضع المسودة."

#. module: KSW_commissions
#: code:addons/KSW_commissions/models/ksw_sales_commission_sheet.py:0
msgid "Sales/collection commission sheet confirmed. Total: %(t).2f"
msgstr "تم اعتماد كشف عمولة المبيعات / التحصيل. الإجمالي: %(t).2f"

#. module: KSW_commissions
#: code:addons/KSW_commissions/models/ksw_sales_commission_sheet.py:0
msgid "Achieved and target amounts must be zero or positive."
msgstr "يجب أن تكون المبالغ المحقَّقة والمستهدفة صفرًا أو موجبة."

#. module: KSW_commissions
#: code:addons/KSW_commissions/models/ksw_sales_commission_sheet.py:0
msgid ""
"↩ Override revoked on line for <b>%(emp)s</b> by <b>%(user)s</b>. Previous "
"reason: <i>%(reason)s</i>"
msgstr ""
"↩ أُلغي التجاوز على سطر <b>%(emp)s</b> من <b>%(user)s</b>. السبب السابق: "
"<i>%(reason)s</i>"

#. module: KSW_commissions
#: code:addons/KSW_commissions/models/ksw_sales_commission_sheet.py:0
