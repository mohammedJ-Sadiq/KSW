#. module: KSW_commissions
#: model_terms:ir.ui.view,arch_db:KSW_commissions.view_ksw_sales_commission_import_wizard_form
msgid ""
"<i class=\"fa fa-link me-2\" title=\"Mapping\" role=\"img\" aria-label=\"Mapping\"/>\n"
"                        <b>Employee mapping:</b> the wizard matches the salesman name in the Excel file\n"
"                        using the <i>Commission Import Name</i> field on each employee record.\n"
"                        If blank, it falls back to the employee's <i>Name</i>.\n"
"                        Unmatched names are listed in the sheet's chatter after import."
