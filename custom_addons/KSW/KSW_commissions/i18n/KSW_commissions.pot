#. module: KSW_commissions
#: model:mail.template,body_html:KSW_commissions.mail_template_submission_to_gm
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p>Hello,</p>\n"
"                <p>\n"
"                    <t t-out=\"object.submitted_by.name or ''\">A supervisor</t>\n"
"                    has submitted the commissions for\n"
"                    <strong><t t-out=\"object.display_name or ''\">Department</t></strong>\n"
"                    and they are waiting for your approval.\n"
"                </p>\n"
"                <table style=\"border-collapse: collapse; margin: 12px 0;\">\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">Batches</td>\n"
"                        <td style=\"padding: 4px 0;\"><strong><t t-out=\"object.batch_count or 0\">0</t></strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">Records</td>\n"
"                        <td style=\"padding: 4px 0;\"><strong><t t-out=\"object.entry_count or 0\">0</t></strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">Employees</td>\n"
"                        <td style=\"padding: 4px 0;\"><strong><t t-out=\"object.employee_count or 0\">0</t></strong></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding: 4px 16px 4px 0;\">Total</td>\n"
"                        <td style=\"padding: 4px 0;\">\n"
"                            <strong><t t-out=\"'%.2f' % (object.total_amount or 0.0)\">0.00</t>\n"
"                            <t t-out=\"object.currency_id.name or ''\">SAR</t></strong>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <p>\n"
"                    Open the Monthly Pay Run to see which departments are in,\n"
"                    who is due to be paid and what their loans consume, then\n"
"                    approve the month.\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

