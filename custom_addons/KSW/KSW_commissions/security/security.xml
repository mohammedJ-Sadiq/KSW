<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Layer 1: Module Category                                      -->
    <!-- ============================================================ -->
    <!--
        TWO questions on the user form, and no more (19.0.4.0.0):

          • Commission Role      — who this person is in the monthly pay
            cycle: Supervisor, General Manager, Accountant, Administrator.
          • Sales & Collection   — the separate monthly sales sheet, paid
            outside the pay run, so it is a separate question.

        It used to be NINE controls. Four of them gated nothing at all —
        Entry: Overtime / Driver Commission / Location Allowance and the
        "Self" tier were left behind when the fourteen old commission
        models were replaced by the five ksw.pay.* ones, and had no ACL
        row, no record rule, no view groups= and no Python check between
        them. Two more asked about things that are not roles: "Officer"
        was scope (sees every department) and "Configuration" was the
        catalog — both are now simply what Administrator means.

        THE ROLES ARE MUTUALLY EXCLUSIVE ON PURPOSE. Sharing one privilege
        renders them as a single-select, which is what enforces the
        separation of duties the chain exists for: the person who records
        an entry cannot approve it, and the person who approves it cannot
        export the money. Administrator is the one tier that implies the
        other three — "the system administrator can do everything" — so
        stacking is expressed by picking the top of the ladder, never by
        ticking two boxes.
    -->
    <record id="module_category_ksw_commissions" model="ir.module.category">
        <field name="name">KSW Commissions</field>
        <field name="sequence">203</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 2: Privileges                                           -->
    <!-- ============================================================ -->
    <record id="privilege_commission_management" model="res.groups.privilege">
        <field name="name">Commission Role</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
        <field name="description">Where this person sits in the monthly pay cycle. One role each: the supervisor records, the General Manager approves, the accountant pays.</field>
    </record>

    <record id="privilege_sales_override" model="res.groups.privilege">
        <field name="name">Sales &amp; Collection</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
        <field name="description">The monthly sales and collection commission sheet. Paid separately, outside the commission pay run, so it is asked separately.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Commission Role — the four tiers                     -->
    <!-- ============================================================ -->
    <!--
        The order below is the order they appear in the dropdown
        (res.groups.sequence), not an inheritance chain: only
        Administrator implies anything.

        In particular General Manager does NOT imply Supervisor. He
        approves a supervisor's work; handing him the supervisor's create
        and write rights on the same entries would dissolve the very
        review the submission step exists for. His reach comes from
        hr.department.x_effective_gm_id through the department-scoped
        rules further down — naming a group in a Python guard is worthless
        if no ir.rule lets it see the records (CLAUDE.md gotcha #38).
    -->
    <record id="group_commission_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_commission_management"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Records the pay entries for the departments they manage (or assist the manager of) and hands the month over to the General Manager.</field>
    </record>

    <record id="group_commission_gm" model="res.groups">
        <field name="name">General Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_commission_management"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Approves the monthly handover of the departments they are General Manager of, and may return one to the supervisor. Read-only on the entries themselves. Closing and reopening the month belong to the Administrator, since that affects every department.</field>
    </record>

    <!--
        The Accountant no longer implies the Administrator tier. He used
        to, purely to borrow its [(1,'=',1)] rules, which also handed him
        the configuration catalog and the right to reopen an approved
        month. He gets his own company-wide READ rules below instead —
        the register is his to export, not to rewrite.
    -->
    <record id="group_commission_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_commission_management"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Once the General Manager has approved the month: exports the bank transfer file, corrects a loan offset on the register, and marks the month paid.</field>
    </record>

    <!--
        Administrator = the old Officer tier (every department) MERGED with
        the old Configuration tier (the pay component / rate tier / site /
        salesperson catalog). Two dropdowns became one option.

        IT DOES NOT IMPLY GENERAL MANAGER, however senior it sounds. GM is a
        named per-department responsibility carried by
        hr.department.x_effective_gm_id, not a capability tier, so implying
        the group grants no scope at all — every GM rule keys on
        `gm_id = user.id`. What it WOULD grant is the one thing the group
        confers outside those rules: exemption from the period lock
        (ksw_commission_lock.py), which exists solely because the GM is the
        one who can reopen a month. Closing and reopening belong to
        `res.company.x_default_gm_id` and have never been the Officer's
        (tests/test_period_lock.py::test_10_only_the_gm_reopens), so handing
        every Administrator the exemption would let him edit an approved
        month he cannot reopen.

        `(6, 0, [...])` rather than `(4, ...)`: an implication already
        written to the database survives its removal from this file
        (CLAUDE.md gotcha #3), so the list has to be set outright — this is
        what drops the four dead Entry: implications the Officer tier used
        to carry.
    -->
    <record id="group_commission_officer" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_commission_management"/>
        <field name="implied_ids" eval="[(6, 0, [
            ref('group_commission_supervisor'),
            ref('group_commission_accountant'),
        ])]"/>
        <field name="comment">Every department, plus the configuration catalog: pay components, rate tiers, work sites and salesperson profiles. Not a General Manager — that is a responsibility named on the department itself.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Sales &amp; Collection — its own two tiers               -->
    <!-- ============================================================ -->
    <!--
        A different sheet on a different payment path, so it is a second
        question rather than an answer inside the first one: the accountant
        who maintains it is usually also the Accountant of the pay run, and
        under a single-select he could not be both.

        Manager implies Entry: the override is an extra right ON the sheet,
        not an alternative to maintaining it.
    -->
    <record id="group_entry_sales" model="res.groups">
        <field name="name">Entry</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_sales_override"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Maintains the monthly sales/collection commission sheet.</field>
    </record>

    <record id="group_sales_commission_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_sales_override"/>
        <field name="implied_ids" eval="[(6, 0, [
            ref('base.group_user'), ref('group_entry_sales')])]"/>
        <field name="comment">Maintains the sheet and may override the commission-rule condition on an individual line, e.g. grant the commission to a salesperson who fell below the threshold.</field>
    </record>

    <!--
        Administrator implies the Sales &amp; Collection Entry tier too, but
        it has to be added here rather than listed in the record above:
        ref() resolves against ir.model.data as the file loads, so a
        forward reference to a group defined further down fails outright.
    -->
    <function model="res.groups" name="write">
        <value eval="[ref('group_commission_officer')]"/>
        <value eval="{'implied_ids': [(4, ref('group_entry_sales'))]}"/>
    </function>

    <!-- ============================================================ -->
    <!-- Record Rules — ksw.pay.batch / ksw.pay.entry                   -->
    <!-- ============================================================ -->
    <!--
        A supervisor runs his own department and sees nobody else's entries.
        Two ways in, matching ksw.pay.batch._allowed_departments():

          • he is the department's manager (hr.department.manager_id);
          • he assists that manager — the two-key delegation from
            KSW_base_security, where x_assisted_manager_ids lists the managers
            a user may prepare work for but never approve for;
          • create_uid, so he can always see what he created — which is also
            what makes a per-SITE batch like Driver Trips workable, since a
            site has no department to match on.

        NOTE FOR DEPLOYMENT: this depends on hr.department.manager_id being
        set. Only 2 of 26 departments have one today, so the managers must be
        filled in or supervisors will correctly see nothing.
    -->
    <record id="pay_batch_rule_supervisor" model="ir.rule">
        <field name="name">KSW Pay Batch: departments I manage or assist, or created by me</field>
        <field name="model_id" ref="model_ksw_pay_batch"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('department_id.manager_id.user_id', '=', user.id), ('department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_batch_rule_officer" model="ir.rule">
        <field name="name">KSW Pay Batch: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_batch"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_entry_rule_supervisor" model="ir.rule">
        <field name="name">KSW Pay Entry: departments I manage or assist, or created by me</field>
        <field name="model_id" ref="model_ksw_pay_entry"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', ('batch_id.create_uid', '=', user.id), ('batch_id.department_id.manager_id.user_id', '=', user.id), ('batch_id.department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_entry_rule_officer" model="ir.rule">
        <field name="name">KSW Pay Entry: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_entry"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — ksw.pay.recurring                               -->
    <!-- ============================================================ -->
    <!--
        A supervisor maintains his own team's standing instructions
        (19.0.3.5.0). Before that he had read on the model and no rule at
        all, which was harmless only because he could not write; granting
        create/write without scoping would have let any supervisor edit
        every employee's recurring pay company-wide.

        The branches mirror ksw.pay.batch's, one level down — the employee's
        department rather than the batch's — plus the direct reporting line,
        for the supervisors whose people sit in another department, and
        create_uid so you can always see what you created.

        The Officer rule is not optional: Officer implies Supervisor, so
        without a rule of its own the narrow one above would be the only one
        that applies to him.
    -->
    <record id="pay_recurring_rule_supervisor" model="ir.rule">
        <field name="name">KSW Recurring Pay: my team</field>
        <field name="model_id" ref="model_ksw_pay_recurring"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', '|',
            ('create_uid', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id),
            ('employee_id.department_id.manager_id.user_id', '=', user.id),
            ('employee_id.department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_recurring_rule_officer" model="ir.rule">
        <field name="name">KSW Recurring Pay: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_recurring"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — ksw.pay.submission                              -->
    <!-- ============================================================ -->
    <!--
        A supervisor sees the handover for the departments he runs, plus any
        scope he has actually recorded a batch in — which is what makes a
        per-SITE submission (driver trips) reachable, since a site has no
        manager to match on.
    -->
    <record id="pay_submission_rule_supervisor" model="ir.rule">
        <field name="name">KSW Pay Submission: my departments</field>
        <field name="model_id" ref="model_ksw_pay_submission"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', ('department_id.manager_id.user_id', '=', user.id), ('department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids), ('batch_ids.create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_submission_rule_officer" model="ir.rule">
        <field name="name">KSW Pay Submission: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_submission"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — ksw.pay.run.line (the payment register)         -->
    <!-- ============================================================ -->
    <!--
        The register is now visible before approval, so it has to be scoped:
        a supervisor checks who in HIS department is about to be paid, and
        the GM sees everyone. Read-only for the supervisor — the figures are
        derived from entries he already owns.
    -->
    <record id="pay_run_line_rule_supervisor" model="ir.rule">
        <field name="name">KSW Payment Register: my people</field>
        <field name="model_id" ref="model_ksw_pay_run_line"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), ('department_id.manager_id.user_id', '=', user.id), ('department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_run_line_rule_officer" model="ir.rule">
        <field name="name">KSW Payment Register: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_run_line"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — Department GM                                  -->
    <!-- ============================================================ -->
    <!--
        The GM sees the departments he is General Manager of, and nothing
        else. `x_effective_gm_id` is a stored compute on hr.department that
        already folds in the parent-department climb and the company
        default, so each of these is one join with no OR branch for the
        fallback.

        The submission rule reads its stored `gm_id` rather than joining the
        department: that field has already resolved the site-scoped case
        (driver trips have no department at all, exactly as for the
        supervisor rules above) down to the company's default GM.

        Write but not create/unlink on the submission and its batches: a GM
        approves and returns a handover, and may correct a batch on the way
        (matching the batch ACL row, which is 1,1,1,0), but he never raises
        or destroys one. Entries stay read-only to him, as their ACL row
        already says — he is reviewing a supervisor's work, not retyping it.
    -->
    <record id="pay_submission_rule_department_gm" model="ir.rule">
        <field name="name">KSW Pay Submission: department GM</field>
        <field name="model_id" ref="model_ksw_pay_submission"/>
        <field name="groups" eval="[(4, ref('group_commission_gm'))]"/>
        <field name="domain_force">[('gm_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_batch_rule_department_gm" model="ir.rule">
        <field name="name">KSW Pay Batch: department GM</field>
        <field name="model_id" ref="model_ksw_pay_batch"/>
        <field name="groups" eval="[(4, ref('group_commission_gm'))]"/>
        <field name="domain_force">['|',
            ('department_id.x_effective_gm_id.user_id', '=', user.id),
            ('submission_id.gm_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_entry_rule_department_gm" model="ir.rule">
        <field name="name">KSW Pay Entry: department GM (read-only)</field>
        <field name="model_id" ref="model_ksw_pay_entry"/>
        <field name="groups" eval="[(4, ref('group_commission_gm'))]"/>
        <field name="domain_force">['|',
            ('batch_id.department_id.x_effective_gm_id.user_id', '=', user.id),
            ('batch_id.submission_id.gm_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_run_line_rule_department_gm" model="ir.rule">
        <field name="name">KSW Payment Register: department GM</field>
        <field name="model_id" ref="model_ksw_pay_run_line"/>
        <field name="groups" eval="[(4, ref('group_commission_gm'))]"/>
        <field name="domain_force">[('department_id.x_effective_gm_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>


    <!-- ============================================================ -->
    <!-- Record Rules — Accountant                                     -->
    <!-- ============================================================ -->
    <!--
        These replace the Administrator implication the Accountant used to
        carry. He needs the whole company in view — the bank file is one
        file for every department — but only the register is his to touch:
        a loan offset he has to correct against what the bank actually
        collected. Everything upstream of the approval is read-only, which
        is the half the borrowed [(1,'=',1)] Administrator rules got wrong.

        ksw.pay.run itself has no rule on any group, so the ACL row is the
        only gate there and no rule is needed for it here.
    -->
    <record id="pay_batch_rule_accountant" model="ir.rule">
        <field name="name">KSW Pay Batch: Accountant (read-only, all)</field>
        <field name="model_id" ref="model_ksw_pay_batch"/>
        <field name="groups" eval="[(4, ref('group_commission_accountant'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_entry_rule_accountant" model="ir.rule">
        <field name="name">KSW Pay Entry: Accountant (read-only, all)</field>
        <field name="model_id" ref="model_ksw_pay_entry"/>
        <field name="groups" eval="[(4, ref('group_commission_accountant'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_submission_rule_accountant" model="ir.rule">
        <field name="name">KSW Pay Submission: Accountant (read-only, all)</field>
        <field name="model_id" ref="model_ksw_pay_submission"/>
        <field name="groups" eval="[(4, ref('group_commission_accountant'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_run_line_rule_accountant" model="ir.rule">
        <field name="name">KSW Payment Register: Accountant (all)</field>
        <field name="model_id" ref="model_ksw_pay_run_line"/>
        <field name="groups" eval="[(4, ref('group_commission_accountant'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Admin/root: one group each now. Administrator implies Supervisor,
        Accountant and Sales Entry, so the bootstrap admin keeps what he had
        from ONE answer per question instead of nine. Sales Manager is the
        second answer: the override right is a tier of its own privilege.
        His General Manager row is left alone — Administrator does not imply
        it, and `env.su` exempts him from every guard that names it anyway.

        `(3, ...)` on the tiers he used to hold directly: those memberships
        are in the database from earlier installs and would otherwise sit
        there forever (CLAUDE.md gotcha #3), leaving the Commission Role
        dropdown resolving off a direct row rather than the implication.
    -->
    <function model="res.groups" name="write">
        <value eval="[ref('group_commission_officer')]"/>
        <value eval="{'user_ids': [(4, ref('base.user_root')), (4, ref('base.user_admin'))]}"/>
    </function>
    <function model="res.groups" name="write">
        <value eval="[ref('group_sales_commission_manager')]"/>
        <value eval="{'user_ids': [(4, ref('base.user_root')), (4, ref('base.user_admin'))]}"/>
    </function>
    <function model="res.groups" name="write">
        <value eval="[ref('group_commission_accountant'), ref('group_commission_supervisor'), ref('group_entry_sales')]"/>
        <value eval="{'user_ids': [(3, ref('base.user_root')), (3, ref('base.user_admin'))]}"/>
    </function>

</odoo>
