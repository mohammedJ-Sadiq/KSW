<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Layer 1: Module Category                                      -->
    <!-- ============================================================ -->
    <!--
        Mirrors the layout of KSW_annual_leave / KSW_deduction:
        a single row in the User form ("KSW Commissions") with two
        privilege dropdowns:

          • Commission Management — tiered (Self / Supervisor /
            Officer) for sheet CRUD scope.
          • Commission Approval   — the Accountant role that
            unlocks the loans-locked field on confirmed sheets and
            can finalise (state confirmed → done).

        A separate "Commission Configuration" privilege gates
        master-data (categories + sites) so that Officers can
        manage day-to-day sheets without being able to alter the
        catalog.
    -->
    <record id="module_category_ksw_commissions" model="ir.module.category">
        <field name="name">KSW Commissions</field>
        <field name="sequence">203</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 2: Privileges                                           -->
    <!-- ============================================================ -->
    <record id="privilege_commission_management" model="res.groups.privilege">
        <field name="name">Commission Management</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
    </record>

    <record id="privilege_commission_approval" model="res.groups.privilege">
        <field name="name">Commission Approval</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
    </record>

    <record id="privilege_commission_configuration" model="res.groups.privilege">
        <field name="name">Commission Configuration</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
    </record>

    <!-- Sales Override — gates the per-line "Override Condition" button on
         ksw.sales.commission.line so that a sales manager can grant the
         commission to a salesperson who didn't meet the threshold (with
         a captured reason and audit trail). -->
    <record id="privilege_sales_override" model="res.groups.privilege">
        <field name="name">Sales Override</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Commission Management (tiered)              -->
    <!-- ============================================================ -->
    <record id="group_commission_self" model="res.groups">
        <field name="name">Self</field>
        <field name="privilege_id" ref="privilege_commission_management"/>
        <field name="comment">See own commission sheet only.</field>
    </record>

    <record id="group_commission_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="privilege_id" ref="privilege_commission_management"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_self'))]"/>
        <field name="comment">Edit commission sheets for direct subordinates with x_is_attendance_sheet=True.</field>
    </record>

    <record id="group_commission_officer" model="res.groups">
        <field name="name">Officer</field>
        <field name="privilege_id" ref="privilege_commission_management"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="comment">Edit any commission sheet company-wide and reset confirmed sheets back to draft.</field>
    </record>

    <!-- Baseline: every internal user is implicitly Self. -->
    <function model="res.groups" name="write">
        <value eval="[ref('base.group_user')]"/>
        <value eval="{'implied_ids': [(4, ref('group_commission_self'))]}"/>
    </function>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Commission Approval                         -->
    <!-- ============================================================ -->
    <!--
        The Accountant who finalises commission sheets. Confers:
          • write access to ``x_loans_amount_locked`` while the sheet
            is in 'confirmed' state,
          • permission to call ``action_done``,
          • implicitly the Officer-tier viewing scope so the
            accountant can see every sheet pending finalisation.
    -->
    <record id="group_commission_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="privilege_commission_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="comment">Adjust the locked loans amount on confirmed sheets and finalise (state done). Implicitly grants Officer scope so the accountant can see every confirmed sheet.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Entry types (one opt-in group per type)     -->
    <!-- ============================================================ -->
    <!--
        A supervisor should only see the kinds of entry they actually do.
        One group per entry type, ticked per user; the hub cards, the menus
        and the records all follow it, so a supervisor who only handles
        driver commissions sees only that.

        EACH GROUP GETS ITS OWN PRIVILEGE ON PURPOSE. In Odoo 19 the groups
        sharing a privilege render as a single-select on the user form, so
        putting all four under one privilege would make them mutually
        exclusive — the opposite of what is wanted. One group per privilege
        renders as an independent checkbox. (A group with no privilege at
        all only renders in debug mode — see Odoo 19 Pitfalls #55.)

        These are deliberately NOT implied by group_commission_supervisor:
        the supervisor tier is the *scope*, these are the *opt-in*. Officer
        implies all four, so Officer / Accountant / GM keep seeing
        everything.
    -->
    <record id="privilege_entry_overtime" model="res.groups.privilege">
        <field name="name">Entry: Overtime</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
    </record>
    <record id="group_entry_overtime" model="res.groups">
        <field name="name">Overtime Entry</field>
        <field name="privilege_id" ref="privilege_entry_overtime"/>
        <field name="comment">Record overtime for the supervisor's own department.</field>
    </record>

    <record id="privilege_entry_driver" model="res.groups.privilege">
        <field name="name">Entry: Driver Commission</field>
        <field name="sequence">51</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
    </record>
    <record id="group_entry_driver" model="res.groups">
        <field name="name">Driver Commission Entry</field>
        <field name="privilege_id" ref="privilege_entry_driver"/>
        <field name="comment">Record driver trips and pull them from BAS.</field>
    </record>

    <record id="privilege_entry_location" model="res.groups.privilege">
        <field name="name">Entry: Location Allowance</field>
        <field name="sequence">52</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
    </record>
    <record id="group_entry_location" model="res.groups">
        <field name="name">Location Allowance Entry</field>
        <field name="privilege_id" ref="privilege_entry_location"/>
        <field name="comment">Record technician meal occurrences for the supervisor's own department.</field>
    </record>

    <record id="privilege_entry_sales" model="res.groups.privilege">
        <field name="name">Entry: Sales &amp; Collection</field>
        <field name="sequence">53</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
    </record>
    <record id="group_entry_sales" model="res.groups">
        <field name="name">Sales &amp; Collection Entry</field>
        <field name="privilege_id" ref="privilege_entry_sales"/>
        <field name="comment">Maintain the monthly sales/collection commission sheet. Paid separately — not part of the commission request.</field>
    </record>

    <!-- Officer sees every entry type. -->
    <function model="res.groups" name="write">
        <value eval="[ref('group_commission_officer')]"/>
        <value eval="{'implied_ids': [
            (4, ref('group_entry_overtime')),
            (4, ref('group_entry_driver')),
            (4, ref('group_entry_location')),
            (4, ref('group_entry_sales')),
        ]}"/>
    </function>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Final Approval (General Manager)            -->
    <!-- ============================================================ -->
    <!--
        Its OWN privilege, deliberately not privilege_commission_approval:
        in Odoo 19 a privilege renders as a single-select on the user form,
        so sharing one with the Accountant would make the two roles mutually
        exclusive — and the GM must be assignable alongside anything else.

        The GM no longer implies Officer. It used to, because one GM
        answered for the whole company and the Officer rule [(1,'=',1)] was
        the simplest way to give him reach. Authority now comes from
        hr.department.x_effective_gm_id, so scope has to follow it: the
        department-scoped rules below are what give a GM his records, and
        keeping the Officer implication would silently hand every GM every
        department — the behaviour this replaces.

        `(6, 0, [...])` rather than `(4, ...)`: an implication already
        written to the database survives its removal from this file, so the
        list must be set outright (Odoo 19 Pitfalls #3). base.group_user is
        named explicitly because it used to arrive through Officer.

        Naming a group in a Python guard is still worthless if no ir.rule
        lets it see the records (gotcha #38) — hence a rule per model below,
        not just the ACL rows.
    -->
    <record id="privilege_commission_gm" model="res.groups.privilege">
        <field name="name">Commission Final Approval</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_ksw_commissions"/>
    </record>

    <record id="group_commission_gm" model="res.groups">
        <field name="name">General Manager</field>
        <field name="privilege_id" ref="privilege_commission_gm"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Approves the monthly commission handover of the departments they are set as General Manager of. Closing and reopening the month belong to the Commission Officer or the company's General Manager, since they affect every department.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Commission Configuration                    -->
    <!-- ============================================================ -->
    <record id="group_commission_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="privilege_id" ref="privilege_commission_configuration"/>
        <field name="comment">Manage the commission/allowance category catalog and the site/trip-tier configuration. Independent of the Management/Approval scopes.</field>
    </record>

    <!-- ============================================================ -->
    <!-- Layer 3: Groups — Sales Override                              -->
    <!-- ============================================================ -->
    <record id="group_sales_commission_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="privilege_id" ref="privilege_sales_override"/>
        <field name="comment">Override the commission-rule condition on individual sales/collection commission lines (e.g. grant the commission to a salesperson who fell below the threshold).</field>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — ksw.commission.sheet                            -->
    <!-- ============================================================ -->



    <!-- ============================================================ -->
    <!-- Record Rules — ksw.commission.sheet.line                       -->
    <!-- ============================================================ -->
    <!--
        These were missing entirely: the sheet was row-scoped but its
        lines were not, so anyone holding the line ACL could read (and a
        supervisor could write) the lines of a sheet they cannot open.
        The lines simply follow their parent sheet's scope.
    -->



    <!-- ============================================================ -->
    <!-- Record Rules — entry sheets: a supervisor sees only his own    -->
    <!-- ============================================================ -->
    <!--
        A department manager is responsible for his subordinates and
        nobody else's entries: showing him the rest only makes his job
        harder. Every entry sheet is therefore scoped, and the entry-type
        group above decides which kinds he sees at all.

        Scoping note — check the data before writing the domain.
        hr.department.manager_id is empty on every real department here,
        and no supervisor has x_site_id set, so a domain built on either
        would grant NOBODY anything and look like a permissions bug. What
        IS populated is the employee parent_id chain (44/44 across
        Maintenance + Workshop, every manager holding a user account) and
        the supervisor's own department. Each rule ORs:

          • the supervisor's own department (how the Maintenance and
            Workshop supervisors reach theirs, and what lets them create
            a sheet before it has any lines);
          • a sheet holding one of their own subordinates (for the two
            supervisors who sit in a different department from the people
            they manage); and
          • create_uid — you can always see what you created, even while
            it is still empty. This is what makes a per-site sheet like
            Driver Commission workable without any site configuration.
    -->

    <!-- Overtime (per department) -->


    <!-- Driver Commission (per site — scoped by subordinates + creator) -->


    <!-- Location Allowance (per department since 19.0.2.0.0) -->


    <!-- Officer / GM see every entry sheet of every type. -->






    <!-- ============================================================ -->
    <!-- Record Rule — ksw.commission.run.source                        -->
    <!-- ============================================================ -->
    <!--
        The Monthly Commission Run is one shared record per month, so its
        entry-type cards are shared rows. This is what makes them follow
        each user's access rights: a card is visible only when the user
        holds the entry type's group.
    -->

    <!-- ============================================================ -->
    <!-- Record Rules — ksw.pay.batch / ksw.pay.entry                   -->
    <!-- ============================================================ -->
    <!--
        A supervisor runs his own department and sees nobody else's entries.
        Two ways in, matching ksw.pay.batch._allowed_departments():

          • he is the department's manager (hr.department.manager_id);
          • he assists that manager — the two-key delegation from
            KSW_base_security, where x_assisted_manager_ids lists the managers
            a user may prepare work for but never approve for;
          • create_uid, so he can always see what he created — which is also
            what makes a per-SITE batch like Driver Trips workable, since a
            site has no department to match on.

        NOTE FOR DEPLOYMENT: this depends on hr.department.manager_id being
        set. Only 2 of 26 departments have one today, so the managers must be
        filled in or supervisors will correctly see nothing.
    -->
    <record id="pay_batch_rule_supervisor" model="ir.rule">
        <field name="name">KSW Pay Batch: departments I manage or assist, or created by me</field>
        <field name="model_id" ref="model_ksw_pay_batch"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('department_id.manager_id.user_id', '=', user.id), ('department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_batch_rule_officer" model="ir.rule">
        <field name="name">KSW Pay Batch: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_batch"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_entry_rule_supervisor" model="ir.rule">
        <field name="name">KSW Pay Entry: departments I manage or assist, or created by me</field>
        <field name="model_id" ref="model_ksw_pay_entry"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', ('batch_id.create_uid', '=', user.id), ('batch_id.department_id.manager_id.user_id', '=', user.id), ('batch_id.department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_entry_rule_officer" model="ir.rule">
        <field name="name">KSW Pay Entry: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_entry"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — ksw.pay.recurring                               -->
    <!-- ============================================================ -->
    <!--
        A supervisor maintains his own team's standing instructions
        (19.0.3.5.0). Before that he had read on the model and no rule at
        all, which was harmless only because he could not write; granting
        create/write without scoping would have let any supervisor edit
        every employee's recurring pay company-wide.

        The branches mirror ksw.pay.batch's, one level down — the employee's
        department rather than the batch's — plus the direct reporting line,
        for the supervisors whose people sit in another department, and
        create_uid so you can always see what you created.

        The Officer rule is not optional: Officer implies Supervisor, so
        without a rule of its own the narrow one above would be the only one
        that applies to him.
    -->
    <record id="pay_recurring_rule_supervisor" model="ir.rule">
        <field name="name">KSW Recurring Pay: my team</field>
        <field name="model_id" ref="model_ksw_pay_recurring"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', '|',
            ('create_uid', '=', user.id),
            ('employee_id.parent_id.user_id', '=', user.id),
            ('employee_id.department_id.manager_id.user_id', '=', user.id),
            ('employee_id.department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_recurring_rule_officer" model="ir.rule">
        <field name="name">KSW Recurring Pay: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_recurring"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — ksw.pay.submission                              -->
    <!-- ============================================================ -->
    <!--
        A supervisor sees the handover for the departments he runs, plus any
        scope he has actually recorded a batch in — which is what makes a
        per-SITE submission (driver trips) reachable, since a site has no
        manager to match on.
    -->
    <record id="pay_submission_rule_supervisor" model="ir.rule">
        <field name="name">KSW Pay Submission: my departments</field>
        <field name="model_id" ref="model_ksw_pay_submission"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', ('department_id.manager_id.user_id', '=', user.id), ('department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids), ('batch_ids.create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="pay_submission_rule_officer" model="ir.rule">
        <field name="name">KSW Pay Submission: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_submission"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — ksw.pay.run.line (the payment register)         -->
    <!-- ============================================================ -->
    <!--
        The register is now visible before approval, so it has to be scoped:
        a supervisor checks who in HIS department is about to be paid, and
        the GM sees everyone. Read-only for the supervisor — the figures are
        derived from entries he already owns.
    -->
    <record id="pay_run_line_rule_supervisor" model="ir.rule">
        <field name="name">KSW Payment Register: my people</field>
        <field name="model_id" ref="model_ksw_pay_run_line"/>
        <field name="groups" eval="[(4, ref('group_commission_supervisor'))]"/>
        <field name="domain_force">['|', '|', '|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id), ('department_id.manager_id.user_id', '=', user.id), ('department_id.manager_id.user_id', 'in', user.x_assisted_manager_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_run_line_rule_officer" model="ir.rule">
        <field name="name">KSW Payment Register: Officer (all)</field>
        <field name="model_id" ref="model_ksw_pay_run_line"/>
        <field name="groups" eval="[(4, ref('group_commission_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================ -->
    <!-- Record Rules — Department GM                                  -->
    <!-- ============================================================ -->
    <!--
        The GM sees the departments he is General Manager of, and nothing
        else. `x_effective_gm_id` is a stored compute on hr.department that
        already folds in the parent-department climb and the company
        default, so each of these is one join with no OR branch for the
        fallback.

        The submission rule reads its stored `gm_id` rather than joining the
        department: that field has already resolved the site-scoped case
        (driver trips have no department at all, exactly as for the
        supervisor rules above) down to the company's default GM.

        Write but not create/unlink on the submission and its batches: a GM
        approves and returns a handover, and may correct a batch on the way
        (matching the batch ACL row, which is 1,1,1,0), but he never raises
        or destroys one. Entries stay read-only to him, as their ACL row
        already says — he is reviewing a supervisor's work, not retyping it.
    -->
    <record id="pay_submission_rule_department_gm" model="ir.rule">
        <field name="name">KSW Pay Submission: department GM</field>
        <field name="model_id" ref="model_ksw_pay_submission"/>
        <field name="groups" eval="[(4, ref('group_commission_gm'))]"/>
        <field name="domain_force">[('gm_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_batch_rule_department_gm" model="ir.rule">
        <field name="name">KSW Pay Batch: department GM</field>
        <field name="model_id" ref="model_ksw_pay_batch"/>
        <field name="groups" eval="[(4, ref('group_commission_gm'))]"/>
        <field name="domain_force">['|',
            ('department_id.x_effective_gm_id.user_id', '=', user.id),
            ('submission_id.gm_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_entry_rule_department_gm" model="ir.rule">
        <field name="name">KSW Pay Entry: department GM (read-only)</field>
        <field name="model_id" ref="model_ksw_pay_entry"/>
        <field name="groups" eval="[(4, ref('group_commission_gm'))]"/>
        <field name="domain_force">['|',
            ('batch_id.department_id.x_effective_gm_id.user_id', '=', user.id),
            ('batch_id.submission_id.gm_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="pay_run_line_rule_department_gm" model="ir.rule">
        <field name="name">KSW Payment Register: department GM</field>
        <field name="model_id" ref="model_ksw_pay_run_line"/>
        <field name="groups" eval="[(4, ref('group_commission_gm'))]"/>
        <field name="domain_force">[('department_id.x_effective_gm_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        Admin/root assignment: keep these users in every top tier
        across the four privileges so module installation / -u runs
        don't lock out the bootstrap admin.
    -->
    <function model="res.groups" name="write">
