<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The cash-load weighting bands, as given by the business on
        2026-09-24. noupdate="1": these are a commercial decision and are
        meant to be edited in Configuration, so an upgrade must never put
        them back to what they were on the day the module shipped.

        Below 330 is deliberately absent — an amount under the first band
        earns nothing, which _sql_case returns as 0 by falling through.
    -->
    <data noupdate="1">
        <record id="cash_band_330" model="ksw.pay.cash.band">
            <field name="amount_from">330</field>
            <field name="amount_to">375</field>
            <field name="factor">0.75</field>
        </record>
        <record id="cash_band_376" model="ksw.pay.cash.band">
            <field name="amount_from">376</field>
            <field name="amount_to">450</field>
            <field name="factor">1.0</field>
        </record>
        <record id="cash_band_451" model="ksw.pay.cash.band">
            <field name="amount_from">451</field>
            <field name="amount_to">550</field>
            <field name="factor">1.5</field>
        </record>
        <record id="cash_band_551" model="ksw.pay.cash.band">
            <field name="amount_from">551</field>
            <field name="amount_to">650</field>
            <field name="factor">2.0</field>
        </record>
        <record id="cash_band_651" model="ksw.pay.cash.band">
            <field name="amount_from">651</field>
            <field name="amount_to">750</field>
            <field name="factor">2.5</field>
        </record>
        <record id="cash_band_751" model="ksw.pay.cash.band">
            <field name="amount_from">751</field>
            <field name="amount_to">850</field>
            <field name="factor">3.0</field>
        </record>
        <record id="cash_band_851" model="ksw.pay.cash.band">
            <field name="amount_from">851</field>
            <field name="amount_to">950</field>
            <field name="factor">3.5</field>
        </record>
        <record id="cash_band_951" model="ksw.pay.cash.band">
            <field name="amount_from">951</field>
            <field name="amount_to">0</field>
            <field name="factor">4.0</field>
        </record>
    </data>
</odoo>
