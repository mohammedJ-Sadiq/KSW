<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================ -->
        <!-- Commission entries paid on a vacation payslip (ALW)          -->
        <!-- Sums every payslip input coded KSW_COM_<ksw.pay.entry id>.   -->
        <!-- Built by hr.leave._build_vacation_input_lines (this module); -->
        <!-- confirming the payslip stamps the entries paid so the        -->
        <!-- monthly pay run leaves them out of its register.             -->
        <!-- ============================================================ -->
        <record id="hr_rule_ksw_commissions" model="hr.salary.rule">
            <field name="name">Commissions (Pay Entries)</field>
            <field name="sequence" eval="19"/>
            <field name="code">KSW_COMMISSIONS</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = any(i.code and i.code.startswith('KSW_COM_') for i in (payslip.input_line_ids or []))</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = sum(i.amount for i in (payslip.input_line_ids or []) if i.code and i.code.startswith('KSW_COM_'))</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="note">Commission and allowance entries recorded in the Commissions
app that a vacation settlement pays. One input per entry (KSW_COM_*) is
listed in "Other Inputs"; the entries are marked paid when the payslip is
confirmed, and the monthly commission run does not pay them again.</field>
        </record>

        <!-- The KSW structures carry their rules explicitly (no parent
             structure), so attach it wherever the manual commissions rule
             already is. Idempotent: a <function>, not a record override,
             so it also reaches structures created after install. -->
        <function model="hr.salary.rule" name="_ksw_attach_commission_rule"/>

    </data>
</odoo>
