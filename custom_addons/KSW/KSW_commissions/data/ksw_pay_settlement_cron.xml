<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Recent BAS files are compared with BAS daily until they match. -->
    <record id="cron_ksw_pay_settlement_bas_check" model="ir.cron">
        <field name="name">Commissions: check posted BAS files against BAS</field>
        <field name="model_id" ref="model_ksw_pay_settlement"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_against_bas()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
