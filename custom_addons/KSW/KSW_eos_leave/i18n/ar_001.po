#. module: KSW_eos_leave
#: model:ir.model.fields,field_description:KSW_eos_leave.field_hr_leave__x_eos_termination_amount
#: model_terms:ir.ui.view,arch_db:KSW_eos_leave.hr_leave_view_form_inherit_eos
