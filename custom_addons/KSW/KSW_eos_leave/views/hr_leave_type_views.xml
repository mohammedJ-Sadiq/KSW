<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add is_eos_leave checkbox to the leave type form -->
    <record id="view_hr_leave_type_form_inherit_eos" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit.eos</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="KSW_annual_leave.view_hr_leave_type_form_inherit_ksw"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_annual_leave']" position="after">
                <field name="is_eos_leave"/>
            </xpath>
        </field>
    </record>

</odoo>
