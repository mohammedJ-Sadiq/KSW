<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Extend hr.leave FORM: EOS-specific tab and payslip button    -->
    <!-- Inherits from the KSW_annual_leave form (which itself        -->
    <!-- inherits from hr_holidays.hr_leave_view_form).               -->
    <!-- ============================================================ -->
    <record id="hr_leave_view_form_inherit_eos" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit.eos</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="KSW_annual_leave.hr_leave_view_form_inherit_annual_return"/>
        <field name="arch" type="xml">

            <!-- ===== Hidden EOS helper fields ===== -->
            <xpath expr="//field[@name='x_is_annual_leave_type']" position="after">
                <field name="x_is_eos_leave" invisible="1"/>
                <field name="x_eos_payslip_id" invisible="1"
                       groups="om_hr_payroll.group_hr_payroll_user"/>
            </xpath>

            <!-- ===== Replace date-range picker with single Termination Date for EOS ===== -->
            <!-- Hide the "Dates" label (shown for full-day leaves) when EOS -->
            <xpath expr="//label[@for='request_date_from' and @invisible='request_unit_half or request_unit_hours']"
                   position="attributes">
                <attribute name="invisible">x_is_eos_leave or request_unit_half or request_unit_hours</attribute>
            </xpath>
            <!-- Hide the "Date" label (shown for half-day/hour leaves) when EOS -->
            <xpath expr="//label[@for='request_date_from' and @invisible='not request_unit_half and not request_unit_hours']"
                   position="attributes">
                <attribute name="invisible">x_is_eos_leave or (not request_unit_half and not request_unit_hours)</attribute>
            </xpath>
            <!-- Hide the date-range div when EOS -->
            <xpath expr="//div[@id='full_date']" position="attributes">
                <attribute name="invisible">x_is_eos_leave</attribute>
            </xpath>
            <!-- Add single Termination Date field after the hidden range div -->
            <xpath expr="//div[@id='full_date']" position="after">
                <label for="request_date_from" string="Termination Date"
                       invisible="not x_is_eos_leave"/>
                <div class="o_row" invisible="not x_is_eos_leave">
                    <field name="request_date_from"
                           widget="date"
                           readonly="state != 'confirm'"
                           required="x_is_eos_leave"/>
                </div>
            </xpath>

            <!-- ===== Hide the standard HR Review tab for EOS leaves ===== -->
            <!-- EOS has its own dedicated tab instead. -->
            <xpath expr="//page[@name='hr_review']" position="attributes">
                <attribute name="invisible">x_annual_approval_state == 'pending_dm' or x_is_eos_leave</attribute>
            </xpath>

            <!-- ===== Add EOS Review tab (before the HR Review tab) ===== -->
            <xpath expr="//page[@name='hr_review']" position="before">
                <page string="🏢 EOS Review" name="eos_review"
                      invisible="x_annual_approval_state == 'pending_dm' or not x_is_eos_leave">

                    <!-- Reference service data (read-only) -->
                    <group string="Service Period Reference">
                        <field name="x_eos_service_years" readonly="1"
                               string="Base Service Years (Unadjusted)"/>
                        <field name="x_eos_last_wage" readonly="1"/>
                        <field name="x_eos_termination_amount" readonly="1"
                               string="Base EOS — Termination (Art. 84, Unadjusted)"/>
                        <field name="x_eos_resignation_amount" readonly="1"
                               string="Base EOS — Resignation (Art. 85, Unadjusted)"/>
                    </group>

                    <!-- HR inputs — editable only by HR at pending_hr state -->
                    <group string="HR Inputs">
                        <field name="x_eos_unpaid_days"
                               readonly="x_annual_approval_state != 'pending_hr' or not x_is_hr_approver"/>
                        <field name="x_eos_adjusted_service_years" readonly="1"/>
                        <field name="x_eos_adjusted_termination_amount" readonly="1"/>
                        <field name="x_eos_adjusted_resignation_amount" readonly="1"/>
                        <field name="x_eos_termination_reason"
                               readonly="x_annual_approval_state != 'pending_hr' or not x_is_hr_approver"/>
                        <field name="x_eos_previous_payments"
                               readonly="x_annual_approval_state != 'pending_hr' or not x_is_hr_approver"/>
                        <field name="x_eos_notice_pay"
                               readonly="x_annual_approval_state != 'pending_hr' or not x_is_hr_approver"/>
                    </group>

                    <!-- EOS payout summary -->
                    <group string="EOS Payout Summary">
                        <field name="x_eos_payout_amount" readonly="1"
                               class="fw-bold"/>
                    </group>

                </page>
            </xpath>

            <!-- ===== Hide Decision Support tab for EOS (info is in EOS Review) ===== -->
            <xpath expr="//page[@name='decision_support']" position="attributes">
                <attribute name="invisible">x_annual_approval_state == 'pending_dm' or x_is_eos_leave</attribute>
            </xpath>

            <!-- ===== EOS payslip smart button ===== -->
            <!-- Inserted into the existing button_box created by KSW_payroll. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        name="action_open_eos_payslip"
                        type="object"
                        icon="fa-file-text-o"
                        invisible="not x_eos_payslip_id"
                        groups="om_hr_payroll.group_hr_payroll_user">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">EOS Payslip</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
